{
  "name": "@atlasharness/atlascode",
  "version": "0.1.33",
  "description": "AtlasCode — Coding Agent for the domestic computing ecosystem (Ascend NPU + domestic LLM backends)",
  "bin": {
    "atlas": "dist/cli.js",
    "atlascode": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "bun run --check src/atlascode/cli.ts",
    "test": "bun test --isolate tests/",
    "build": "bun build src/atlascode/cli.ts --outfile dist/cli.js --target node --external modifiers-napi --external url-handler-napi --external audio-capture-napi --external audio-capture.node --external image-processor-napi --external plist --external sharp --external fflate --external cli-highlight --external undici --external vscode-languageserver-protocol --external vscode-languageserver-types --external @ant/computer-use-input --external @ant/computer-use-swift",
    "dev": "bun run --watch src/atlascode/launcher.ts",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@alcalzone/ansi-tokenize": "^0.3.0",
    "@commander-js/extra-typings": "15",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@opentelemetry/api": "^1.9.1",
    "ajv": "^8.20.0",
    "asciichart": "^1.5.25",
    "auto-bind": "^5.0.1",
    "axios": "^1.20.0",
    "bidi-js": "^1.0.3",
    "chalk": "^6.0.0",
    "chokidar": "^5.0.0",
    "cli-boxes": "^4.0.1",
    "code-excerpt": "^4.0.0",
    "diff": "9.0.0",
    "emoji-regex": "^10.6.0",
    "env-paths": "^4.0.0",
    "execa": "^10.0.1",
    "figures": "^6.1.0",
    "fuse.js": "^7.5.0",
    "highlight.js": "^10.7.3",
    "https-proxy-agent": "^9.1.0",
    "ignore": "^7.0.8",
    "indent-string": "^5.0.0",
    "ink": "^7.1.1",
    "jsonc-parser": "^3.3.1",
    "lodash-es": "^4.18.1",
    "lru-cache": "^11.5.2",
    "marked": "^18.0.11",
    "openai": "^7.9.0",
    "p-map": "^7.0.7",
    "picomatch": "^4.0.7",
    "proper-lockfile": "^4.1.2",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-reconciler": "^0.33.0",
    "semver": "^7.6.0",
    "shell-quote": "1.10.0",
    "strip-ansi": "^7.2.0",
    "supports-hyperlinks": "^4.5.0",
    "tree-kill": "^1.2.2",
    "turndown": "^7.2.4",
    "usehooks-ts": "^3.1.1",
    "vscode-jsonrpc": "^9.0.2",
    "wrap-ansi": "^10.0.1",
    "ws": "^8.21.3",
    "xss": "^1.0.15",
    "yaml": "^2.9.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.18",
    "@typescript-eslint/parser": "^8",
    "eslint": "^9.0.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "^5.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8"
  }
}
