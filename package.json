{
  "name": "atlascode",
  "version": "0.0.1",
  "private": true,
  "description": "AtlasCode — Coding Agent for the domestic computing ecosystem (Ascend NPU + domestic LLM backends)",
  "bin": {
    "atlascode": "dist/cli.js"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "bun run --check src/atlascode/cli.ts",
    "test": "bun test --isolate tests/",
    "build": "bun build src/atlascode/cli.ts --outfile dist/cli.js --target node",
    "dev": "bun run --watch src/atlascode/launcher.ts",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "openai": "^7.9.0",
    "proper-lockfile": "^4.1.2",
    "shell-quote": "1.10.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/parser": "^8",
    "eslint": "^9.0.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "^5.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8"
  }
}
