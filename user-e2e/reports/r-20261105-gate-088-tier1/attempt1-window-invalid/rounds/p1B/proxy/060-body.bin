s)\\\": 10, \\\"Max Time (us)\\\": 18, \\\"Min Time (us)\\\": 8, \\\"AI Core Time (us)\\\": 240, \\\"AI CPU Time (us)\\\": 0}]}\"}"},{"role":"tool","tool_call_id":"chatcmpl-tool-b7d3be99e875a0a9","content":"{\"result\":\"{\\n  \\\"file\\\": \\\"/home/vince/.claude/jobs/09264df0/tmp/gate-088/tier1/p1B/prof/PROF_0001/ASCEND_PROFILER_OUTPUT/op_statistic.csv\\\",\\n  \\\"total_rows\\\": 3,\\n  \\\"available_fields\\\": [\\n    \\\"op_type\\\",\\n    \\\"count\\\",\\n    \\\"total_time\\\",\\n    \\\"avg_time\\\",\\n    \\\"min_time\\\",\\n    \\\"max_time\\\"\\n  ],\\n  \\\"missing_fields\\\": [\\n    \\\"device_id\\\",\\n    \\\"model_name\\\",\\n    \\\"core_type\\\",\\n    \\\"ratio\\\"\\n  ],\\n  \\\"summary\\\": {\\n    \\\"total_time_us\\\": 6000.0,\\n    \\\"avg_total_time_us\\\": 2000.0,\\n    \\\"total_operator_calls\\\": 84,\\n    \\\"unique_operator_types\\\": 3\\n  },\\n  \\\"top_operators\\\": [\\n    {\\n      \\\"op_type\\\": \\\"MatMul\\\",\\n      \\\"count\\\": 12,\\n      \\\"total_time\\\": 4800,\\n      \\\"avg_time\\\": 400,\\n      \\\"min_time\\\": 360,\\n      \\\"max_time\\\": 520\\n    },\\n    {\\n      \\\"op_type\\\": \\\"Elementwise\\\",\\n      \\\"count\\\": 48,\\n      \\\"total_time\\\": 960,\\n      \\\"avg_time\\\": 20,\\n      \\\"min_time\\\": 15,\\n      \\\"max_time\\\": 35\\n    },\\n    {\\n      \\\"op_type\\\": \\\"Cast\\\",\\n      \\\"count\\\": 24,\\n      \\\"total_time\\\": 240,\\n      \\\"avg_time\\\": 10,\\n      \\\"min_time\\\": 8,\\n      \\\"max_time\\\": 18\\n    }\\n  ],\\n  \\\"core_type_distribution\\\": {},\\n  \\\"operator_type_stats\\\": [\\n    {\\n      \\\"op_type\\\": \\\"MatMul\\\",\\n      \\\"total_time_us\\\": 4800.0,\\n      \\\"total_calls\\\": 12,\\n      \\\"avg_time_per_call_us\\\": 400.0\\n    },\\n    {\\n      \\\"op_type\\\": \\\"Elementwise\\\",\\n      \\\"total_time_us\\\": 960.0,\\n      \\\"total_calls\\\": 48,\\n      \\\"avg_time_per_call_us\\\": 20.0\\n    },\\n    {\\n      \\\"op_