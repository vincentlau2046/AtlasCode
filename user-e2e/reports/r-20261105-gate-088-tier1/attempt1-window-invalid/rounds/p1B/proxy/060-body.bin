y.bin\n/home/vince/.claude/jobs/09264df0/tmp/gate-088/k5head/req/014-body.bin\n/home/vince/.claude/jobs/09264df0/tmp/gate-088/k5head/req/004-body.bin\n/home/vince/.claude/jobs/09264df0/tmp/gate-088/k5head/req/003-meta.json\n/home/vince/.claude/jobs/09264df0/tmp/gate-088/k5head/req/011-body.bin\n/home/vince/.claude/jobs/09264df0/tmp/gate-088/k5head/req/001-meta.json\n/home/vince/.claude/jobs/09264df0/tmp/gate-088/k5head/req/011-meta.json\n/home/vince/.claude/jobs/09264df0/tmp/gate-088/k5head/req/005-body.bin\n/home/vince/.claude/jobs/09264df0/tmp/gate-088/k5head/req/010-body.bin\n/home/vince/.claude/jobs/09264df0/tmp/gate-088/k5head/req/008-meta.json\n/home/vince/.claude/jobs/09264df0/tmp/gate-088/k5head/req/006-body.bin\n/home/vince/.claude/jobs/09264df0/tmp/gate-088/k5head/req/010-meta.json\n/home/vince/.claude/jobs/09264df0/tmp/gate-088/k5head/req/012-meta.json\n/home/vince/.claude/jobs/09264df0/tmp/gate-088/k5head/req/014-meta.json\n/home/vince/.claude/jobs/09264df0/tmp/gate-088/k5head/req/007-meta.json\n/home/vince/.claude/jobs/09264df0/tmp/gate-088/k5head/req/013-body.bin\n/home/vince/.claude/jobs/09264df0/tmp/gate-088/k5head/req/005-meta.json\n/home/vince/.claude/jobs/09264df0/tmp/gate-088/k5head/req/009-meta.json\n/home/vince/.claude/jobs/09264df0/tmp/gate-088/k5head/req/003-body.bin\n/home/vince/.claude/jobs/09264df0/tmp/gate-088/k5head/req/013-meta.json\n/home/vince/.claude/jobs/09264df0/tmp/gate-088/k5head/req/007-body.bin\n/home/vince/.claude/jobs/09264df0/tmp/gate-088/k5head/req/004-meta.json\n/home/vince/.claude/jobs/09264df0/tmp/gate-088/k5head/rh4-stdout.txt\n"},{"role":"assistant","content":null,"tool_calls":[{"id":"chatcmpl-tool-a652761b467701ef","type":"function","function":{"name":"Read","arguments":"{\"file_path\":\"/home/vince/.claude/jobs/09264df0/tmp/gate-088/tier1/p1B/agent-skills/official/CANNBot/ops/ascendc-perf-optimize/references/single-core-pipeline/no-bound.md\"}"}}]},{"role":"tool","tool_call_id":"chatcmpl-tool-a652761b467701ef","content":"1\t# 无 Bound 优化策略\n2\t\n3\t## 判定条件\n4\t\n5\t- 各硬件单元利用率均不高\n6\t- 无明显单一瓶颈\n7\t- 总吞吐量未达预期\n8\t\n9\t## 仿真图分析要点\n10\t\n11\t- 识别流水线气泡与等待区间\n12\t- 检查搬移-计算 overlap 度\n13\t- 标记 UnitFlag 同步点，检查是否可以进一步减少\n14\t\n15\t---\n16\t\n17\t## 策略 1：开 PingPong\n18\t\n19\t| 操作 | 说明 |\n20\t|------|------|\n21\t| Double Buffer | 搬入与计算交替进行，隐藏搬移延迟 |\n22\t| 双路流水编排 | 使用 Set/Dst 双队列实现搬移-计算 overlap |\n23\t| PingPong 粒度调优 | 控制每次搬移量，确保计算时间 ≥ 搬移时间 |\n24\t\n25\t## 策略 2：MMAD 与 Fixp 间 UnitFlag\n26\t\n27\t| 操作 | 说明 |\n28\t|------|------|\n29\t| UnitFlag 信号 | MMAD 输出 → Fixp 输入通过 UnitFlag 同步，避免同步开销 |\n30\t| 减少 Barrier | 以 UnitFlag 替代显式同步指令 |\n31\t\n32\t## 策略 3：减少单次搬运量\n33\t\n34\t| 操作 | 说明 |\n35\t|------|------|\n36\t| 避免全量搬移 | 仅搬移当前计算所需数据 |\n37\t| 渐进式搬移 | 边算边搬，不积压数据 |\n38\t\n39\t## 策略 4：Preload\n40\t\n41\t| 操作 | 说明 |\n42\t|------|------|\n43\t| 提早搬入下一轮数据 | 在当前计算未完成时启动下一批数据搬移 |\n44\t| 预取指令提前发射 | 利用 MTE2 的空闲窗口 |\n45\t| 调整 Preload 窗口大小 | 匹配计算耗时，避免搬移完成但计算未完成 |\n46\t\n47\t## 策略 5：指令提早发射\n48\t\n49\t| 操作 | 说明 |\n50\t|------|------|\n51\t| 搬移指令提前发射 | 不等待当前计算完全结束 |\n52\t| 计算指令流水线填充 | 减少流水线气泡 |\n53\t\n54\t## 策略 6：Vec 指令融合减少重复搬运\n55\t\n56\t| 操作 | 说明 |\n57\t|------|------|\n58\t| 识别重复搬移模式 | 同一数据被多次搬入的场景 |\n59\t| 融合 Vec 操作 | 在寄存器内连续处理，消除中间搬出搬入 |\n60\t| 一次性搬入多次复用 | 数据驻留 UB 期间完成所有消费 |\n61\t\n62\t## Tiling 修正建议\n63\t\n64\t- 调整 tile 粒度以实现搬移-计算平衡\n65\t- 优化 PingPong 分段大小\n66\t- 调整 Preload 窗口大小与时间节点\n67\t\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"},{"role":"assistant","content":null,"tool_calls":[{"id":"chatcmpl-tool-be8a5b5c62875e5b","type":"function","function":{"name":"Bash","arguments":"{\"command\":\"grep -rl \\\"MatMul_e2e\\\\|matmul\\\" /home/vince/.claude/jobs/09264df0/tmp/gate-088/k5head/ 2>/dev/null | head; echo \\\"===\\\"; ls -la /home/vince/.claude/jobs/09264df0/tmp/gate-088/tier1/ 2>/dev/null; ls /home/vince/.claude/jobs/09264df0/tmp/gate-088/tier1/p1B/home/.atlas/projects/-home-vince--claude-jobs-09264df0-tmp-gate-088-tier1-p1B-ws/memory/ 2>/dev/null\",\"description\":\"Search k5head for matmul references and check memory dir\"}"}}]},{"role":"tool","tool_call_id":"chatcmpl-tool-be8a5b5c62875e5b","content":"[exit code: 0]\n===\ntotal 12\ndrwxrwxr-x  3 vince vince 4096 Nov  5 12:39 .\ndrwxrwxr-x 20 vince vince 4096 Nov  5 12:39 ..\ndrwxrwxr-x  7 vince vince 4096 Nov  5 12:39 p1B\n"},{"role":"assistant","content":null,"tool_calls":[{"id":"chatcmpl-tool-a2f1f126082d1992","type":"function","function":{"name":"Read","arguments":"{\"file_path\":\"/home/vince/.claude/jobs/09264df0/tmp/gate-088/tier1/p1B/agent-skills/official/CANNBot/ops/ascendc-perf-optimize/references/single-core-pipeline/memory.md\"}"}}]},{"role":"tool","tool_call_id":"chatcmpl-tool-a2f1f126082d1992","content":"1\t# 访存 Bound 优化策略\n2\t\n3\t## 判定条件\n4\t\n5\t- MTE2 利用率高（AIC 带宽接近理论峰值）\n6\t- Vector/Cube 单元存在等待数据的空闲气泡\n7\t- 计算密度低（Ops/Byte 低于硬件能力）\n8\t\n9\t## 仿真图分析要点\n10\t\n11\t- 查看 MTE2 搬移时间线与计算时间线的重叠度\n12\t- 识别大数据量搬移窗口，标记可合并或优化的小搬移序列\n13\t\n14\t---\n15\t\n16\t## 策略 1：带宽未打满 → L2 复用\n17\t\n18\t| 操作 | 说明 |\n19\t|------|------|\n20\t| 检查当前带宽利用率 | 对比 `实际带宽 / 理论峰值带宽` |\n21\t| L2 cache 驻留优化 | 调整 tile 大小使数据能驻留 L2，减少重复读 DDR |\n22\t| 多核 L2 共享 | 相邻核处理相邻数据，共享 L2 缓存行 |\n23\t\n24\t## 策略 2：指令效率 / 选基本块\n25\t\n26\t| 操作 | 说明 |\n27\t|------|------|\n28\t| 分析 MTE2 指令发射效率 | 检查是否有冗余搬移指令 |\n29\t| 选取基本块 | 优先使用连续地址 + 大粒度搬移指令 |\n30\t| 减少 stride 搬移 | stride 搬移效率低于连续搬移，重构数据布局 |\n31\t\n32\t## 策略 3：减少小块搬运 / 合并载入\n33\t\n34\t| 操作 | 说明 |\n35\t|------|------|\n36\t| 识别小块搬运 | profiling 中识别小于 threshold 的搬移操作 |\n37\t| 合并连续小块 | 将多个相邻小搬移合并为单次大搬移 |\n38\t| DataCopyPad 参数优化 | 调整对齐参数避免碎片化搬移 |\n39\t| 消除不必要搬移 | 检查 UB 内数据是否可以原地消费，减少搬入搬出 |\n40\t\n41\t## Tiling 修正建议\n42\t\n43\t- 调整 UB tile 大小以提升 L2 命中率\n44\t- 优化数据搬移粒度与对齐参数\n45\t- 调整多核切分以减少单核数据量\n46\t\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"},{"role":"assistant","content":null,"tool_calls":[{"id":"chatcmpl-tool-87696b2b04628389","type":"function","function":{"name":"Bash","arguments":"{\"command\":\"find /home/vince/.claude/jobs/09264df0/tmp/gate-088/tier1/p1B/agent-skills/official/CANNBot/ops -maxdepth 2 -type d | head -30; echo \\\"===\\\"; ls /home/vince/.claude/jobs/09264df0/tmp/gate-088/tier1/p1B/agent-skills/official/CANNBot/ops/ascendc-performance-best-practices/ 2>/dev/null\",\"description\":\"List CANNBot ops skills and best-practices contents\"}"}}]},{"role":"tool","tool_call_id":"chatcmpl-tool-87696b2b04628389","content":"[exit code: 0]\n/home/vince/.claude/jobs/09264df0/tmp/gate-088/tier1/p1B/agent-skills/official/CANNBot/ops\n/home/vince/.claude/jobs/09264df0/tmp/gate-088/tier1/p1B/agent-skills/official/CANNBot/ops/triton-op-coding\n/home/vince/.claude/jobs/09264df0/tmp/gate-088/tier1/p1B/agent-skills/official/CANNBot/ops/triton-op-coding/references\n/home/vince/.claude/jobs/09264df0/tmp/gate-088/tier1/p1B/agent-skills/official/CANNBot/ops/ascendc-crash-debug\n/home/vince/.claude/jobs/09264df0/tmp/gate-088/tier1/p1B/agent-skills/official/CANNBot/ops/ascendc-crash-debug/scripts\n/home/vince/.claude/jobs/09264df0/tmp/gate-088/tier1/p1B/agent-skills/official/CANNBot/ops/ascendc-crash-debug/references\n/home/vince/.claude/jobs/09264df0/tmp/gate-088/tier1/p1B/agent-skills/official/CANNBot/ops/ascendc-registry-invoke-to-direct-invoke\n/home/vince/.claude/jobs/09264df0/tmp/gate-088/tier1/p1B/agent-skills/official/CANNBot/ops/ascendc-registry-invoke-to-direct-invoke/references\n/home/vince/.claude/jobs/09264df0/tmp/gate-088/tier1/p1B/agent-skills/official/CANNBot/ops/ascendc-blaze-best-practice\n/home/vince/.claude/jobs/09264df0/tmp/gate-088/tier1/p1B/agent-skills/official/CANNBot/ops/ascendc-blaze-best-practice/references\n/home/vince/.claude/jobs/09264df0/tmp/gate-088/tier1/p1B/agent-skills/official/CANNBot/ops/ascendc-performance-best-practices\n/home/vince/.claude/jobs/09264df0/tmp/gate-088/tier1/p1B/agent-skills/official/CANNBot/ops/ascendc-performance-best-practices/reference\n/home/vince/.claude/jobs/09264df0/tmp/gate-088/tier1/p1B/agent-skills/official/CANNBot/ops/pypto-op-design\n/home/vince/.claude/jobs/09264df0/tmp/gate-088/tier1/p1B/agent-skills/official/CANNBot/ops/pypto-op-design/templates\n/home/vince/.claude/jobs/09264df0/tmp/gate-088/tier1/p1B/agent-skills/official/CANNBot/ops/pypto-op-design/references\n/home/vince/.claude/jobs/09264df0/tmp/gate-088/tier1/p1B/agent-skills/official/CANNBot/ops/triton-latency-optimizer\n/home/vince/.claude/jobs/09264df0/tmp/gate-088/tier1/p1B/agent-skills/official/CANNBot/ops/triton-latency-optimizer/references\n/home/vince/.claude/jobs/09264df0/tmp/gate-088/tier1/p1B/agent-skills/official/CANNBot/ops/ascendc-task-focus\n/home/vince/.claude/jobs/09264df0/tmp/gate-088/tier1/p1B/agent-skills/official/CANNBot/ops/ascendc-task-focus/references\n/home/vince/.claude/jobs/09264df0/tmp/gate-088/tier1/p1B/agent-skills/official/CANNBot/ops/ascendc-task-focus/assets\n/home/vince/.claude/jobs/09264df0/tmp/gate-088/tier1/p1B/agent-skills/official/CANNBot/ops/ascendc-simt-best-practices\n/home/vince/.claude/jobs/09264df0/tmp/gate-088/tier1/p1B/agent-skills/official/CANNBot/ops/ascendc-simt-best-practices/references\n/home/vince/.claude/jobs/09264df0/tmp/gate-088/tier1/p1B/agent-skills/official/CANNBot/ops/ops-precision-standard\n/home/vince/.claude/jobs/09264df0/tmp/gate-088/tier1/p1B/agent-skills/official/CANNBot/ops/ops-precision-standard/scripts\n/home/vince/.claude/jobs/09264df0/tmp/gate-088/tier1/p1B/agent-skills/official/CANNBot/ops/ops-precision-standard/reference\n/home/vince/.claude/jobs/09264df0/tmp/gate-088/tier1/p1B/agent-skills/official/CANNBot/ops/ops-simulator\n/home/vince/.claude/jobs/09264df0/tmp/gate-088/tier1/p1B/agent-skills/official/CANNBot/ops/ops-simulator/scripts\n/home/vince/.claude/jobs/09264df0/tmp/gate-088/tier1/p1B/agent-skills/official/CANNBot/ops/ops-simulator/references\n/home/vince/.claude/jobs/09264df0/tmp/gate-088/tier1/p1B/agent-skills/official/CANNBot/ops/ascendc-runtime-debug\n/home/vince/.claude/jobs/09264df0/tmp/gate-088/tier1/p1B/agent-skills/official/CANNBot/ops/ascendc-runtime-debug/scripts\n===\nSKILL.md\nreference\n"},{"role":"assistant","content":null,"tool_calls":[{"id":"chatcmpl-tool-b086fcf64de67667","type":"function","function":{"name":"Bash","arguments":"{\"command\":\"ls /home/vince/.claude/jobs/09264df0/tmp/gate-088/tier1/p1B/agent-skills/official/CANNBot/ops/ascendc-performance-best-practices/reference/\",\"description\":\"List performance best-practices reference docs\"}"}}]},{"role":"tool","tool_call_id":"chatcmpl-tool-b086fcf64de67667","content":"[exit code: 0]\nbroadcast\ncommon\nconversion\nelementwise\nmatmul\nscalar\nsimt\nsoftmax\nsort\n"},{"role":"assistant","content":null,"tool_calls":[{"id":"chatcmpl-tool-a3ef97654c92d7a5","type":"function","function":{"name":"Bash","arguments":"{\"command\":\"ls /home/vince/.claude/jobs/09264df0/tmp/gate-088/tier1/p1B/agent-skills/official/CANNBot/ops/ascendc-performance-best-practices/reference/matmul/ /home/vince/.claude/jobs/09264df0/tmp/gate-088/tier1/p1B/agent-skills/official/CANNBot/ops/ascendc-performance-best-practices/reference/common/\",\"description\":\"List matmul and common reference docs\"}"}}]},{"role":"tool","tool_call_id":"chatcmpl-tool-a3ef97654c92d7a5","content":"[exit code: 0]\n/home/vince/.claude/jobs/09264df0/tmp/gate-088/tier1/p1B/agent-skills/official/CANNBot/ops/ascendc-performance-best-practices/reference/common/:\ndatacopy_optimization_design.md\ntail_block_design.md\nub_resident_design.md\n\n/home/vince/.claude/jobs/09264df0/tmp/gate-088/tier1/p1B/agent-skills/official/CANNBot/ops/ascendc-performance-best-practices/reference/matmul/:\nfullload_design.md\nguide.md\nmte2_preload_design.md\npingpong_design.md\nscale_coalescing_design.md\nstreamk_design.md\nswat_design.md\n"},{"role":"assistant","content":null,"tool_calls":[{"id":"chatcmpl-tool-9ccc25fb3d420fef","type":"function","function":{"name":"Read","arguments":"{\"file_path\":\"/home/vince/.claude/jobs/09264df0/tmp/gate-088/tier1/p1B/agent-skills/official/CANNBot/ops/ascendc-performance-best-practices/reference/matmul/pingpong_design.md\"}"}}]},{"role":"tool","tool_call_id":"chatcmpl-tool-9ccc25fb3d420fef","content":"1\t# matmul Pingpong 双缓冲优化设计\n2\t\n3\t## 1. 优化目标\n4\t\n5\t将 matmul 算子（含 MXFP4/MXFP8 等量化变体）从**串行执行**（GM→L1→L0→CUBE→L0C→GM 逐步等待）改为**三级流水并行**，通过 L1 和 L0 的 pingpong 双缓冲，使搬运和计算重叠执行，预期 case 总时间缩短至原来的 50%–60%。\n6\t\n7\t## 2. 架构概览\n8\t\n9\t### 2.1 存储层级与数据流\n10\t\n11\t```\n12\tGM (Global Memory)\n13\t  │\n14\t  │ MTE2 (GM → L1)\n15\t  ▼\n16\tL1 Buffer [A_ping | A_pong | B_ping | B_pong | scaleA_ping | scaleA_pong | scaleB_ping | scaleB_pong]\n17\t  │\n18\t  │ MTE1 (L1 → L0A/L0B)\n19\t  ▼\n20\tL0A / L0B Buffer [half_0 | half_1]  ← L0 也做 pingpong\n21\t  │\n22\t  │ CUBE (L0A × L0B → L0C)\n23\t  ▼\n24\tL0C Buffer\n25\t  │\n26\t  │ FIXP + MTE3 (L0C → GM)\n27\t  ▼\n28\tGM (Output)\n29\t```\n30\t\n31\t### 2.2 双缓冲原理\n32\t\n33\t**L1 层级**：将 L1 空间分为 2 份（ping/pong），MTE2 搬下一轮数据到 L1[next] 的同时，MTE1 从 L1[cur] 搬数据到 L0。\n34\t\n35\t**L0 层级**：将 L0A/L0B 空间各分为 2 份（half_0/half_1），MTE1 搬下一轮数据到 L0[next] 的同时，CUBE 处理 L0[cur]。\n36\t\n37\t### 2.3 事件同步模型\n38\t\n39\t| 事件类型 | 含义 | 用途 |\n40\t|---------|------|------|\n41\t| `MTE1_MTE2` | MTE1 完成 → 允许 MTE2 覆写 | L1 buffer 释放控制 |\n42\t| `MTE2_MTE1` | MTE2 完成 → 允许 MTE1 读取 | L1 数据就绪通知 |\n43\t| `M_MTE1` | CUBE 完成 → 允许 MTE1 覆写 | L0 buffer 释放控制 |\n44\t| `MTE1_M` | MTE1 完成 → 允许 CUBE 计算 | L0 数据就绪通知 |\n45\t| `M_FIX` | CUBE 完成 → 允许 FIXP 输出 | L0C 数据就绪 |\n46\t| `FIX_M` | FIXP 完成 → 允许下一轮 CUBE | L0C buffer 释放 |\n47\t\n48\t## 3. 关键参数配置\n49\t\n50\t```cpp\n51\tconstexpr uint32_t BASE_M = 256;      // L0 tile M 维度\n52\tconstexpr uint32_t BASE_N = 256;      // L0 tile N 维度\n53\tconstexpr uint32_t BASE_K = 256;      // L0 tile K 维度\n54\tconstexpr uint32_t PINGPONG_NUM = 2;  // L1 双缓冲数量\n55\tconstexpr uint32_t L1_BUFFER_NUM = 3; // L1 中 K 维度展开倍数\n56\t\n57\t// L1 参数\n58\tparams.l1Params.kL1 = BASE_K * L1_BUFFER_NUM;       // L1 中单个 buffer 的 K 大小 = 768\n59\tparams.l1Params.scaleKL1 = BASE_K * L1_BUFFER_NUM;   // Scale 的 K 大小\n60\tparams.l1Params.l1BufNum = PINGPONG_NUM;              // pingpong 数量 = 2\n61\t```\n62\t\n63\t### 3.1 L1 内存布局\n64\t\n65\t```\n66\tL1 地址空间:\n67\t[A_ping][A_pong][B_ping][B_pong][scaleA_ping][scaleA_pong][scaleB_ping][scaleB_pong]\n68\t\n69\t偏移计算:\n70\tl1BufferAOffset_[0] = 0                                    // A_ping\n71\tl1BufferAOffset_[1] = aL1OneBuffer_                        // A_pong\n72\tl1BufferBOffset_[0] = aL1OneBuffer_ * 2                    // B_ping\n73\tl1BufferBOffset_[1] = aL1OneBuffer_ * 2 + bL1OneBuffer_    // B_pong\n74\tscaleBase = aL1OneBuffer_ * 2 + bL1OneBuffer_ * 2          // Scale 区起始\n75\t```\n76\t\n77\t### 3.2 L0 Pingpong 索引\n78\t\n79\t```cpp\n80\tuint64_t l0Offset = HALF_L0_SIZE * (l0PingPong_ & 0x1);   // 交替使用 L0 两半\n81\tl0PingPong_++;                                              // 每次 L0 迭代后切换\n82\t```\n83\t\n84\t## 4. 核心计算循环\n85\t\n86\t### 4.1 外层循环（K 维度 L1 级别）\n87\t\n88\t```\n89\tfor iter0 = 0 to kL1Iter_:     // K 维度按 kL1 切分\n90\t    l1BufId = abL1LoopCnt_ & 1  // L1 pingpong 索引\n91\t\n92\t    // 1) Scale 搬运 (按 scaleKL1/kL1 频率刷新)\n93\t    if iter0 % (scaleKL1/kL1) == 0:\n94\t        WaitFlag<MTE1_MTE2>(SCALE_FLAG + scaleL1BufId)\n95\t        CopyScaleGM2L1(scaleA, scaleB)\n96\t\n97\t    // 2) A/B 数据搬运 GM → L1\n98\t    WaitFlag<MTE1_MTE2>(l1BufId)    // 等待上一轮 MTE1 用完该 buffer\n99\t    CopyGM2L1(A → L1[l1BufId], B → L1[l1BufId])\n100\t    SetFlag<MTE2_MTE1>(l1BufId)     // 通知 MTE1 数据就绪\n101\t    WaitFlag<MTE2_MTE1>(l1BufId)\n102\t\n103\t    // 3) 内层循环：L0 级别迭代\n104\t    for iter1 = 0 to kL0Iter:\n105\t        l0Offset = HALF_L0_SIZE * (l0PingPong_ & 1)\n106\t        WaitFlag<M_MTE1>(l0PingPong_ & 1)   // 等待 CUBE 用完 L0\n107\t\n108\t        CopyL12L0(A_L1 → L0A[l0Offset])\n109\t        CopyL12L0(B_L1 → L0B[l0Offset])\n110\t        CopyL12L0(scaleA_L1 → L0A_scale)\n111\t        CopyL12L0(scaleB_L1 → L0B_scale)\n112\t\n113\t        SetFlag<MTE1_M>(l0PingPong_ & 1)    // 通知 CUBE 数据就绪\n114\t        WaitFlag<MTE1_M>(l0PingPong_ & 1)\n115\t\n116\t        MMAD(L0C, L0A, L0B)                 // CUBE 矩阵乘\n117\t\n118\t        SetFlag<M_MTE1>(l0PingPong_ & 1)    // 通知 MTE1 可覆写 L0\n119\t        l0PingPong_++\n120\t\n121\t    // 4) 释放 L1 buffer\n122\t    SetFlag<MTE1_MTE2>(l1BufId)\n123\t    abL1LoopCnt_++\n124\t\n125\t// 5) 输出\n126\tSetFlag<M_FIX>(0); WaitFlag<M_FIX>(0)\n127\tCopyL0C2GM(gmC, tensorL0C)                   // FIXP 输出\n128\tSetFlag<FIX_M>(0); WaitFlag<FIX_M>(0)\n129\t```\n130\t\n131\t### 4.2 流水并行示意\n132\t\n133\t```\n134\t时间线 →\n135\t─────────────────────────────────────────────────────\n136\tMTE2:  [搬 A/B iter0 → L1_ping]  [搬 A/B iter1 → L1_pong]  [搬 iter2 → L1_ping] ...\n137\tMTE1:        [搬 L1_ping → L0_half0]  [搬 L1_ping → L0_half1]  [搬 L1_pong → L0_half0] ...\n138\tCUBE:              [计算 L0_half0]         [计算 L0_half1]           [计算 L0_half0] ...\n139\tFIXP:                                                                       [输出] ...\n140\t```\n141\t\n142\t## 5. 从 naive 到 pingpong 的关键修改点\n143\t\n144\t| 修改项 | naive（优化前） | pingpong（优化后） |\n145\t|--------|---------------|-------------------|\n146\t| L1 buffer 数量 | `l1BufNum = 1` | `l1BufNum = PINGPONG_NUM = 2` |\n147\t| L1 内存布局 | 单份 A + B | A_ping + A_pong + B_ping + B_pong |\n148\t| L0 buffer 使用 | 固定偏移 0 | `HALF_L0_SIZE * (l0PingPong_ & 1)` 交替 |\n149\t| L1 buffer 选择 | 固定 0 | `abL1LoopCnt_ & (l1BufNum_ - 1)` |\n150\t| 事件初始化 | 无/简单 | 构造函数中 SetFlag 初始化所有 MTE1_MTE2/M_MTE1 事件 |\n151\t| GM→L1 同步 | 等待完成再继续 | `WaitFlag<MTE1_MTE2>` 等待旧 buffer 释放 |\n152\t| L1→L0 同步 | 等待完成再继续 | `WaitFlag<M_MTE1>` 等待 CUBE 用完 L0 |\n153\t| CUBE→MTE1 同步 | 无 | `SetFlag<M_MTE1>` 通知 MTE1 可覆写 |\n154\t| MTE2→MTE1 通知 | 无 | `SetFlag<MTE2_MTE1>` 通知 L1 数据就绪 |\n155\t| Scale buffer | 固定 | `scaleLoopCnt_ & 1` 双缓冲 |\n156\t\n157\t## 6. 注意事项\n158\t\n159\t1. **L1 大小约束**：`kL1 = BASE_K * L1_BUFFER_NUM` 决定了单次 L1 装载的 K 维度；`PINGPONG_NUM = 2` 则需要 2 倍 L1 空间存放 A 和 B\n160\t2. **事件 ID 管理**：`MTE1_MTE2_EVENT_ID_NUM` 定义了事件 ID 的数量上限（通常为 4），pingpong 使用 ID 0 和 1\n161\t3. **L0C Pingpong**：代码中 `enableL0cPingPong_ = false`，L0C 层级的 pingpong 在本版本中未启用\n162\t4. **精度验证**：优化后必须通过 `verify_result.py` 的精度校验\n163\t5. **kL1=768 (L1_BUFFER_NUM=3) 的选取原则：尽可能用满 L1 空间**。在 pingpong 双缓冲（`PINGPONG_NUM=2`）约束下，`L1_BUFFER_NUM` 应取满足 `2 × singleBufferSize ≤ l1_size` 的**最大整数值**，使每个 buffer 覆盖尽可能多的 K 范围以减少外层循环迭代次数和流水起停开销。以 `baseM=baseN=256, baseK=256` 为例：`L1_BUFFER_NUM=4` 时双 buffer 557,056 bytes 溢出；`L1_BUFFER_NUM=3` 时双 buffer 417,792 bytes ≤ 524,288 bytes（L1 利用率 80%），是合法最大值。理论建模生成器 `tiling_gen.py` 输出的 `stepK=2` 是 K 向分步的理论档位（受 depth 倍增搜索机制约束只能为 2 的幂），与本文档的 `L1_BUFFER_NUM=3` 是两个独立概念。**实施时应以本文档的 `L1_BUFFER_NUM=3` 为准**\n164\t\n165\t## 7. 实施常见问题与解决方案\n166\t\n167\t以下是从 0_naive 基线改造为 pingpong 版本时，实际遇到的典型问题：\n168\t\n169\t### 问题 1：L1_BUFFER_NUM 取值过大导致 L1 内存溢出\n170\t\n171\t**现象**：naive 版本使用 `L1_BUFFER_NUM = 4`（kL1 = 1024），引入双缓冲后若不调整，L1 总占用 = 2 × (A + B + ScaleA + ScaleB) 会超出 L1 容量（512KB），导致仿真报错或精度失败。\n172\t\n173\t**原因**：pingpong 需要 2 倍 L1 空间。naive 的 `kL1 = BASE_K * 4 = 1024` 时单 buffer 占用已较大，乘以 2 后超出限制。\n174\t\n175\t**解决方案**：将 `L1_BUFFER_NUM` 从 4 降为 3（或更小），使 `kL1 = BASE_K * 3 = 768`。需要满足：\n176\t\n177\t```\n178\t总 L1 占用 = PINGPONG_NUM × (aL1OneBuffer + bL1OneBuffer + scaleAL1OneBuffer + scaleBL1OneBuffer) ≤ L1_SIZE (512KB)\n179\t```\n180\t\n181\t以 M=1024, N=2048, K=4096, baseM=baseN=256, kL1=768 为例：\n182\t- aL1OneBuffer = 256 × 768 / 2 = 98,304 bytes（FP4 半字节）\n183\t- bL1OneBuffer = 256 × 768 / 2 = 98,304 bytes\n184\t- scaleAL1OneBuffer = 256 × ⌈768/32⌉ = 256 × 24 = 6,144 bytes\n185\t- scaleBL1OneBuffer = 256 × 24 = 6,144 bytes\n186\t- 单 buffer 合计 = 208,896 bytes\n187\t- 双 buffer 合计 = 417,792 bytes ≤ 524,288 bytes ✅\n188\t\n189\t若 `L1_BUFFER_NUM = 4`（kL1 = 1024）：\n190\t- 单 buffer 合计 = 2 × (256 × 1024 / 2) + 2 × (256 × 32) = 278,528 bytes\n191\t- 双 buffer 合计 = 557,056 bytes > 524,288 bytes ❌ **溢出**\n192\t\n193\t### 问题 2：L1Params 结构体需要扩展\n194\t\n195\t**现象**：编译报错，`L1Params` 没有 `scaleKL1` 和 `l1BufNum` 成员。\n196\t\n197\t**原因**：naive 版本的 `L1Params` 只有 `kL1` 一个字段，pingpong 版本需要额外传递 `scaleKL1`（Scale 的 K 覆盖范围）和 `l1BufNum`（buffer 数量）。\n198\t\n199\t**解决方案**：在 `block_mmad_mx_base.h` 的 `L1Params` 结构体中新增字段：\n200\t\n201\t```cpp\n202\tstruct L1Params {\n203\t    uint64_t kL1{0};\n204\t    uint64_t scaleKL1{0};    // 新增\n205\t    uint64_t l1BufNum{1};    // 新增，默认值 1 保持向后兼容\n206\t};\n207\t```\n208\t\n209\t### 问题 3：MTE2_MTE1 事件同步仍然紧耦合（性能隐患）\n210\t\n211\t**现象**：优化后 cycle 数下降了（42.4k → 30.2k），但未达到理论预期的 ~21k cycles。\n212\t\n213\t**原因**：当前实现中第 194-195 行仍保留了 `SetFlag<MTE2_MTE1>` + `WaitFlag<MTE2_MTE1>` 紧耦合：\n214\t\n215\t```cpp\n216\tAscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(l1BufId);\n217\tAscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(l1BufId);  // ← 紧跟 Wait，MTE2 搬完后仍需等待才能开始 MTE1\n218\t```\n219\t\n220\t同样，内层循环中 `MTE1_M` 也是紧耦合（第 241-242 行）：\n221\t\n222\t```cpp\n223\tAscendC::SetFlag<AscendC::HardEvent::MTE1_M>(l0BufId);\n224\tAscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(l0BufId);  // ← 紧跟 Wait，MTE1 搬完后仍需等待才能开始 CUBE\n225\t```\n226\t\n227\t这意味着虽然 L1/L0 地址已经做了 pingpong 分离，但 **事件同步层面仍是串行** — MTE2 与 MTE1 之间、MTE1 与 CUBE 之间并未真正实现异步流水。性能提升主要来自 kL1 从 1024 调整为 768 带来的循环结构变化，而非真正的流水并行。\n228\t\n229\t**解决方案**：要实现真正的流水并行，需将 `WaitFlag` 移到实际消费数据的位置，而非紧跟在 `SetFlag` 后面。参考设计文档第 4.1 节伪代码中的同步模式：\n230\t\n231\t```\n232\t// 正确的流水同步模式：SetFlag 和 WaitFlag 分离\n233\tSetFlag<MTE2_MTE1>(l1BufId)     // MTE2 搬完后立即通知\n234\t// ... MTE2 可以继续搬下一轮到另一个 buffer ...\n235\tWaitFlag<MTE2_MTE1>(l1BufId)    // 在内层循环入口处才等待（此时 MTE2 可能已搬完下一轮）\n236\t```\n237\t\n238\t### 问题 4：CMakeLists.txt 需要指向新的源码目录\n239\t\n240\t**现象**：修改了 `src_optimized/` 下的代码，但编译仍使用 `src/` 目录的旧代码。\n241\t\n242\t**原因**：`CMakeLists.txt` 中 `add_executable` 的源码路径指向 `src/`。\n243\t\n244\t**解决方案**：修改 `CMakeLists.txt` 中的源码路径，将 `src/` 改为 `src_optimized/`，包括 `target_include_directories` 中的 include 路径。编译验证通过后，可通过切换路径来对比基线和优化版本。\n245\t\n246\t### 问题总结\n247\t\n248\t| # | 问题 | 根因 | 解决方案 | 影响 |\n249\t|---|------|------|---------|------|\n250\t| 1 | L1 内存溢出 | kL1 × 2 > L1_SIZE | 降低 L1_BUFFER_NUM（4→3） | 编译/仿真失败 |\n251\t| 2 | L1Params 缺少字段 | naive 版本结构体不完整 | 新增 scaleKL1、l1BufNum | 编译失败 |\n252\t| 3 | HALF_L0_SIZE 未定义 | naive 不需要 L0 半区 | 定义 `L0A_SIZE / 2` | 编译失败 |\n253\t| 4 | 事件同步紧耦合 | SetFlag+WaitFlag 紧挨 | 分离 SetFlag 和 WaitFlag | 性能未达理论预期 |\n254\t| 5 | CMakeLists 路径 | 源码目录未切换 | 修改 include/src 路径 | 编译用旧代码 |\n255\t\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"},{"role":"assistant","content":null,"tool_calls":[{"id":"chatcmpl-tool-8688cab1fc486ef3","type":"function","function":{"name":"Read","arguments":"{\"file_path\":\"/home/vince/.claude/jobs/09264df0/tmp/gate-088/tier1/p1B/agent-skills/official/CANNBot/ops/ascendc-perf-optimize/references/single-core-pipeline/vec.md\"}"}}]},{"role":"tool","tool_call_id":"chatcmpl-tool-8688cab1fc486ef3","content":"1\t# VEC Bound 优化策略\n2\t\n3\tVEC bound 是 elementwise、activation、reduction 类算子最常见的瓶颈。Vector 计算单元成为耗时主导，MTE2/MTE3 搬运单元相对空闲。\n4\t\n5\t---\n6\t\n7\t## 判定条件\n8\t\n9\t- Vector 单元利用率高，`aiv_vec_ratio` 是耗时主导\n10\t- Vector 指令占据主要执行时间\n11\t- MTE2 和 Cube 单元相对空闲\n12\t\n13\t**瓶颈严重程度分级**：\n14\t\n15\t| VEC 占比 | 等级 | 优化方向 |\n16\t|----------|------|---------|\n17\t| 50–65% | 轻度 | DoubleBuffer + UB 融合有较大收益 |\n18\t| 65–80% | 中度 | 减少 Cast 或融合指令 |\n19\t| >80% | 深度 | VEC 本身已接近理论极限，优化空间有限 |\n20\t\n21\t---\n22\t\n23\t## 仿真图分析要点\n24\t\n25\t- 识别 Vector 指令密集区\n26\t- 检查 Vector 指令间的数据依赖性，寻找可并行执行的机会\n27\t\n28\t**VEC bound trace 特征**：\n29\t\n30\t```\n31\tTime: 0 ---------------------------------------- 100ms\n32\t\n33\tSCALAR     |##............................| 5%\n34\tSCALARLDST |##............................| 4%\n35\tMTE2       |.##....##....##....##.........|15%\n36\tVECTOR     |..############################|65%  <- 主导\n37\tMTE3       |..........................####.|10%\n38\t```\n39\t\n40\tVECTOR 行持续活跃，MTE2 有明显空闲等待，说明搬运速度快于计算速度。\n41\t\n42\t---\n43\t\n44\t## VEC 内部指令分析\n45\t\n46\t从 Chrome Trace JSON 提取 pid=5 (VECTOR) 事件，按 `name` 分类统计：\n47\t\n48\t| 指令类型 | 典型指令 | 含义 |\n49\t|---------|---------|------|\n50\t| 算术类 | `vec_add`, `vec_mul`, `vec_sub` | 基本计算，低延迟 |\n51\t| 超越函数类 | `vec_exp`, `vec_log`, `vec_rec`, `vec_rsqrt` | 高延迟指令，无硬件加速 |\n52\t| 类型转换类 | `vcvt_f2f`, `vcvt_f2s`, `vcvt_s2f` | Cast 开销 |\n53\t| 归约类 | `vec_reduce_sum`, `vec_reduce_max` | reduction 开销 |\n54\t\n55\t**判断规则**：\n56\t- Cast 占比 >20% → 类型转换密集场景，优化 Cast 有高收益\n57\t- 超越函数占比 >30% → 深度 VEC bound，优化空间有限\n58\t\n59\t> ascend950 regbase 范式使用 **RVEC** 单元：RVECEX（执行）、RVECLD（加载）、RVECST（存储）、RVECSU（设置）。\n60\t\n61\t---\n62\t\n63\t## 策略 1：UB 融合\n64\t\n65\t多个连续的 Vector 操作直接在 UB 中完成，不将中间结果写回 GM，消除不必要的 MTE2/MTE3 往返。\n66\t\n67\t```\n68\t未融合: GM → UB → Compute1 → GM → UB → Compute2 → GM    // 6 次 GM 访问\n69\t已融合: GM → UB → Compute1 → Compute2 → UB → GM          // 2 次 GM 访问\n70\t```\n71\t\n72\t**检查方法**：在 trace 中观察两个 VECTOR 活跃段之间是否插入了 MTE3（写回）+ MTE2（读入）。如果有，说明中间结果经过了 GM，未融合。\n73\t\n74\t| 操作 | 说明 |\n75\t|------|------|\n76\t| 识别可融合的相邻 Vector 操作 | 消除中间搬移和暂存 |\n77\t| 链式 Vector 操作合并 | Mul+Add → MulAdd, 多个激活函数链式处理 |\n78\t| 减少中间结果写回 UB | 融合后在寄存器内完成传递 |\n79\t\n80\t---\n81\t\n82\t## 策略 2：减少类型转换\n83\t\n84\tCast（类型转换）是 VEC bound 中最常见的隐性开销。典型模式：`fp16 → Cast fp32 → 计算 → Cast fp16`。当计算本身只有 1–2 条指令时，Cast 可能占总 VEC 时间的 30–50%。\n85\t\n86\t| 操作 | 说明 |\n87\t|------|------|\n88\t| 批量 Cast | 将多次 Cast 合并为一次大粒度操作 |\n89\t| 避免不必要的 Cast | 检查计算精度是否必须转换 |\n90\t| 选择合适的计算精度 | 全链路 fp16 或全链路 fp32，避免往返转换 |\n91\t\n92\t---\n93\t\n94\t## 策略 3：融合指令\n95\t\n96\t使用融合指令减少 VEC 指令数：\n97\t\n98\t| 指令 | 等价操作 | 说明 |\n99\t|------|---------|------|\n100\t| VMULA | VMUL + VADD | 乘加融合 |\n101\t| VMULS | VMUL + VSUB | 乘减融合 |\n102\t| VMADD | 累加模式 | 单指令累加 |\n103\t\n104\t---\n105\t\n106\t## 策略 4：低延迟归约\n107\t\n108\t对于 reduction 操作，优先使用硬件树形归约指令（ReduceSum / ReduceMax / ReduceMin），避免手动 for 循环逐元素归约。\n109\t\n110\t---\n111\t\n112\t## 策略 5：RegBase 访存\n113\t\n114\t| 操作 | 说明 |\n115\t|------|------|\n116\t| 数据布局调整为 RegBase 友好 | 连续读取、对齐访问 |\n117\t| 使用 RegBase 加载指令 | 减少地址计算开销 |\n118\t| 减少 vload/vstore 次数 | RegBase 大粒度搬移优势 |\n119\t\n120\t---\n121\t\n122\t## DoubleBuffer 检查\n123\t\n124\t在 Chrome Trace 中观察 MTE2 和 VECTOR 行的时间重叠：\n125\t\n126\t| 模式 | 特征 | 含义 |\n127\t|------|------|------|\n128\t| **DB 生效** | MTE2 和 VECTOR 交替出现 | 搬入与计算重叠，流水健康 |\n129\t| **DB 未生效** | MTE2 全在前，VECTOR 全在后 | 串行执行，需开启或修复 DoubleBuffer |\n130\t\n131\t---\n132\t\n133\t## Tiling 修正建议\n134\t\n135\t- 调整 UB 布局以支持更高效的 RegBase 访问模式\n136\t- 调整 tile 粒度匹配 Vector 融合窗口\n137\t- 增大 tile 尺寸减少循环次数，降低流水启停开销（UB 容量：192KB / 910B2，248KB / 950）\n138\t- 使能 DoubleBuffer 时，实际可用 UB 需除以 2\n139\t\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"},{"role":"assistant","content":null,"tool_calls":[{"id":"chatcmpl-tool-a81f09265e930511","type":"function","function":{"name":"Bash","arguments":"{\"command\":\"grep -n \\\"l0c\\\\|L0C\\\\|pbC\\\\|dbL0c\\\" /home/vince/.claude/jobs/09264df0/tmp/gate-088/tier1/p1B/agent-skills/official/CANNBot/ops/ascendc-performance-best-practices/reference/matmul/guide.md | head -20; echo \\\"===\\\"; head -60 /home/vince/.claude/jobs/09264df0/tmp/gate-088/tier1/p1B/agent-skills/official/CANNBot/ops/ascendc-performance-best-practices/reference/matmul/guide.md\",\"description\":\"Check matmul guide for L0C and pipeline topics\"}"}}]},{"role":"tool","tool_call_id":"chatcmpl-tool-a81f09265e930511","content":"[exit code: 0]\n===\n# MatMul 类算子性能优化策略索引\n\n按策略类型查找对应的适用场景与详细设计文档。\n\n适用于 `matmul` 族所有变体：`matmul`、`matmul_mxfp4`、`matmul_a16w16`、`batch_matmul`、`matmul_all_reduce` 等。\n\n| 策略 | 适用场景 | 核心手段 | 详细文档 |\n|------|---------|---------|---------|\n| **pingpong** | 所有 matmul（基线，其它优化的默认前置） | L1/L0 双缓冲 + MTE2/MTE1/Fixpipe 事件同步流水化；`L1_BUFFER_NUM` 取满足 L1 预算的最大整数 | [pingpong_design.md](pingpong_design.md) |\n| **swat** | MN 够并行（`totalBlockCnt > aicNum` 数倍）但存在尾碎片负载不均 | 机制 A Serpentine 行窗口（B 侧复用 + 流式带宽）/ 机制 B 尾块合并 / 机制 C 末轮二维再切分 | [swat_design.md](swat_design.md) |\n| **streamk** | MN 欠并行（`totalBlockCnt < aicNum`）+ 长 K（≥ 2048），或 baseM/N 已到 CUBE 粒度下限的 MN 不整除情形 | SK / DP+SK 两子模式：切 K 到空闲核，AIV 从 workspace 归约 | [streamk_design.md](streamk_design.md) |\n| **fullload**（A-Full-Load / B-Full-Load） | 有\"小侧矩阵\"（一侧 ≤ L1/2）+ 对侧循环次数 `T ≥ 2` + 真 MTE2 bound | 小侧矩阵 + 随路 Scale 一次性驻留 L1，消除对侧循环中的重复 GM→L1 搬运 | [fullload_design.md](fullload_design.md) |\n| **scale_coalescing** | 假 MTE2 bound（MTE2 busy 高但带宽利用率 < 70%）+ 存在 < 20 KB 的 scale / bias / LUT 小块 | `scaleKL1 = SCALE_L1_BUFFER_NUM × kL1`，把 K 向 `baseK` 切碎的小块合并成一次大 MTE2 | [scale_coalescing_design.md](scale_coalescing_design.md) |\n| **mte2_preload** | pingpong 已开 + 各流水 busy ≤ 70%（准无 bound）+ 流水图可见 MTE2_PING/PONG 间 gap + `kL1TileNum ≥ 2` | Kernel 主循环改造为「段 1 首轮 PING / 段 2 预取 PONG / 段 3 消费」三段结构；零 TilingData 数值改动 | [mte2_preload_design.md](mte2_preload_design.md) |\n"}],"tools":[{"type":"function","function":{"name":"Agent","description":"Agent","parameters":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"description":{"type":"string","description":"A short (3-5 word) description of the task"},"prompt":{"type":"string","description":"The task for the agent to perform"},"subagent_type":{"description":"The type of specialized agent to use for this task","type":"string"},"model":{"description":"Optional model override for this agent. Takes precedence over the agent definition's model frontmatter. If omitted, uses the agent definition's model, or inherits from the parent.","type":"string","enum":["small","premium","fast"]},"run_in_background":{"description":"Set to true to run this agent in the background. You will be notified when it completes.","type":"boolean"},"name":{"description":"Name for the spawned agent. Makes it addressable via SendMessage({to: name}) while running.","type":"string"},"team_name":{"description":"Team name for spawning. Uses current team context if omitted.","type":"string"}},"required":["description","prompt"],"additionalProperties":false}}},{"type":"function","function":{"name":"AscendSkillSourceCheck","description":"AscendSkillSourceCheck","parameters":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"source":{"type":"string","enum":["agent-skills","ms-agent-skills"]},"action":{"type":"string","enum":["check","update"]},"timeoutMs":{"type":"integer","exclusiveMinimum":0,"maximum":120000}},"required":["source","action"],"additionalProperties":false}}},{"type":"function","function":{"name":"AskUserQuestion","description":"AskUserQuestion","parameters":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"questions":{"minItems":1,"maxItems":4,"type":"array","items":{"type":"object","properties":{"question":{"type":"string","description":"The complete question to ask the user. Should be clear, specific, and end with a question mark. Example: \"Which library should we use for date formatting?\" If multiSelect is true, phrase it accordingly, e.g. \"Which features do you want to enable?\""},"header":{"type":"string","description":"Very short label displayed as a chip/tag (max 12 chars). Examples: \"Auth method\", \"Library\", \"Approach\"."},"options":{"minItems":2,"maxItems":4,"type":"array","items":{"type":"object","properties":{"label":{"type":"string","description":"The display text for this option that the user will see and select. Should be concise (1-5 words) and clearly describe the choice."},"description":{"type":"string","description":"Explanation of what this option means or what will happen if chosen. Useful for providing context about trade-offs or implications."},"preview":{"description":"Optional preview content rendered when this option is focused. Use for mockups, code snippets, or visual comparisons that help users compare options. See the tool description for the expected content format.","type":"string"}},"required":["label","description"],"additionalProperties":false},"description":"The available choices for this question. Must have 2-4 options. Each option should be a distinct, mutually exclusive choice (unless multiSelect is enabled). There should be no 'Other' option, that will be provided automatically."},"multiSelect":{"default":false,"description":"Set to true to allow the user to select multiple options instead of just one. Use when choices are not mutually exclusive.","type":"boolean"}},"required":["question","header","options","multiSelect"],"additionalProperties":false},"description":"Questions to ask the user (1-4 questions)"},"answers":{"description":"User answers collected by the permission component","type":"object","propertyNames":{"type":"string"},"additionalProperties":{"type":"string"}},"annotations":{"description":"Optional per-question annotations from the user (e.g., notes on preview selections). Keyed by question text.","type":"object","propertyNames":{"type":"string"},"additionalProperties":{"type":"object","properties":{"preview":{"description":"The preview content of the selected option, if the question used previews.","type":"string"},"notes":{"description":"Free-text notes the user added to their selection.","type":"string"}},"additionalProperties":false}},"metadata":{"description":"Optional metadata for tracking and analytics purposes. Not displayed to user.","type":"object","properties":{"source":{"description":"Optional identifier for the source of this question (e.g., \"remember\" for /remember command). Used for analytics tracking.","type":"string"}},"additionalProperties":false}},"required":["questions"],"additionalProperties":false}}},{"type":"function","function":{"name":"Bash","description":"Bash","parameters":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"command":{"type":"string","description":"The bash command to execute."},"description":{"description":"Clear, concise description of what this command does (shown in the UI).","type":"string"},"timeout_ms":{"description":"Timeout in milliseconds. The executor applies its configured default and cap, and kills the command on expiry.","type":"integer","exclusiveMinimum":0,"maximum":9007199254740991},"timeout":{"description":"Timeout in milliseconds (alias accepted by the shared tool-execution layer).","type":"integer","exclusiveMinimum":0,"maximum":9007199254740991},"_simulatedSedEdit":{"type":"object","properties":{"filePath":{"type":"string"},"before":{"type":"string"},"after":{"type":"string"}},"required":["filePath"],"additionalProperties":false},"run_in_background":{"description":"Run in the background and return a task id immediately (collect with TaskOutput, stop with TaskStop).","type":"boolean"},"dangerouslyDisableSandbox":{"description":"Run the command outside the sandbox (use only when sandbox restrictions caused the failure).","type":"boolean"}},"required":["command"],"additionalProperties":false}}},{"type":"function","function":{"name":"Config","description":"Config","parameters":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"setting":{"type":"string","description":"The setting key (e.g., \"theme\", \"model\", \"permissions.defaultMode\")"},"value":{"description":"The new value. Omit to get current value.","type":["string","boolean","number"]}},"required":["setting"],"additionalProperties":false}}},{"type":"function","function":{"name":"Edit","description":"Edit","parameters":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"file_path":{"type":"string","description":"The absolute path to the file to modify"},"old_string":{"type":"string","description":"The text to replace"},"new_string":{"type":"string","description":"The text to replace it with (must be different from old_string)"},"replace_all":{"description":"Replace all occurrences of old_string (default false)","default":false,"type":"boolean"}},"required":["file_path","old_string","new_string"],"additionalProperties":false}}},{"type":"function","function":{"name":"EnterPlanMode","description":"EnterPlanMode","parameters":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{},"additionalProperties":false}}},{"type":"function","function":{"name":"EnterWorktree","description":"EnterWorktree","parameters":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"name":{"description":"Optional name for the worktree. Each \"/\"-separated segment may contain only letters, digits, dots, underscores, and dashes; max 64 chars total. A random name is generated if not provided.","type":"string"}},"additionalProperties":false}}},{"type":"function","function":{"name":"ExitPlanMode","description":"ExitPlanMode","parameters":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"allowedPrompts":{"description":"Prompt-based permissions needed to implement the plan. These describe categories of actions rather than specific commands.","type":"array","items":{"type":"object","properties":{"tool":{"type":"string","enum":["Bash"],"description":"The tool this prompt applies to"},"prompt":{"type":"string","description":"Semantic description of the action, e.g. \"run tests\", \"install dependencies\""}},"required":["tool","prompt"],"additionalProperties":false}}},"additionalProperties":{}}}},{"type":"function","function":{"name":"ExitWorktree","description":"ExitWorktree","parameters":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"action":{"type":"string","enum":["keep","remove"],"description":"\"keep\" leaves the worktree and branch on disk; \"remove\" deletes both."},"discard_changes":{"description":"Required true when action is \"remove\" and the worktree has uncommitted files or unmerged commits. The tool will refuse and list them otherwise.","type":"boolean"}},"required":["action"],"additionalProperties":false}}},{"type":"function","function":{"name":"Glob","description":"Glob","parameters":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"pattern":{"type":"string","description":"The glob pattern to match files against"},"path":{"description":"The directory to search in. If not specified, the current working directory will be used. IMPORTANT: Omit this field to use the default directory. DO NOT enter \"undefined\" or \"null\" - simply omit it for the default behavior. Must be a valid directory path if provided.","type":"string"}},"required":["pattern"],"additionalProperties":false}}},{"type":"function","function":{"name":"Grep","description":"Grep","parameters":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"pattern":{"type":"string","description":"The regular expression pattern to search for in file contents"},"path":{"description":"File or directory to search in (rg PATH). Defaults to current working directory.","type":"string"},"glob":{"description":"Glob pattern to filter files (e.g. \"*.js\", \"*.{ts,tsx}\") - maps to rg --glob","type":"string"},"output_mode":{"description":"Output mode: \"content\" shows matching lines (supports -A/-B/-C context, -n line numbers, head_limit), \"files_with_matches\" shows file paths (supports head_limit), \"count\" shows match counts (supports head_limit). Defaults to \"files_with_matches\".","type":"string","enum":["content","files_with_matches","count"]},"-B":{"description":"Number of lines to show before each match (rg -B). Requires output_mode: \"content\", ignored otherwise.","type":"number"},"-A":{"description":"Number of lines to show after each match (rg -A). Requires output_mode: \"content\", ignored otherwise.","type":"number"},"-C":{"description":"Alias for context.","type":"number"},"context":{"description":"Number of lines to show before and after each match (rg -C). Requires output_mode: \"content\", ignored otherwise.","type":"number"},"-n":{"description":"Show line numbers in output (rg -n). Requires output_mode: \"content\", ignored otherwise. Defaults to true.","type":"boolean"},"-i":{"description":"Case insensitive search (rg -i)","type":"boolean"},"type":{"description":"File type to search (rg --type). Common types: js, py, rust, go, java, etc. More efficient than include for standard file types.","type":"string"},"head_limit":{"description":"Limit output to first N lines/entries, equivalent to \"| head -N\". Works across all output modes: content (limits output lines), files_with_matches (limits file paths), count (limits count entries). Defaults to 250 when unspecified. Pass 0 for unlimited (use sparingly — large result sets waste context).","type":"number"},"offset":{"description":"Skip first N lines/entries before applying head_limit, equivalent to \"| tail -n +N | head -N\". Works across all output modes. Defaults to 0.","type":"number"},"multiline":{"description":"Enable multiline mode where . matches newlines and patterns can span lines (rg -U --multiline-dotall). Default: false.","type":"boolean"}},"required":["pattern"],"additionalProperties":false}}},{"type":"function","function":{"name":"ListMcpResourcesTool","description":"ListMcpResourcesTool","parameters":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"server":{"description":"Optional server name to filter resources by","type":"string"}},"additionalProperties":false}}},{"type":"function","function":{"name":"NotebookEdit","description":"NotebookEdit","parameters":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"notebook_path":{"type":"string","description":"The absolute path to the Jupyter notebook file to edit (must be absolute, not relative)"},"cell_id":{"description":"The ID of the cell to edit. When inserting a new cell, the new cell will be inserted after the cell with this ID, or at the beginning if not specified.","type":"string"},"new_source":{"type":"string","description":"The new source for the cell"},"cell_type":{"description":"The type of the cell (code or markdown). If not specified, it defaults to the current cell type. If using edit_mode=insert, this is required.","type":"string","enum":["code","markdown"]},"edit_mode":{"description":"The type of edit to make (replace, insert, delete). Defaults to replace.","type":"string","enum":["replace","insert","delete"]}},"required":["notebook_path","new_source"],"additionalProperties":false}}},{"type":"function","function":{"name":"Read","description":"Read","parameters":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"file_path":{"type":"string","description":"The absolute path to the file to read"},"offset":{"description":"The line number to start reading from. Only provide if the file is too large to read at once","type":"integer","minimum":0,"maximum":9007199254740991},"limit":{"description":"The number of lines to read. Only provide if the file is too large to read at once.","type":"integer","exclusiveMinimum":0,"maximum":9007199254740991},"pages":{"description":"Page range for PDF files (e.g., \"1-5\", \"3\", \"10-20\"). Only applicable to PDF files. Maximum 20 pages per request.","type":"string"},"allow_large":{"description":"Set to true only when you explicitly need the entire plain text file in one read and still have context space for it. This lifts the size and output-token limits for that full plain text read; providing offset and limit still selects the range, and the normal limits then apply to it. It does not affect images, PDFs, or notebooks.","type":"boolean"}},"required":["file_path"],"additionalProperties":false}}},{"type":"function","function":{"name":"ReadMcpResourceTool","description":"ReadMcpResourceTool","parameters":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"server":{"type":"string","description":"The MCP server name"},"uri":{"type":"string","description":"The resource URI to read"}},"required":["server","uri"],"additionalProperties":false}}},{"type":"function","function":{"name":"Skill","description":"Skill","parameters":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"skill":{"type":"string","description":"The skill name. E.g., \"commit\", \"review-pr\", or \"pdf\""},"args":{"description":"Optional arguments for the skill","type":"string"}},"required":["skill"],"additionalProperties":false}}},{"type":"function","function":{"name":"TaskCreate","description":"TaskCreate","parameters":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"subject":{"type":"string","description":"A brief title for the task"},"description":{"type":"string","description":"What needs to be done"},"activeForm":{"description":"Present continuous form shown in spinner when in_progress (e.g., \"Running tests\")","type":"string"},"metadata":{"description":"Arbitrary metadata to attach to the task","type":"object","propertyNames":{"type":"string"},"additionalProperties":{}}},"required":["subject","description"],"additionalProperties":false}}},{"type":"function","function":{"name":"TaskGet","description":"TaskGet","parameters":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"taskId":{"type":"string","descrip