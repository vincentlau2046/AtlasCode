}],"default":null,"title":"Operator Type"},"limit":{"default":100,"title":"Limit","type":"integer"}},"required":["csv_path"],"title":"get_operator_detailsArguments"}}},{"type":"function","function":{"name":"mcp__msprof-mcp__get_profiler_config","description":"mcp__msprof-mcp__get_profiler_config","parameters":{"type":"object","properties":{"json_path":{"title":"Json Path","type":"string"}},"required":["json_path"],"title":"get_profiler_configArguments"}}},{"type":"function","function":{"name":"mcp__msprof-mcp__search_csv_by_field","description":"mcp__msprof-mcp__search_csv_by_field","parameters":{"type":"object","properties":{"csv_path":{"title":"Csv Path","type":"string"},"field_name":{"title":"Field Name","type":"string"},"field_value":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Field Value"},"match_mode":{"default":"exact","title":"Match Mode","type":"string"},"limit":{"default":100,"title":"Limit","type":"integer"}},"required":["csv_path","field_name"],"title":"search_csv_by_fieldArguments"}}}],"max_tokens":32000,"reasoning_effort":"medium","stream":true,"stream_options":{"include_usage":true}}