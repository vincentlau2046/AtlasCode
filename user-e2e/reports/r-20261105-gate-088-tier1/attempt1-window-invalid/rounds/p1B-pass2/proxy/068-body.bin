ernelGemm {\n18\tpublic:\n19\t    __aicore__ inline KernelGemm() {}\n20\t\n21\t    // 初始化：全局内存映射 + 缓冲队列\n22\t    __aicore__ inline void Init(GM_ADDR x, GM_ADDR z, uint32_t totalLength)\n23\t    {\n24\t        this->blockLength = totalLength / AscendC::GetBlockNum();\n25\t        if (this->blockLength == 0) return;\n26\t        // 核内流水优化：单 tile 尽量大且 512B 对齐（half: 256 元素），减少 MTE2 搬运次数\n27\t        // tileNum 由 blockLength 动态推导，不再硬编码\n28\t        constexpr uint32_t ALIGN_ELEMS = 256;  // 256 * 2B = 512B 对齐\n29\t        this->tileLength = ((this->blockLength / BUFFER_NUM + ALIGN_ELEMS - 1) / ALIGN_ELEMS) * ALIGN_ELEMS;\n30\t        this->tileNum = (this->blockLength + this->tileLength - 1) / this->tileLength;\n31\t        this->xGm.SetGlobalBuffer((__gm__ half *)x + this->blockLength * AscendC::GetBlockIdx(),\n32\t                                  this->blockLength);\n33\t        this->zGm.SetGlobalBuffer((__gm__ half *)z + this->blockLength * AscendC::GetBlockIdx(),\n34\t                                  this->blockLength);\n35\t        this->pipe.InitBuffer(this->inQueueX, BUFFER_NUM, this->tileLength * sizeof(half));\n36\t        this->pipe.InitBuffer(this->outQueueZ, BUFFER_NUM, this->tileLength * sizeof(half));\n37\t    }\n38\t\n39\t    __aicore__ inline void Process()\n40\t    {\n41\t        // 不再覆盖 Init 中推导出的 tileNum（原代码硬编码回写，使 Init 的 tiling 失效）\n42\t        for (int32_t i = 0; i < this->tileNum; i++) {\n43\t            int32_t n = (i == this->tileNum - 1) ? (this->blockLength - i * this->tileLength)\n44\t                                                 : this->tileLength;\n45\t            this->CopyIn(i, n);\n46\t            this->Compute(i, n);\n47\t            this->CopyOut(i, n);\n48\t        }\n49\t    }\n50\t\n51\tprivate:\n52\t    __aicore__ inline void CopyIn(int32_t progress, int32_t n)\n53\t    {\n54\t        AscendC::LocalTensor<half> xLocal = this->inQueueX.AllocTensor<half>();\n55\t        AscendC::DataCopy(xLocal, this->xGm[progress * this->tileLength], n);\n56\t        this->inQueueX.EnQue(xLocal);\n57\t    }\n58\t\n59\t    __aicore__ inline void Compute(int32_t progress, int32_t n)\n60\t    {\n61\t        AscendC::LocalTensor<half> xLocal = this->inQueueX.DeQue<half>();\n62\t        AscendC::LocalTensor<half> zLocal = this->outQueueZ.AllocTensor<half>();\n63\t        // PLACEHOLDER — op-specific compute (see gelu_custom.asc: Mul→Erf→Mul→Add→Mul)\n64\t        AscendC::DataCopy(zLocal, xLocal, n);\n65\t        this->outQueueZ.EnQue<half>(zLocal);\n66\t        this->inQueueX.FreeTensor(xLocal);\n67\t    }\n68\t\n69\t    __aicore__ inline void CopyOut(int32_t progress, int32_t n)\n70\t    {\n71\t        AscendC::LocalTensor<half> zLocal = this->outQueueZ.DeQue<half>();\n72\t        AscendC::DataCopy(this->zGm[progress * this->tileLength], zLocal, n);\n73\t        this->outQueueZ.FreeTensor(zLocal);\n74\t    }\n75\t\n76\tprivate:\n77\t    AscendC::TPipe pipe;\n78\t    AscendC::TQue<AscendC::TPosition::VECIN, BUFFER_NUM> inQueueX;\n79\t    AscendC::TQue<AscendC::TPosition::VECOUT, BUFFER_NUM> outQueueZ;\n80\t    AscendC::GlobalTensor<half> xGm;\n81\t    AscendC::GlobalTensor<half> zGm;\n82\t    uint32_t blockLength = 0;\n83\t    uint32_t tileNum = 0;\n84\t    uint32_t tileLength = 0;\n85\t};\n86\t\n87\t// ------------------------------ host launcher (方式3) ------------------------------\n88\t// 方式3（推荐）: stream(false) + OpCommand::RunOpApiV2\n89\tnamespace ascendc_ops {\n90\tat::Tensor Gemm_custom(const at::Tensor &x)\n91\t{\n92\t    auto z = at::empty_like(x);\n93\t    uint32_t totalLength = 1;\n94\t    for (auto i = 0; i < x.dim(); i++) { totalLength *= x.size(i); }\n95\t    auto acl_stream = c10_npu::getCurrentNPUStream().stream(false);\n96\t    uint32_t blockDim = 128;\n97\t    Gemm_custom<<<blockDim, nullptr, acl_stream>>>(\n98\t        reinterpret_cast<__gm__ uint8_t *>(x.storage().data_ptr().get()),\n99\t        reinterpret_cast<__gm__ uint8_t *>(z.storage().data_ptr().get()),\n100\t        totalLength);\n101\t    at_npu::native::OpCommand::RunOpApiV2(\"ascendc_Gemm\", [&]() {});\n102\t    return z;\n103\t}\n104\t}  // namespace ascendc_ops\n105\t\n106\t// ------------------------------ kernel entry ------------------------------\n107\textern \"C\" __global__ __vector__ void Gemm_custom(GM_ADDR x, GM_ADDR z, uint32_t totalLength)\n108\t{\n109\t    KernelGemm op;\n110\t    op.Init(x, z, totalLength);\n111\t    op.Process();\n112\t}\n113\t\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"},{"role":"assistant","content":"Kernel changes are in. Now the verification loop per `perf-tiling-recorrection.md`: recompile → golden test → benchmark.","tool_calls":[{"id":"chatcmpl-tool-b3ed1e5468a1c99a","type":"function","function":{"name":"AscendSkillSourceCheck","arguments":"{\"action\":\"check\",\"source\":\"agent-skills\"}"}}]},{"role":"tool","tool_call_id":"chatcmpl-tool-b3ed1e5468a1c99a","content":"verdict: fresh\nlocal: c65528210970\nupstream: c65528210970"},{"role":"assistant","content":null,"tool_calls":[{"id":"chatcmpl-tool-b599cbb114aacc69","type":"function","function":{"name":"Bash","arguments":"{\"command\":\"cd /home/vince/work/gemm_ascendc && python3 setup.py build_ext 2>&1 | tail -20\",\"description\":\"Recompile the Ascend C operator via bisheng (setup.py build_ext)\",\"timeout\":600000}"}}]},{"role":"tool","tool_call_id":"chatcmpl-tool-b599cbb114aacc69","content":"[exit code: 0]\nTraceback (most recent call last):\n  File \"/home/vince/work/gemm_ascendc/setup.py\", line 9, in <module>\n    import torch\nModuleNotFoundError: No module named 'torch'\n"}],"tools":[{"type":"function","function":{"name":"Agent","description":"Agent","parameters":{"$schema":"https://json-schema.org