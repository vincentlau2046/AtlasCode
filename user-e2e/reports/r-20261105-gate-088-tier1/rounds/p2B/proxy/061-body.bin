"import torch, triton; print('torch', torch.__version__, '| triton', triton.__version__)\\\" 2>&1 | tail -1; ~/miniconda3/bin/python -c \\\"import torch_npu; print('torch_npu ok')\\\" 2>&1 | tail -1\",\"description\":\"Check miniconda envs for torch/triton/torch_npu\"}"}}]},{"role":"tool","tool_call_id":"chatcmpl-tool-81f3ea665804e1b5","content":"[exit code: 0]\n\n# conda environments:\n#\n# * -> active\n# + -> frozen\nbase                 *   /home/vince/miniconda3\nQwen3.8-27B-VL           /home/vince/miniconda3/envs/Qwen3.8-27B-VL\ncomfyui                  /home/vince/miniconda3/envs/comfyui\ngemma-4-31b              /home/vince/miniconda3/envs/gemma-4-31b\nisaaclab                 /home/vince/miniconda3/envs/isaaclab\nmuse-glimmer             /home/vince/miniconda3/envs/muse-glimmer\nqwen3-tts                /home/vince/miniconda3/envs/qwen3-tts\nqwen3-vl-4b-vllm         /home/vince/miniconda3/envs/qwen3-vl-4b-vllm\nqwen36-27b-vllm-vl       /home/vince/miniconda3/envs/qwen36-27b-vllm-vl\nqwen36-35b-vl            /home/vince/miniconda3/envs/qwen36-35b-vl\nqwen36-35b-vllm          /home/vince/miniconda3/envs/qwen36-35b-vllm\nsensevoice               /home/vince/miniconda3/envs/sensevoice\nxlerobot                 /home/vince/miniconda3/envs/xlerobot\n\n---\nbash: 行 1: /home/vince/.claude/jobs/09264df0/tmp/gate-088/tier1/p2B/home/miniconda3/bin/python: 没有那个文件或目录\nbash: 行 1: /home/vince/.claude/jobs/09264df0/tmp/gate-088/tier1/p2B/home/miniconda3/bin/python: 没有那个文件或目录\n"},{"role":"assistant","content":null,"tool_calls":[{"id":"chatcmpl-tool-b702ea30f0320bc5","type":"function","function":{"name":"Bash","arguments":"{\"command\":\"for env in base qwen36-35b-vllm Qwen3.8-27B-VL; do p=/home/vince/miniconda3/envs/$env/bin/python; [ \\\"$env\\\" = base ] && p=/home/vince/miniconda3/bin/python; echo \\\"== $env\\\"; $p -c \\\"import torch;print('torch',torch.__version__)\\\" 2>&1|tail -1; $p -c \\\"import torch_npu\\\" 2>&1|tail -1; $p -c \\\"import triton;print('triton',triton.__version__)\\\" 2>&1|tail -1; done\",\"description\":\"Probe conda envs for torch, torch_npu, triton\"}"}}]},{"role":"tool","tool_call_id":"chatcmpl-tool-b702ea30f0320bc5","content":"[exit code: 0]\n== base\nModuleNotFoundError: No module named 'torch'\nModuleNotFoundError: No module named 'torch_npu'\nModuleNotFoundError: No module named 'triton'\n== qwen36-35b-vllm\ntorch 2.11.0+cu130\nModuleNotFoundError: No module named 'torch_npu'\ntriton 3.6.0\n== Qwen3.8-27B-VL\ntorch 2.11.0+cu130\nModuleNotFoundError: No module named 'torch_npu'\ntriton 3.6.0\n"},{"role":"assistant","content":null,"tool_calls":[{"id":"chatcmpl-tool-b1ff90339e6c1bd4","type":"function","function":{"name":"Bash","arguments":"{\"command\":\"python3 -c \\\"import datetime,random; ts=datetime.datetime.now().strftime('%Y%m%d_%H%M'); rid=random.randint(1000,9999); print(f'{ts}_{rid}')\\\"\",\"description\":\"Get timestamp and random id for work dir\"}"}},{"id":"chatcmpl-tool-b281409bdcceb9b5","type":"function","function":{"name":"Read","arguments":"{\"file_path\":\"/home/vince/.local/share/ascend-agent-skills/official/CANNBot/ops/triton-op-coding/references/triton-ascend-reduce.md\"}"}}]},{"role":"tool","tool_call_id":"chatcmpl-tool-b1ff90339e6c1bd4","content":"[exit code: 0]\n20261105_1402_9069\n"},{"role":"tool","tool_call_id":"chatcmpl-tool-b281409bdcceb9b5","content":"1\t# Reduce 算子优化\n2\t\n3\t> 适用于需要聚合多个值的归约操作\n4\t\n5\t## 适用算子\n6\t\n7\t**基础归约**: sum, mean, max, min, prod\n8\t**归一化**: softmax, logsoftmax, layernorm, batchnorm\n9\t**统计**: variance, std\n10\t\n11\t## 通用归约策略\n12\t\n13\t### 1. 块内归约 + 原子操作\n14\t\n15\t```python\n16\t@triton.jit\n17\tdef reduction_kernel(input_ptr, output_ptr, n_elements, BLOCK_SIZE: tl.constexpr):\n18\t    pid = tl.program_id(0)\n19\t    offsets = pid * BLOCK_SIZE + tl.arange(0, BLOCK_SIZE)\n20\t    mask = offsets < n_elements\n21\t    \n22\t    # 加载数据\n23\t    data = tl.load(input_ptr + offsets, mask=mask, other=0.0)\n24\t    \n25\t    # 块内归约\n26\t    block_sum = tl.sum(data, axis=0)\n27\t    \n28\t    # 原子操作写回全局内存\n29\t    tl.atomic_add(output_ptr, block_sum)\n30\t```\n31\t\n32\t### 2. 减少规约精度损失\n33\t\n34\t**关键**: 如果需要在 FP16 或 BF16 的数据上执行计算性规约（除了max, min的规约计算），应在规约计算前将其强制转换为 FP32，以避免低精度累加带来的数值误差。\n35\t\n36\t```python\n37\t# 错误：直接用 fp16/bf16 累加，精度损失大\n38\tdata = tl.load(input_ptr + offsets, mask=mask, other=0.0)  # data 为 fp16/bf16\n39\tblock_sum = tl.sum(data, axis=0)  # 低精度累加\n40\tcarry = carry + block_sum  # 低精度累加\n41\t\n42\t# 正确：在执行累加计算前转为 fp32，在 fp32 上完成规约\n43\tdata = tl.load(input_ptr + offsets, mask=mask, other=0.0)\n44\tdata = data.to(tl.float32)        # 强制提升为 fp32\n45\tblock_sum = tl.sum(data, axis=0)  # 高精度累加\n46\tcarry = carry + block_sum  # 高精度累加\n47\t\n48\t# 如果输出要求 fp16/bf16，在最终 store 前转回\n49\ttl.store(output_ptr, block_sum.to(input_ptr.dtype.element_ty))\n50\t```\n51\t\n52\t**原则**：\n53\t- 在执行规约操作前 `.to(tl.float32)`\n54\t- 如果涉及多次规约，累积多次规约结果的累加器对象精度应为`tl.float32`\n55\t- 涉及计算的规约操作（除了max, min的规约操作）均在 FP32 上执行\n56\t- 在最后 `tl.store` 前按需转回原始数据类型\n57\t\n58\t### 3. 数值稳定性处理\n59\t\n60\t**关键**: 对于涉及 exp 的操作（softmax、logsoftmax），必须减去最大值防止溢出。\n61\t\n62\t```python\n63\t# 错误：错误：直接 exp 可能溢出\n64\tscores = tl.math.exp2(x)\n65\t\n66\t# 正确：正确：减去最大值\n67\tmax_val = tl.max(x, axis=0)\n68\tscores = tl.math.exp2(x - max_val)\n69\t```\n70\t\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"},{"role":"assistant","content":null,"tool_calls":[{"id":"chatcmpl-tool-b660dfe33dd47d1c","type":"function","function":{"name":"Read","arguments":"{\"file_path\":\"/home/vince/.local/share/ascend-agent-skills/official/CANNBot/ops/triton-op-coding/references/triton-ascend-fundamentals.md\"}"}}]},{"role":"tool","tool_call_id":"chatcmpl-tool-b660dfe33dd47d1c","content":"1\t# Triton Ascend 基础知识参考手册\n2\t\n3\t本文档汇集 Triton Ascend 编程的基础知识，包括 API 参考、编程模式、优化策略和调试技巧。\n4\t\n5\t---\n6\t\n7\t## 1. 编程基础\n8\t\n9\t### 1.1 核心概念\n10\t\n11\tTriton Ascend 采用与 Triton GPU 类似的执行模型：\n12\t\n13\t- **Kernel（内核）**：用 `@triton.jit` 装饰的函数，在 NPU 上并行执行\n14\t- **Grid（网格）**：启动的并行程序总数，由 `kernel[grid](args)` 指定\n15\t- **Block（块）**：每个程序处理的数据块，由 `tl.program_id(0)` 区分\n16\t\n17\t#### 内存层次\n18\t- **全局内存**: 主内存，所有程序可访问，延迟高\n19\t- **共享内存**: 块内共享，延迟低，容量有限\n20\t- **寄存器**: 每个线程私有，最快访问\n21\t\n22\t### 1.2 标准 Kernel 结构（五步模式）\n23\t\n24\t```python\n25\t@triton.jit\n26\tdef triton_better_kernel(in_ptr0, out_ptr0, xnumel, XBLOCK: tl.constexpr, XBLOCK_SUB: tl.constexpr):\n27\t    # Step 1: 计算当前核的起始偏移（核间切分）\n28\t    xoffset = tl.program_id(0) * XBLOCK\n29\t\n30\t    # Step 2: 核内循环（核内切分）\n31\t    for xoffset_sub in range(0, XBLOCK, XBLOCK_SUB):\n32\t        # Step 3: 构造数据索引\n33\t        x_index = xoffset + xoffset_sub + tl.arange(0, XBLOCK_SUB)[:]\n34\t\n35\t        # Step 4: 边界处理（mask）\n36\t        xmask = x_index < xnumel\n37\t\n38\t        # Step 5: 加载 → 计算 → 存储\n39\t        x = tl.load(in_ptr0 + x_index, xmask)\n40\t        ret = x * 0.5 * (1.0 + tl.erf(x / tl.sqrt(2.0)))\n41\t        tl.store(out_ptr0 + x_index, ret, xmask)\n42\t```\n43\t\n44\t### 1.3 内核启动方式\n45\t```python\n46\tdef launch_kernel(input_tensor, output_tensor):\n47\t    BLOCK_SIZE = 1024  \n48\t    grid = (triton.cdiv(input_tensor.numel(), BLOCK_SIZE),)\n49\t    \n50\t    kernel[grid](\n51\t        output_tensor, input_tensor, input_tensor.numel(),\n52\t        BLOCK_SIZE=BLOCK_SIZE,\n53\t    )\n54\t```\n55\t\n56\t### 1.4 边界处理（Mask）\n57\t\n58\t使用 mask 防止越界访问，确保只处理合法范围内的数据：\n59\t\n60\t```python\n61\txmask = x_index < xnumel\n62\tx = tl.load(in_ptr0 + x_index, mask=xmask, other=0.0)\n63\ttl.store(out_ptr0 + x_index, ret, mask=xmask)\n64\t```\n65\t\n66\t### 1.5 编程模式\n67\t\n68\t#### 1.5.1 向量操作模式\n69\t适用于元素级运算：加法、乘法、激活函数等。\n70\t\n71\t```python\n72\t@triton.jit\n73\tdef vector_add_kernel(a_ptr, b_ptr, c_ptr, n_elements, BLOCK_SIZE: tl.constexpr):\n74\t    pid = tl.program_id(0)\n75\t    offsets = pid * BLOCK_SIZE + tl.arange(0, BLOCK_SIZE)\n76\t    mask = offsets < n_elements\n77\t    \n78\t    a = tl.load(a_ptr + offsets, mask=mask)\n79\t    b = tl.load(b_ptr + offsets, mask=mask)\n80\t    c = a + b\n81\t    \n82\t    tl.store(c_ptr + offsets, c, mask=mask)\n83\t```\n84\t\n85\t#### 1.5.2 归约模式\n86\t适用于求和、最大值、最小值等聚合操作。\n87\t\n88\t```python\n89\t@triton.jit\n90\tdef reduction_kernel(input_ptr, output_ptr, n_elements, BLOCK_SIZE: tl.constexpr):\n91\t    pid = tl.program_id(0)\n92\t    offsets = pid * BLOCK_SIZE + tl.arange(0, BLOCK_SIZE)\n93\t    mask = offsets < n_elements\n94\t    \n95\t    # 加载数据\n96\t    data = tl.load(input_ptr + offsets, mask=mask, other=0.0)\n97\t    \n98\t    # 块内归约\n99\t    block_sum = tl.sum(data, axis=0)\n100\t    \n101\t    # 原子操作写回全局内存\n102\t    if pid == 0:  # 只有第一个块写入结果\n103\t        tl.atomic_add(output_ptr, block_sum)\n104\t```\n105\t\n106\t#### 1.5.3 矩阵乘法模式\n107\t使用块指针高效处理 2D 数据。\n108\t\n109\t```python\n110\t@triton.jit\n111\tdef matmul_kernel(a_ptr, b_ptr, c_ptr, M, N, K, stride_am, stride_ak, stride_bk, stride_bn, stride_cm, stride_cn, BLOCK_SIZE_M: tl.constexpr, BLOCK_SIZE_N: tl.constexpr, BLOCK_SIZE_K: tl.constexpr):\n112\t    # 获取程序 ID\n113\t    pid_m = tl.program_id(0)\n114\t    pid_n = tl.program_id(1)\n115\t    \n116\t    # 初始化累加器\n117\t    accumulator = tl.zeros((BLOCK_SIZE_M, BLOCK_SIZE_N), dtype=tl.float32)\n118\t    \n119\t    # 主循环：沿 K 轴迭代\n120\t    for k in range(0, K, BLOCK_SIZE_K):\n121\t        # 创建块指针\n122\t        a_block_ptr = tl.make_block_ptr(\n123\t            base=a_ptr, shape=(M, K), strides=(stride_am, stride_ak),\n124\t            offsets=(pid_m * BLOCK_SIZE_M, k), \n125\t            block_shape=(BLOCK_SIZE_M, BLOCK_SIZE_K), order=(1, 0)\n126\t        )\n127\t        b_block_ptr = tl.make_block_ptr(\n128\t            base=b_ptr, shape=(K, N), strides=(stride_bk, stride_bn),\n129\t            offsets=(k, pid_n * BLOCK_SIZE_N), \n130\t            block_shape=(BLOCK_SIZE_K, BLOCK_SIZE_N), order=(1, 0)\n131\t        )\n132\t        \n133\t        # 加载数据块\n134\t        a = tl.load(a_block_ptr, boundary_check=(0, 1))\n135\t        b = tl.load(b_block_ptr, boundary_check=(0, 1))\n136\t        \n137\t        # 矩阵乘加\n138\t        accumulator += tl.dot(a, b)\n139\t    \n140\t    # 存储结果\n141\t    c_block_ptr = tl.make_block_ptr(\n142\t        base=c_ptr, shape=(M, N), strides=(stride_cm, stride_cn),\n143\t        offsets=(pid_m * BLOCK_SIZE_M, pid_n * BLOCK_SIZE_N),\n144\t        block_shape=(BLOCK_SIZE_M, BLOCK_SIZE_N), order=(1, 0)\n145\t    )\n146\t    tl.store(c_block_ptr, accumulator, boundary_check=(0, 1))\n147\t```\n148\t\n149\t### 1.6 Autotune 使用\n150\t\n151\tTriton 支持 `autotune` 自动调优，但 **Ascend NPU 不支持 `num_warps`、`num_ctas`、`num_stages` 等 CUDA 专用调优参数**。在 Ascend 上主要调优：\n152\t\n153\t- `BLOCK_SIZE` / `XBLOCK` / `XBLOCK_SUB` 等分块参数\n154\t- `grid` 维度（核数）\n155\t\n156\t```python\n157\t@triton.autotune(\n158\t     configs=[\n159\t        triton.Config({'BLOCK_SIZE_M': 128, 'BLOCK_SIZE_N': 128, 'BLOCK_SIZE_K': 128}),\n160\t        triton.Config({'BLOCK_SIZE_M': 64, 'BLOCK_SIZE_N': 64, 'BLOCK_SIZE_K': 64}),\n161\t    ],\n162\t    key=['M', 'N', 'K'],  # 当这些参数变化时触发重新autotune\n163\t)\n164\t@triton.jit\n165\tddef matmul_kernel(\n166\t    a_ptr, b_ptr, c_ptr,\n167\t    M, N, K,\n168\t    stride_am, stride_ak, stride_bk, stride_bn, stride_cm, stride_cn,\n169\t    BLOCK_SIZE_M: tl.constexpr, # configs中的参数必须声明为constexpr\n170\t    BLOCK_SIZE_N: tl.constexpr, # configs中的参数必须声明为constexpr\n171\t    BLOCK_SIZE_K: tl.constexpr, # configs中的参数必须声明为constexpr\n172\t):\n173\t    # kernel实现\n174\t    pass\n175\t\n176\tclass ModelNew(torch.nn.Module):\n177\t    def __init__(self):\n178\t        super().__init__()\n179\t\n180\t    def forward(self, a, b):\n181\t    M, K = a.shape\n182\t    K, N = b.shape\n183\t    c = torch.empty((M, N), device=a.device, dtype=a.dtype)\n184\t    \n185\t    grid = lambda meta: (triton.cdiv(M, meta['BLOCK_SIZE_M']) * triton.cdiv(N, meta['BLOCK_SIZE_N']),) # grid设置是tuple\n186\t    \n187\t    # 关键：调用时不要传递configs中的参数（BLOCK_SIZE_M等）\n188\t    matmul_kernel[grid](\n189\t        a, b, c,\n190\t        M, N, K,\n191\t        a.stride(0), a.stride(1),\n192\t        b.stride(0), b.stride(1),\n193\t        c.stride(0), c.stride(1),\n194\t        # 不要写：BLOCK_SIZE_M=128  # 错误！autotune会自动传入\n195\t    )\n196\t    return c\n197\t```\n198\t---\n199\t\n200\t## 2. API 参考\n201\t\n202\t### 2.1 装饰器与启动\n203\t\n204\t| API | 说明 |\n205\t|-----|------|\n206\t| `@triton.jit` | 将 Python 函数编译为 Triton 内核 |\n207\t| `tl.program_id(axis)` | 当前程序在 grid 指定维度上的 ID |\n208\t| `tl.num_programs(axis)` | grid 在指定维度上的程序总数 |\n209\t| `triton.cdiv(x, y)` | 向上取整除法：`(x + y - 1) // y` |\n210\t\n211\t**@triton.jit 示例**：\n212\t```python\n213\t@triton.jit\n214\tdef kernel_function(...):\n215\t    pass\n216\t```\n217\t- **作用**: 将 Python 函数编译为硬件内核\n218\t- **约束**: 函数内部不能使用 `return`、`break`、`continue` 语句\n219\t\n220\t**tl.program_id(axis) 示例**：\n221\t```python\n222\tpid = tl.program_id(axis)  # axis: 0, 1, or 2\n223\t```\n224\t- **参数**: `axis` - 维度轴 (0, 1, 2)\n225\t- **返回**: 当前程序在该轴上的 ID\n226\t- **用途**: 确定当前程序块处理的数据范围\n227\t\n228\t**tl.num_programs(axis) 示例**：\n229\t```python\n230\tnum_pids = tl.num_programs(axis)  # axis: 0, 1, or 2\n231\t```\n232\t- **参数**: `axis` - 维度轴 (0, 1, 2)\n233\t- **返回**: 该轴上的总程序数\n234\t- **用途**: 计算网格大小和边界条件\n235\t\n236\t**triton.cdiv(a, b) 示例**：\n237\t```python\n238\tgrid_size = triton.cdiv(total_elements, block_size)\n239\t```\n240\t- **参数**: `a`, `b` - 被除数和除数\n241\t- **返回**: 向上取整的除法结果\n242\t- **用途**: host侧使用，计算启动网格大小\n243\t\n244\t### 2.2 内存访问\n245\t\n246\t| API | 说明 |\n247\t|-----|------|\n248\t| `tl.load(ptr, mask=None, other=0.0, boundary_check=None)` | 从全局内存加载数据 |\n249\t| `tl.store(ptr, value, mask=None, boundary_check=None)` | 将数据写入全局内存 |\n250\t| `tl.make_block_ptr(base, shape, strides, offsets, block_shape, order)` | 创建块指针，用于 2D/高维块访问 |\n251\t| `tl.advance(block_ptr, dim, delta)` | 沿指定维度推进块指针 |\n252\t\n253\t**tl.load 示例:**\n254\t```python\n255\tdata = tl.load(ptr + offsets, mask=mask, other=0.0)\n256\t```\n257\t- **参数**:\n258\t  - `pointer`: 内存指针\n259\t  - `mask`: 布尔掩码，True 表示有效位置\n260\t  - `other`: 掩码为 False 时的默认值\n261\t  - `boundary_check`: 边界检查维度 (0, 1) 或 None\n262\t- **返回**: 加载的张量数据\n263\t- **用途**: 从全局内存加载数据\n264\t\n265\t**tl.store 示例:**\n266\t```python\n267\ttl.store(ptr + offsets, result, mask=mask)\n268\t```\n269\t- **参数**:\n270\t  - `pointer`: 内存指针\n271\t  - `value`: 要存储的值\n272\t  - `mask`: 布尔掩码，True 表示有效位置\n273\t  - `boundary_check`: 边界检查维度 (0, 1) 或 None\n274\t- **用途**: 将数据存储到全局内存\n275\t\n276\t**tl.make_block_ptr 示例:**\n277\t```python\n278\tp_q = tl.make_block_ptr(\n279\t    base=q + (bos * HQ + i_hq) * K,\n280\t    shape=(T, K),\n281\t    strides=(HQ*K, 1),\n282\t    offsets=(i_t * BT, 0),\n283\t    block_shape=(BT, BK),\n284\t    order=(1, 0)\n285\t)\n286\tval = tl.load(p_q, boundary_check=(0, 1), padding=\"zero\")\n287\t```\n288\t- **参数**:\n289\t  - `base`: 基础内存指针\n290\t  - `shape`: 完整张量的形状\n291\t  - `strides`: 每个维度的步长\n292\t  - `offsets`: 当前块的起始偏移\n293\t  - `block_shape`: 当前块的大小\n294\t  - `order`: 内存布局顺序 (1, 0) 表示行主序\n295\t- **返回**: 块指针对象\n296\t- **用途**: 高效访问 2D 数据块\n297\t\n298\t**tl.advance 示例:**\n299\t```python\n300\tblock_ptr = tl.advance(block_ptr, (BLOCK_M, 0))\n301\t```\n302\t- **参数**:\n303\t  - `ptr`: 块指针\n304\t  - `offsets`: 各维度的偏移量\n305\t- **返回**: 移动后的块指针\n306\t- **用途**: 移动块指针到下一个位置\n307\t\n308\t### 2.3 张量构造与索引\n309\t\n310\t| API | 说明 |\n311\t|-----|------|\n312\t| `tl.arange(start, end)` | 创建一维索引张量 |\n313\t| `tl.zeros(shape, dtype)` | 创建全零张量 |\n314\t| `tl.full(shape, value, dtype)` | 创建填充指定值的张量 |\n315\t| `tl.cast(tensor, dtype)` | 类型转换 |\n316\t\n317\t**tl.arange 示例:**\n318\t```python\n319\toffsets = tl.arange(0, BLOCK_SIZE)\n320\t```\n321\t- **参数**: `start`, `end` - 起始和结束值\n322\t- **返回**: 连续整数序列\n323\t- **用途**: 创建索引序列\n324\t\n325\t**tl.zeros 示例:**\n326\t```python\n327\taccumulator = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)\n328\t```\n329\t- **参数**:\n330\t  - `shape`: 张量形状\n331\t  - `dtype`: 数据类型\n332\t- **返回**: 全零张量\n333\t\n334\t**tl.full 示例:**\n335\t```python\n336\tones = tl.full((M, N), 1.0, dtype=tl.float32)\n337\t```\n338\t- **参数**:\n339\t  - `shape`: 张量形状\n340\t  - `value`: 填充值\n341\t  - `dtype`: 数据类型\n342\t- **返回**: 填充指定值的张量\n343\t\n344\t**tl.cast 示例:**\n345\t```python\n346\tfloat_data = tl.cast(int_data, tl.float32)\n347\t```\n348\t- **参数**:\n349\t  - `input`: 输入张量\n350\t  - `dtype`: 目标数据类型\n351\t- **返回**: 类型转换后的张量\n352\t\n353\t### 2.4 数学与归约\n354\t\n355\t| API | 说明 |\n356\t|-----|------|\n357\t| `tl.cdiv(a, b)` | 向上取整除法 |\n358\t| `tl.dot(a, b)` | 矩阵乘法 / 点积 |\n359\t| `tl.sum(tensor, axis)` | 沿轴求和 |\n360\t| `tl.max(tensor, axis)` | 沿轴求最大值 |\n361\t| `tl.where(condition, x, y)` | 条件选择 |\n362\t\n363\t**tl.cdiv 示例:**\n364\t```python\n365\tresult = tl.cdiv(offset, BLOCK_SIZE)\n366\t```\n367\t- **参数**: `a`, `b` - 被除数和除数\n368\t- **返回**: 向上取整的除法结果 ⌈a/b⌉\n369\t- **用途**: kernel内部使用，计算向上整除结果，等价于 `(a + b - 1) // b`\n370\t\n371\t**tl.dot 示例:**\n372\t```python\n373\tresult = tl.dot(a, b, acc=accumulator)\n374\t```\n375\t- **参数**:\n376\t  - `a`, `b`: 输入矩阵\n377\t  - `acc`: 累加器 (可选)\n378\t  - `allow_tf32`: 是否允许 TF32 精度\n379\t- **返回**: 矩阵乘法结果\n380\t- **用途**: 核心矩阵乘法操作\n381\t\n382\t**tl.sum 示例:**\n383\t```python\n384\tblock_sum = tl.sum(data, axis=0)\n385\t```\n386\t- **参数**:\n387\t  - `tensor`: 输入张量\n388\t  - `axis`: 归约轴\n389\t- **返回**: 归约结果\n390\t\n391\t**tl.max 示例:**\n392\t```python\n393\tmax_val = tl.max(data, axis=0)\n394\t```\n395\t- **参数**:\n396\t  - `tensor`: 输入张量\n397\t  - `axis`: 归约轴\n398\t- **返回**: 最大值\n399\t\n400\t**tl.where 示例:**\n401\t```python\n402\tresult = tl.where(mask, data, 0.0)\n403\t```\n404\t- **参数**:\n405\t  - `condition`: 条件张量\n406\t  - `x`, `y`: 选择值\n407\t- **返回**: 根据条件选择的值\n408\t- **用途**: SIMD 友好的条件选择\n409\t\n410\t### 2.5 扫描与原子操作\n411\t\n412\t| API | 说明 |\n413\t|-----|------|\n414\t| `tl.cumsum(tensor, axis)` | 沿轴累积和 |\n415\t| `tl.cumprod(tensor, axis)` | 沿轴累积积 |\n416\t| `tl.atomic_add(ptr, value)` | 原子加 |\n417\t| `tl.atomic_max(ptr, value)` | 原子最大值 |\n418\t\n419\t**tl.cumsum 示例:**\n420\t```python\n421\tcumulative_sum = tl.cumsum(data, axis=0)\n422\treverse_cumsum = tl.cumsum(data, axis=1, reverse=True)\n423\t```\n424\t- **参数**:\n425\t  - `tensor`: 输入张量\n426\t  - `axis`: 累积求和的轴 (默认为 0)\n427\t  - `reverse`: 是否反向累积 (默认为 False)\n428\t- **返回**: 累积求和结果张量\n429\t- **用途**: 计算沿指定轴的累积和，常用于前缀和计算\n430\t\n431\t**tl.cumprod 示例:**\n432\t```python\n433\tcumulative_prod = tl.cumprod(data, axis=0)\n434\treverse_cumprod = tl.cumprod(data, axis=1, reverse=True)\n435\t```\n436\t- **参数**:\n437\t  - `tensor`: 输入张量\n438\t  - `axis`: 累积乘积的轴 (默认为 0)\n439\t  - `reverse`: 是否反向累积 (默认为 False)\n440\t- **返回**: 累积乘积结果张量\n441\t- **用途**: 计算沿指定轴的累积乘积，常用于概率计算和序列处理\n442\t\n443\t**tl.atomic_add 示例:**\n444\t```python\n445\ttl.atomic_add(output_ptr, block_sum)\n446\t```\n447\t- **参数**:\n448\t  - `ptr`: 目标内存指针\n449\t  - `value`: 要添加的值\n450\t- **用途**: 线程安全的加法操作\n451\t\n452\t**tl.atomic_max 示例:**\n453\t```python\n454\ttl.atomic_max(max_ptr, local_max)\n455\t```\n456\t- **参数**:\n457\t  - `ptr`: 目标内存指针\n458\t  - `value`: 要比较的值\n459\t- **用途**: 线程安全的最大值更新\n460\t\n461\t### 2.6 编译时常量\n462\t\n463\t| API | 说明 |\n464\t|-----|------|\n465\t| `tl.constexpr` | 标记参数为编译时常量，用于 kernel 参数 |\n466\t\n467\t```python\n468\tdef kernel(ptr, n_elements, BLOCK_SIZE: tl.constexpr):\n469\t    ...\n470\tBLOCK_SIZE: tl.constexpr = 1024\n471\t```\n472\t- **用途**: 标记编译时常量参数\n473\t- **约束**: 必须在函数签名中声明\n474\t\n475\t### 2.7 布局与分块\n476\t\n477\t| API | 说明 |\n478\t|-----|------|\n479\t| `tl.swizzle2d(i, j, size_i, size_j, size_g)` | 2D 分块时的 swizzle 布局优化 |\n480\t\n481\t**tl.swizzle2d 示例:**\n482\t```python\n483\ttask_i, task_j = tl.swizzle2d(block_i, block_j, NUM_BLOCKS_I, NUM_BLOCKS_J, GROUP_SIZE)\n484\t```\n485\t- **参数**:\n486\t  - `i`, `j`: 原始块索引\n487\t  - `size_i`, `size_j`: 总块数\n488\t  - `size_g`: 分组大小(通常为2/4/8)\n489\t- **返回**: 重排后的块索引 (task_i, task_j)\n490\t- **用途**: 2D块重排,提升缓存局部性\n491\t- **适用场景**: 矩阵乘法等多维块计算,改善数据复用\n492\t- **注意**: 仅支持行优先(i方向)分组,列优先需手动实现\n493\t---\n494\t\n495\t## 3. Grid 配置策略\n496\t\n497\t### 3.1 Grid 维度限制\n498\t\n499\t- **Grid 必须是 tuple 类型**，最多 3 维\n500\t- **支持的格式**：`(x,)`, `(x, y)`, `(x, y, z)`\n501\t- **Grid 各维度最大值**：65535\n502\t- **BLOCK_SIZE 限制**：单块元素数 < 65536\n503\t\n504\t### 3.2 大 Shape 处理\n505\t\n506\t#### 问题描述\n507\t对于输入 shape 较大的算子，直接按照 `BLOCK_SIZE` 切分得到的 grid 总数可能超过 65535。\n508\t\n509\t**示例**：\n510\t- 输入 shape: `(327680, 1024)`\n511\t- BLOCK_SIZE: 1024\n512\t- Grid 需求: `327680 / 1024 = 320` (每行一个 block)\n513\t- 如果有多行：`327680 > 65535` 错误：超限！\n514\t\n515\t---\n516\t\n517\t当 `grid = (triton.cdiv(n, BLOCK_SIZE),)` 超过 65535 时，需采用以下策略之一。\n518\t\n519\t#### 方法一：交错循环（Interleaved Loop）\n520\t\n521\t#### 适用场景\n522\t- 按行/按块独立处理的算子\n523\t- Element-wise、Reduce、Normalization 等\n524\t\n525\t#### 核心思想\n526\t- **固定 Grid 为核心数**\n527\t- **每个核心以步长方式交错处理数据**\n528\t- **负载均衡最好，代码最简洁**\n529\t\n530\t每个核心循环处理多个块：\n531\t\n532\t```python\n533\t@triton.jit\n534\tdef kernel(ptr, n_elements, num_cores: tl.constexpr, BLOCK_SIZE: tl.constexpr):\n535\t    pid = tl.program_id(0)\n536\t    num_blocks = triton.cdiv(n_elements, BLOCK_SIZE)\n537\t\n538\t    for block_idx in range(pid, num_blocks, num_cores):\n539\t        offsets = block_idx * BLOCK_SIZE + tl.arange(0, BLOCK_SIZE)\n540\t        mask = offsets < n_elements\n541\t        data = tl.load(ptr + offsets, mask=mask, other=0.0)\n542\t        # compute...\n543\t        tl.store(ptr + offsets, result, mask=mask)\n544\t```\n545\t\n546\t#### 方法二：连续分块法（Continuous Block Method）\n547\t\n548\t##### 适用场景\n549\t- 连续内存访问优化\n550\t\n551\t将一维 grid 映射为多维，或使用 `(grid_x, grid_y)` 形式：\n552\t\n553\t```python\n554\tMAX_GRID = 65535\n555\tgrid_x = min(triton.cdiv(n, BLOCK_SIZE), MAX_GRID)\n556\tgrid_y = triton.cdiv(triton.cdiv(n, BLOCK_SIZE), MAX_GRID)\n557\tgrid = (grid_x, grid_y)\n558\t\n559\t# kernel 内: pid = tl.program_id(0) * grid_y + tl.program_id(1)\n560\t# 示例：处理大shape的向量操作\n561\t@triton.jit\n562\tdef large_vector_kernel(\n563\t    input_ptr, output_ptr, n_elements,\n564\t    BLOCK_SIZE: tl.constexpr,\n565\t    ELEMENTS_PER_GRID: tl.constexpr,  # 每个grid负责的元素总数\n566\t):\n567\t    pid = tl.program_id(0)\n568\t    \n569\t    # 计算当前grid负责的数据范围\n570\t    grid_start = pid * ELEMENTS_PER_GRID\n571\t    grid_end = min(grid_start + ELEMENTS_PER_GRID, n_elements)\n572\t    \n573\t    # 分块处理当前grid负责的数据\n574\t    for block_start in range(grid_start, grid_end, BLOCK_SIZE):\n575\t        offsets = block_start + tl.arange(0, BLOCK_SIZE)\n576\t        mask = offsets < grid_end\n577\t        \n578\t        # 加载、计算、存储\n579\t        data = tl.load(input_ptr + offsets, mask=mask)\n580\t        result = compute_function(data)\n581\t        tl.store(output_ptr + offsets, result, mask=mask)\n582\t\n583\t# 启动方式\n584\tclass ModelNew(torch.nn.Module):\n585\t    def __init__(self):\n586\t        super().__init__()\n587\t        # 在__init__中获取核心数\n588\t        try:\n589\t            self.VEC_CORE_NUM = torch_npu.npu.npu_config.get_device_limit(0).get(\"vector_core_num\", 40)\n590\t        except:\n591\t            self.VEC_CORE_NUM = 40\n592\t\n593\t    def forward(self, input_tensor):\n594\t        n_elements = input_tensor.numel()\n595\t        BLOCK_SIZE = *  # 设置为尽可能大的合适的每次处理的值，充分利用ub\n596\t        MAX_GRID_SIZE = self.VEC_CORE_NUM  # 使用初始化时获取的核心数\n597\t        \n598\t        # 计算每个grid需要处理的元素数\n599\t        ELEMENTS_PER_GRID = triton.cdiv(n_elements, MAX_GRID_SIZE)\n600\t        # 向上取整到BLOCK_SIZE的倍数，确保循环能完整处理\n601\t        ELEMENTS_PER_GRID = triton.cdiv(ELEMENTS_PER_GRID, BLOCK_SIZE) * BLOCK_SIZE\n602\t        \n603\t        # 计算实际需要的grid数量\n604\t        grid_size = triton.cdiv(n_elements, ELEMENTS_PER_GRID)\n605\t        \n606\t        output_tensor = torch.empty_like(input_tensor)\n607\t        large_vector_kernel[grid_size,](\n608\t            input_tensor, output_tensor, n_elements,\n609\t            BLOCK_SIZE=BLOCK_SIZE,\n610\t            ELEMENTS_PER_GRID=ELEMENTS_PER_GRID,\n611\t        )\n612\t        return output_tensor\n613\t```\n614\t\n615\t### 3.3 动态核心数获取\n616\t\n617\t根据算子类型选择核心类型：\n618\t\n619\t| 算子类型 | 核心类型 | 获取方式 |\n620\t|----------|----------|----------|\n621\t| Element-wise、Reduce | **VEC_CORE_NUM**（向量核心） | `torch_npu.npu.npu_config.get_device_limit(0).get(\"vector_core_num\", 40)` |\n622\t| MatMul | **CUBE_CORE_NUM**（矩阵核心） | `torch_npu.npu.npu_config.get_device_limit(0).get(\"cube_core_num\", 20)` |\n623\t\n624\t**关键规则**：必须在 `__init__` 中获取核心数，**不能在 `forward` 中获取**，否则每次前向都会查询，影响性能。\n625\t\n626\t```python\n627\timport torch_npu\n628\t\n629\tclass ModelNew(torch.nn.Module):\n630\t    def __init__(self):\n631\t        super().__init__()\n632\t        try:\n633\t            self.VEC_CORE_NUM = torch_npu.npu.npu_config.get_device_limit(0).get(\"vector_core_num\", 40)\n634\t            self.CUBE_CORE_NUM = torch_npu.npu.npu_config.get_device_limit(0).get(\"cube_core_num\", 20)\n635\t        except Exception:\n636\t            self.VEC_CORE_NUM = 40\n637\t            self.CUBE_CORE_NUM = 20\n638\t\n639\t    def forward(self, x):\n640\t        grid = (self.VEC_CORE_NUM,)\n641\t        kernel[grid](...)\n642\t```\n643\t\n644\t#### 重要注意事项\n645\t\n646\t**禁止在 forward 中调用 `get_device_limit`**\n647\t\n648\t```python\n649\t# 错误：错误：每次 forward 都调用，触发设备同步\n650\tclass ModelNew(torch.nn.Module):\n651\t    def forward(self, input_tensor):\n652\t        core_num = torch_npu.npu.npu_config.get_device_limit(0).get(\"vector_core_num\", 48)\n653\t        grid = (core_num,)\n654\t        ...\n655\t\n656\t# 正确：正确：在 __init__ 中调用，只执行一次\n657\tclass ModelNew(torch.nn.Module):\n658\t    def __init__(self):\n659\t        super().__init__()\n660\t        self.VEC_CORE_NUM = torch_npu.npu.npu_config.get_device_limit(0).get(\"vector_core_num\", 48)\n661\t    \n662\t    def forward(self, input_tensor):\n663\t        grid = (self.VEC_CORE_NUM,)\n664\t        ...\n665\t```\n666\t\n667\t**原因**：`torch_npu` 的 import 和 `get_device_limit` 调用会触发设备同步，在 forward 中频繁调用会严重影响性能。\n668\t\n669\t---\n670\t\n671\t## 4. 内存访问优化\n672\t\n673\t### 4.1 Block Size 选择\n674\t\n675\t| 算子类型 | 推荐 BLOCK_SIZE | 说明 |\n676\t|----------|-----------------|------|\n677\t| Element-wise | 1024–2048 | 平衡并行度与资源占用 |\n678\t| Reduce | 256 / 128 | 归约需要更多寄存器 |\n679\t| MatMul | M=128, K=256, N=256（或 128/128/32） | 满足 512B 行宽对齐 |\n680\t\n681\t### 4.2 访问优化\n682\t- **2D数据**: 优先使用 `tl.make_block_ptr` 配合 `boundary_check`，自动优化内存合并\n683\t- **步幅设计**: 仔细设计stride参数，错误设置会严重影响性能\n684\t- **数据布局**: 保持内存访问的连续性和局部性\n685\t\n686\t### 4.3 2D 数据访问：tl.make_block_ptr\n687\t\n688\t对于 2D 张量，使用 `tl.make_block_ptr` 可简化索引并提升访存效率：\n689\t\n690\t```python\n691\t# 2D 块访问示例\n692\tptr = tl.make_block_ptr(\n693\t    base=a_ptr,\n694\t    shape=(M, K),\n695\t    strides=(K, 1),\n696\t    offsets=(block_m * BLOCK_M, 0),\n697\t    block_shape=(BLOCK_M, BLOCK_K),\n698\t    order=(1, 0)\n699\t)\n700\ta = tl.load(ptr, boundary_check=(0, 1), padding=\"zero\")\n701\t```\n702\t\n703\t### 4.4 1D 连续内存优化\n704\t\n705\t**优先使用 `.contiguous()` + 1D 访问**，避免 stride 访问带来的额外开销：\n706\t\n707\t```python\n708\tclass ModelNew(torch.nn.Module):\n709\t    def forward(self, input_tensor):\n710\t        if not input_tensor.is_contiguous():\n711\t            input_tensor = input_tensor.contiguous()\n712\t\n713\t        output_tensor = torch.empty_like(input_tensor)\n714\t        n_elements = input_tensor.numel()\n715\t        grid = (triton.cdiv(n_elements, BLOCK_SIZE),)\n716\t        elementwise_kernel[grid](input_tensor, output_tensor, n_elements, BLOCK_SIZE)\n717\t        return output_tensor\n718\t\n719\t@triton.jit\n720\tdef elementwise_kernel(input_ptr, output_ptr, n_elements, BLOCK_SIZE: tl.constexpr):\n721\t    pid = tl.program_id(0)\n722\t    offsets = pid * BLOCK_SIZE + tl.arange(0, BLOCK_SIZE)\n723\t    mask = offsets < n_elements\n724\t    data = tl.load(input_ptr + offsets, mask=mask)\n725\t    result = compute(data)\n726\t    tl.store(output_ptr + offsets, result, mask=mask)\n727\t```\n728\t\n729\t### 4.4 对齐规则\n730\t\n731\t- **256B**：基础对齐单位\n732\t- **512B**：MatMul 等带宽敏感算子推荐（256 个 fp16/bf16 元素）\n733\t\n734\t---\n735\t\n736\t## 5. 性能优化\n737\t\n738\t### 5.1 1D Grid 优先\n739\t\n740\t优先使用一维 grid `(n,)`，便于与 Ascend 核心映射一致。\n741\t\n742\t### 5.2 核内循环优化\n743\t\n744\t编译器会对核内 `for` 循环做自动流水线优化，实现存算并行：\n745\t\n746\t```python\n747\t@triton.jit\n748\tdef optimized_elementwise(input_ptr, output_ptr, n_elements, BLOCK_SIZE: tl.constexpr):\n749\t    pid = tl.program_id(0)\n750\t\n751\t    for i in range(4):\n752\t        offsets = (pid * 4 + i) * BLOCK_SIZE + tl.arange(0, BLOCK_SIZE)\n753\t        mask = offsets < n_elements\n754\t        data = tl.load(input_ptr + offsets, mask=mask)\n755\t        result = compute(data)\n756\t        tl.store(output_ptr + offsets, result, mask=mask)\n757\t```\n758\t\n759\t### 5.3 算子拆分策略\n760\t\n761\t复杂算子可拆分为多个 kernel，减少单 kernel 复杂度，便于调优。\n762\t\n763\t### 5.4 NPU 核心配置\n764\t\n765\t- Element-wise / Reduce：使用 VEC 核心，`grid=(VEC_CORE_NUM,)`\n766\t- MatMul：使用 CUBE 核心，`grid=(CUBE_CORE_NUM,)`\n767\t\n768\t### 5.5 数据传输单位\n769\t\n770\tAscend NPU 数据传输以 **256B** 为单位，设计 block 大小时需考虑对齐。\n771\t\n772\t### 5.6 数值稳定性\n773\t\n774\t- **Softmax 防溢出**：先减最大值再 `exp`\n775\t- **sqrt 非负检查**：`tl.maximum(variance, 0.0)` 再开方\n776\t- **累加用 float32**：reduce 累加建议用 `tl.float32` 避免精度损失\n777\t\n778\t```python\n779\t# 错误：直接 exp 可能溢出\n780\tscores = tl.exp(x)\n781\t\n782\t# 正确：减去最大值\n783\tmax_val = tl.max(x, axis=0)\n784\tscores = tl.exp(x - max_val)\n785\t\n786\t# 方差开方前确保非负\n787\tvariance = tl.maximum(variance, 0.0)\n788\trstd = 1.0 / tl.sqrt(variance + eps)\n789\t```\n790\t\n791\t### 5.7 API 限制（Ascend 特有）\n792\t\n793\t#### 禁止使用的语法\n794\t- 禁止 `return`, `break`, `continue` → 使用mask控制\n795\t- 禁止 lambda表达式 → 使用内联函数或tl.where\n796\t- 禁止 链式布尔运算 → 分步计算mask\n797\t- 禁止 张量直接索引 → 使用tl.load/tl.store\n798\t\n799\t#### tl.constexpr 正确用法\n800\t- **仅在内核参数中使用**: `BLOCK_SIZE: tl.constexpr`\n801\t- **不可在host侧使用**: 启动函数中不可用tl.constexpr\n802\t\n803\t| 限制 | 说明 |\n804\t|------|------|\n805\t| 无 return/break/continue | 使用变量和条件控制流程 |\n806\t| 无 lambda | 使用普通函数或内联逻辑 |\n807\t| 无 while 循环 | 用 `for` + `if` 替代 |\n808\t| 无 Python 切片 | 用 `tl.get_element` / `tl.extract_slice` / `tl.insert_slice` |\n809\t| constexpr 仅用于 kernel 参数 | 编译时常量通过参数传入 |\n810\t| 避免 tl.where 做内存偏移 | 易导致低效，改用 boundary_check 或 mask |\n811\t| 标量类型转换 | 用 `.to(tl.float32)` 等，不用 `tl.float16()` |\n812\t\n813\t```python\n814\t# 不推荐：tl.where 用于偏移\n815\t# ptr = base + tl.where(mask, idx, 0)\n816\t\n817\t# 推荐：mask 用于 load/store\n818\tdata = tl.load(ptr + idx, mask=mask, other=0.0)\n819\t```\n820\t\n821\t---\n822\t\n823\t## 6. 调试清单\n824\t\n825\t### 6.1 内存访问清单\n826\t\n827\t- [ ] 所有 load/store 是否有正确的 mask 或 boundary_check\n828\t- [ ] 指针偏移是否可能越界\n829\t- [ ] 是否使用 `.contiguous()` 保证连续访问\n830\t- [ ] Block 大小是否满足 256B/512B 对齐\n831\t\n832\t### 6.2 控制流清单\n833\t\n834\t- [ ] 是否使用了 `return` / `break` / `continue`（Ascend 不支持）\n835\t- [ ] 是否使用了 `while`（需改为 `for` + `if`）\n836\t- [ ] 是否使用了 lambda\n837\t- [ ] 是否使用了 Python 切片（需改为 tl 切片 API）\n838\t\n839\t### 6.3 Grid/Block 清单\n840\t\n841\t- [ ] Grid 各维度是否 ≤ 65535\n842\t- [ ] BLOCK_SIZE 是否 < 65536\n843\t- [ ] 大 shape 是否采用交错循环或连续块法\n844\t- [ ] 核心数是否在 `__init__` 中获取\n845\t\n846\t### 6.4 并发清单\n847\t\n848\t- [ ] 多 kernel 调用时中间张量是否正确传递\n849\t- [ ] 原子操作是否正确使用（如有）\n850\t\n851\t### 6.5 切片清单\n852\t\n853\t- [ ] 多维索引是否正确计算\n854\t- [ ] 是否使用 `tl.extract_slice` / `tl.insert_slice` 替代 Python 切片\n855\t\n856\t### 6.6 性能清单\n857\t\n858\t- [ ] 是否优先 1D grid\n859\t- [ ] Element-wise 是否使用 VEC 核心\n860\t- [ ] MatMul 是否使用 CUBE 核心\n861\t- [ ] 是否利用核内循环实现存算并行\n862\t\n863\t### 6.7 常见错误速查表\n864\t\n865\t| 错误现象 | 可能原因 | 排查方向 |\n866\t|----------|----------|----------|\n867\t| 编译失败：unsupported op | 使用了 Ascend 不支持的 API | 检查 return/break/while/lambda/切片 |\n868\t| 数值不一致 | 精度、reduce 维度、边界处理 | 检查 mask、axis、float32 累加 |\n869\t| 越界 / 崩溃 | 指针或索引计算错误 | 检查 offset 公式、mask 覆盖 |\n870\t| Grid 超限 | grid 维度 > 65535 | 使用交错循环或拆分 grid |\n871\t| 性能差 | 访存不连续、block 过小 | 使用 contiguous、调整 BLOCK_SIZE |\n872\t| tl.where 相关错误 | Ascend 上 tl.where 用于偏移易出问题 | 改用 mask + other 或 boundary_check |\n873\t\n874\t### 6.8 常见错误解决表\n875\t\n876\t| 错误类型 | 典型症状 | 常见原因 | 解决方案 |\n877\t|---------|---------|---------|---------|\n878\t| 内存越界访问 | 运行时错误、结果异常、随机崩溃 | load/store缺少mask或boundary_check | 添加正确的mask或boundary_check保护 |\n879\t| Grid超限 | 编译失败或运行时错误 | grid总大小超过65535 | 使用交错循环`for i in range(pid, total, core_num)`或连续分块处理 |\n880\t| 控制流错误 | 编译失败、语法错误 | 使用了return/break/continue | 移除禁用语句，使用mask控制流程 |\n881\t| while循环错误 | 编译失败（Ascend后端） | 使用了while循环 | 改用for + if替代：`for i in range(MAX): if i < n:` |\n882\t| 切片语法错误 | 编译失败 | 使用了`b[0]`或`b[i:j]`直接切片 | 使用`tl.get_element`或`tl.extract_slice` |\n883\t| tl.arange索引错误 | 编译失败 | 对`tl.arange`结果使用`get_element` | 直接计算索引值而非提取 |\n884\t| 类型转换错误 | 编译警告或错误 | 使用`tl.float16(scalar)`转换 | 改用`scalar.to(tl.float16)` |\n885\t| constexpr误用 | 编译失败 | 在host侧使用tl.constexpr | 仅在kernel参数中使用tl.constexpr |\n886\t| Stride设置错误 | 计算结果错误、数据错位 | stride参数计算或传递错误 | 验证stride设置，检查tensor.stride() |\n887\t| 数值不稳定 | 结果为NaN或Inf | softmax/sqrt等操作溢出 | 减去最大值、检查非负、使用float32 |\n888\t| 数据竞争 | 结果不确定、每次运行不同 | 多program并发写入同一位置 | 使用tl.atomic_add等原子操作 |\n889\t| BLOCK_SIZE过大 | 编译失败或运行时错误 | BLOCK_SIZE超过65536或硬件限制 | 减小BLOCK_SIZE，使用循环处理 |\n890\t| tl.where偏移计算 | 编译失败（Ascend后端） | 在内存偏移中使用tl.where | 改用if-else静态分支处理 |\n891\t| 性能低下 | 运行缓慢 | 内存访问不连续、切分不合理 | 优化内存布局、调整BLOCK_SIZE、使用block_ptr |\n892\t\n893\t---\n894\t\n895\t## 注意conv类卷积算子编写：\n896\ttorch module中的卷积算子生成会包含一个随机权重weight，为保证我们生成的triton实现也具有相同的结果，我们可以在triton的host侧代码中生成对应的weight，例如：\n897\t```python\n898\timport torch\n899\timport torch.nn as nn\n900\timport triton\n901\timport triton.language as tl\n902\t\n903\t@triton.jit\n904\tdef triton_kernel():\n905\t    pass\n906\tdef triton_host():\n907\t    args = ...\n908\t    weight = nn.conv(**args).weight.to(device)\n909\t```\n910\t具体的参数和''nn''中调用的module要与torch保持一致，device与传入的backend保持一致（如\"npu\"），我会在调用triton之前固定相同的随机种子，所以在这里只需要正确地创建类的实例，并导出权重\n911\t\n912\t---\n913\t\n914\t## 附录：完整代码示例\n915\t\n916\t### A.1 Vector Add（向量加法）\n917\t\n918\t```python\n919\t@triton.jit\n920\tdef vector_add_kernel(a_ptr, b_ptr, c_ptr, n_elements, BLOCK_SIZE: tl.constexpr):\n921\t    pid = tl.program_id(0)\n922\t    offsets = pid * BLOCK_SIZE + tl.arange(0, BLOCK_SIZE)\n923\t    mask = offsets < n_elements\n924\t\n925\t    a = tl.load(a_ptr + offsets, mask=mask)\n926\t    b = tl.load(b_ptr + offsets, mask=mask)\n927\t    c = a + b\n928\t\n929\t    tl.store(c_ptr + offsets, c, mask=mask)\n930\t\n931\tclass ModelNew(torch.nn.Module):\n932\t    def forward(self, a, b):\n933\t        c = torch.empty_like(a)\n934\t        n_elements = a.numel()\n935\t        grid = (triton.cdiv(n_elements, BLOCK_SIZE),)\n936\t        vector_add_kernel[grid](a, b, c, n_elements, BLOCK_SIZE=1024)\n937\t        return c\n938\t```\n939\t\n940\t### A.2 Reduce 算子（块内归约 + 原子操作）\n941\t\n942\t```python\n943\t@triton.jit\n944\tdef reduction_kernel(input_ptr, output_ptr, n_elements, BLOCK_SIZE: tl.constexpr):\n945\t    pid = tl.program_id(0)\n946\t    offsets = pid * BLOCK_SIZE + tl.arange(0, BLOCK_SIZE)\n947\t    mask = offsets < n_elements\n948\t\n949\t    data = tl.load(input_ptr + offsets, mask=mask, other=0.0)\n950\t    block_sum = tl.sum(data, axis=0)\n951\t    tl.atomic_add(output_ptr, block_sum)\n952\t```\n953\t\n954\t### A.3 MatMul（固定核心数启动）\n955\t\n956\t```python\n957\t@triton.jit\n958\tdef matmul_kernel(\n959\t    a_ptr, b_ptr, c_ptr,\n960\t    M, N, K,\n961\t    num_cores: tl.constexpr,\n962\t    BLOCK_M: tl.constexpr,\n963\t    BLOCK_N: tl.constexpr,\n964\t    BLOCK_K: tl.constexpr,\n965\t):\n966\t    pid = tl.program_id(0)\n967\t    NUM_BLOCKS_M = triton.cdiv(M, BLOCK_M)\n968\t    NUM_BLOCKS_N = triton.cdiv(N, BLOCK_N)\n969\t    NUM_BLOCKS = NUM_BLOCKS_M * NUM_BLOCKS_N\n970\t\n971\t    for block_idx in range(pid, NUM_BLOCKS, num_cores):\n972\t        block_m = block_idx // NUM_BLOCKS_N\n973\t        block_n = block_idx % NUM_BLOCKS_N\n974\t\n975\t        accumulator = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)\n976\t\n977\t        for k in range(0, K, BLOCK_K):\n978\t            a_offset = (block_m * BLOCK_M + tl.arange(0, BLOCK_M))[:, None] * K + \\\n979\t                       (k + tl.arange(0, BLOCK_K))[None, :]\n980\t            a_mask = (block_m * BLOCK_M + tl.arange(0, BLOCK_M))[:, None] < M\n981\t            a = tl.load(a_ptr + a_offset, mask=a_mask, other=0.0)\n982\t\n983\t            b_offset = (k + tl.arange(0, BLOCK_K))[:, None] * N + \\\n984\t                       (block_n * BLOCK_N + tl.arange(0, BLOCK_N))[None, :]\n985\t            b_mask = (block_n * BLOCK_N + tl.arange(0, BLOCK_N))[None, :] < N\n986\t            b = tl.load(b_ptr + b_offset, mask=b_mask, other=0.0)\n987\t\n988\t            accumulator += tl.dot(a, b)\n989\t\n990\t        c_offset = (block_m * BLOCK_M + tl.arange(0, BLOCK_M))[:, None] * N + \\\n991\t                   (block_n * BLOCK_N + tl.arange(0, BLOCK_N))[None, :]\n992\t        c_mask = ((block_m * BLOCK_M + tl.arange(0, BLOCK_M))[:, None] < M) & \\\n993\t                 ((block_n * BLOCK_N + tl.arange(0, BLOCK_N))[None, :] < N)\n994\t        tl.store(c_ptr + c_offset, accumulator, mask=c_mask)\n995\t\n996\tclass ModelNew(torch.nn.Module):\n997\t    def __init__(self):\n998\t        super().__init__()\n999\t\n1000\t    def forward(self, a, b):\n1001\t        M, K = a.shape\n1002\t        K2, N = b.shape\n1003\t        assert K == K2\n1004\t        c = torch.empty((M, N), device=a.device, dtype=a.dtype)\n1005\t\n1006\t        num_cores = 20\n1007\t        BLOCK_M, BLOCK_N, BLOCK_K = 128, 256, 256\n1008\t\n1009\t        matmul_kernel[(num_cores,)](a, b, c, M, N, K, num_cores,\n1010\t                                    BLOCK_M, BLOCK_N, BLOCK_K)\n1011\t        return c\n1012\t```\n1013\t\n1014\t### A.4 LayerNorm 核心逻辑（归一化）\n1015\t\n1016\t```python\n1017\t# 1. 计算均值\n1018\tmean = tl.sum(x, axis=0) / n_cols\n1019\t\n1020\t# 2. 计算方差\n1021\tx_centered = x - mean\n1022\tvariance = tl.sum(x_centered * x_centered, axis=0) / n_cols\n1023\t\n1024\t# 3. 归一化\n1025\tvariance = tl.maximum(variance, 0.0)\n1026\trstd = 1.0 / tl.sqrt(variance + eps)\n1027\tnormalized = x_centered * rstd\n1028\t\n1029\t# 4. 应用 weight 和 bias\n1030\toutput = normalized * weight + bias\n1031\t```\n1032\t\n1033\t### A.5 Double Kernel（多内核调用）\n1034\t\n1035\t```python\n1036\tclass ModelNew(torch.nn.Module):\n1037\t    def forward(self, x):\n1038\t        intermediate = torch.empty_like(x)\n1039\t        kernel1[grid](x, intermediate, ...)\n1040\t\n1041\t        output = torch.empty_like(x)\n1042\t        kernel2[grid](intermediate, output, ...)\n1043\t\n1044\t        return output\n1045\t```\n1046\t\n1047\t### A.6 完整 GELU 示例\n1048\t\n1049\t```python\n1050\timport triton\n1051\timport triton.language as tl\n1052\timport torch\n1053\t\n1054\t@triton.jit\n1055\tdef triton_easy_kernel(in_ptr0, out_ptr0, NUMEL: tl.constexpr):\n1056\t    idx_block = tl.arange(0, NUMEL)\n1057\t    x = tl.load(in_ptr0 + idx_block)\n1058\t    ret = x * 0.5 * (1.0 + tl.erf(x / tl.sqrt(2.0)))\n1059\t    tl.store(out_ptr0 + idx_block, ret)\n1060\t\n1061\t@triton.jit\n1062\tdef triton_better_kernel(in_ptr0, out_ptr0, xnumel, XBLOCK: tl.constexpr, XBLOCK_SUB: tl.constexpr):\n1063\t    xoffset = tl.program_id(0) * XBLOCK\n1064\t    for xoffset_sub in range(0, XBLOCK, XBLOCK_SUB):\n1065\t        x_index = xoffset + xoffset_sub + tl.arange(0, XBLOCK_SUB)[:]\n1066\t        xmask = x_index < xnumel\n1067\t        x = tl.load(in_ptr0 + x_index, xmask)\n1068\t        ret = x * 0.5 * (1.0 + tl.erf(x / tl.sqrt(2.0)))\n1069\t        tl.store(out_ptr0 + x_index, ret, xmask)\n1070\t\n1071\t# 调用示例\n1072\tncore = 32\n1073\txblock = 32768\n1074\txblock_sub = 8192\n1075\ttriton_better_kernel[ncore, 1, 1](x0, out1, x0.numel(), xblock, xblock_sub)\n1076\t```\n1077\t\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"},{"role":"assistant","content":"Environment check (Phase 0): no `npu-smi`, no `torch`/`torch_npu`/`triton` in any env, no Ascend toolchain — so this is **codegen without on-device verification** (mock-only environment). I'll run the full workflow and execute the AST pre-check, then be explicit that runtime verify/benchmark can't run here.","tool_calls":[{"id":"chatcmpl-tool-9a8d8a87b7b82341","type":"function","function":{"name":"TaskCreate","arguments":"{\"activeForm\":\"Building task description\",\"description\":\"Create work dir, write rmsnorm.py task file (Model + get_inputs + get_init_inputs)\",\"subject\":\"Phase 1: Build RMSNorm task description\"}"}},{"id":"chatcmpl-tool-aaa7352698505a28","type":"function","function":{"name":"TaskCreate","arguments":"{\"activeForm\":\"Designing algorithm sketch\",\"description\":\"Write sketch.txt with tiling/parallelization strategy for RMSNorm reduce op\",\"subject\":\"Phase 2: Algorithm design sketch\"}"}},{"id":"chatcmpl-tool-93f9968801efc0e8","type":"function","function":{"name":"TaskCreate","arguments":"{\"activeForm\":\"Generating Triton-Ascend kernel\",\"description\":\"Generate ModelNew with @triton.jit RMSNorm kernel, run validate_triton_impl.py\",\"subject\":\"Phase 3: Generate Triton-Ascend kernel + AST pre-check\"}"}},{"id":"chatcmpl-tool-97e48f6a9a35ad44","type":"function","function":{"name":"TaskCreate","arguments":"{\"activeForm\":\"Writing report\",\"description\":\"Write summary.json and report.md; document that verify/benchmark require torch_npu+NPU (unavailable)\",\"subject\":\"Phase 5: Report + summary\"}"}}]},{"role":"tool","tool_call_id":"chatcmpl-tool-9a8d8a87b7b82341","content":"Task #1 created successfully: Phase 1: Build RMSNorm task description"},{"role":"tool","tool_call_id":"chatcmpl-tool-aaa7352698505a28","content":"Task #2 created successfully: Phase 2: Algorithm design sketch"},{"role":"tool","tool_call_id":"chatcmpl-tool-93f9968801efc0e8","content":"Task #3 created successfully: Phase 3: Generate Triton-Ascend kernel + AST pre-check"},{"role":"tool","tool_call_id":"chatcmpl-tool-97e48f6a9a35ad44","content":"Task #4 created successfully: Phase 5: Report + summary"},{"role":"assistant","content":null,"tool_calls":[{"id":"chatcmpl-tool-b1f70606b65087f3","type":"function","function":{"name":"TaskUpdate","arguments":"{\"status\":\"in_progress\",\"taskId\":\"1\"}"}},{"id":"chatcmpl-tool-b9dec1e95ee565f7","type":"function","function":{"name":"Write","arguments":"{\"file_path\":\"/home/vince/.claude/jobs/09264df0/tmp/gate-088/tier1/p2B/ws/triton_ascend_output/op_rmsnorm_20261105_1402_9069/rmsnorm.py\",\"content\":\"\\\"\\\"\\\"RMSNorm operator task description (Triton-Ascend task format).\\n\\nReference implementation: Root Mean Square Layer Normalization.\\ny = x / sqrt(mean(x^2) + eps) * weight\\n\\\"\\\"\\\"\\nimport torch\\nimport torch.nn as nn\\n\\n\\nclass Model(nn.Module):\\n    \\\"\\\"\\\"PyTorch reference RMSNorm.\\\"\\\"\\\"\\n\\n    def __init__(self, hidden_size: int, eps: float = 1e-6):\\n        super().__init__()\\n        self.hidden_size = hidden_size\\n        self.eps = eps\\n        self.weight = nn.Parameter(torch.ones(hidden_size))\\n\\n    def forward(self, x: torch.Tensor) -> torch.Tensor:\\n        x_fp32 = x.float()\\n        variance = x_fp32.pow(2).mean(-1, keepdim=True)\\n        x_normed = x_fp32 * torch.rsqrt(variance + self.eps)\\n        return (x_normed * self.weight.float()).to(x.dtype)\\n\\n\\ndef get_inputs():\\n    \\\"\\\"\\\"Single-case input provider: (batch=8, seq=128, hidden=512) fp16.\\\"\\\"\\\"\\n    x = torch.randn(8, 128, 512, dtype=torch.float16)\\n    return [x]\\n\\n\\ndef get_init_inputs():\\n    return [512, 1e-6]\\n\"}"}}]},{"role":"tool","tool_call_id":"chatcmpl-tool-b1f70606b65087f3","content":"Updated task #1 status"},{"role":"tool","tool_call_id":"chatcmpl-tool-b9dec1e95ee565f7","content":"File created successfully at: /home/vince/.claude/jobs/09264df0/tmp/gate-088/tier1/p2B/ws/triton_ascend_output/op_rmsnorm_20261105_1402_9069/rmsnorm.py"},{"role":"assistant","content":null,"tool_calls":[{"id":"chatcmpl-tool-bd06410ec1e61bae","type":"function","function":{"name":"TaskUpdate","arguments":"{\"status\":\"completed\",\"taskId\":\"1\"}"}},{"id":"chatcmpl-tool-a35141411bc0523d","type":"function","function":{"name":"TaskUpdate","arguments":"{\"status\":\"in_progress\",\"taskId\":\"2\"}"}},{"id":"chatcmpl-tool-ba6f33d4dfa51d56","type":"function","function":{"name":"Write","arguments":"{\"content\":\"RMSNorm 算法设计草图 (triton-op-designer, arch=ascend910b1 默认, reduce 类算子)\\n=====================================================================\\n\\n1. 任务分析\\n- op: rmsnorm, hidden_size=512 (最后一维), eps=1e-6, 输入 fp16, 权重 fp32 ones(hidden_size)\\n- y = x * rsqrt(mean(x^2) + eps) * weight, 计算在 fp32 上做, 输出转回 fp16\\n- 算子类型: Reduce (行内归一化), 每行独立 → 行间天然并行\\n\\n2. 并行策略\\n- grid 按行切分: 每个程序处理一行 (hidden=512 个元素), grid = (num_rows,)\\n- hidden=512 为 2 的幂且 ≤ 65536, 单块可完整装入, BLOCK_SIZE=512, 无需 mask 循环\\n- 行数大时 grid 可能超 65535 (如 rows>65535): 对本任务 8*128=1024 行安全;\\n  为通用性在 forward 中用 triton.cdiv 且保持 1D grid\\n\\n3. Kernel 设计 (五步模式, 单 kernel, 一次遍历)\\n- Step1: row = tl.program_id(0)\\n- Step2: cols = tl.arange(0, BLOCK_SIZE)\\n- Step3: ptrs = x_ptr + row * hidden_size + cols\\n- Step4: mask = cols < hidden_size (hidden=512 时恒真, 保留以支持任意 hidden)\\n- Step5: load(fp16) → .to(tl.float32) →\\n    var = tl.sum(x*x, axis=0) / hidden_size          # fp32 累加 (reduce 精度规则)\\n    rstd = 1.0 / tl.sqrt(var + eps)                   # tl.maximum(var,0.0) 防负\\n    y = x * rstd * tl.load(w_ptr + cols).to(tl.float32)\\n    store y.to(fp16)\\n\\n4. 精度要点 (来自 triton-ascend-reduce.md)\\n- 归约前强制 .to(tl.float32), 累加器 fp32\\n- rsqrt 用 1/sqrt(var+eps) 实现; var+eps ≥ eps > 0, 无溢出风险\\n- weight 以 fp32 参与, 最终 store 前 .to(element_ty)\\n\\n5. 性能要点\\n- 连续 1D 行访问, 无 stride 复杂度; fp16 行 512*2B=1024B, 256B 对齐满足\\n- 权重每行重复 load, 可被 cache; hidden 已知为 constexpr BLOCK_SIZE 减少索引开销\\n- 不用 atomic, 每行输出独立\\n\\n6. 风险\\n- 非 2 次幂 hidden: mask 兜底 (本任务 512)\\n- 极大行数: grid 上限 65535, 必要时可改交错循环 (本任务不触发)\\n\",\"file_path\":\"/home/vince/.claude/jobs/09264df0/tmp/gate-088/tier1/p2B/ws/triton_ascend_output/op_rmsnorm_20261105_1402_9069/sketch.txt\"}"}}]},{"role":"tool","tool_call_id":"chatcmpl-tool-bd06410ec1e61bae","content":"Updated task #1 status"},{"role":"tool","tool_call_id":"chatcmpl-tool-a35141411bc0523d","content":"Updated task #2 status"},{"role":"tool","tool_call_id":"chatcmpl-tool-ba6f33d4dfa51d56","content":"File created successfully at: /home/vince/.claude/jobs/09264df0/tmp/gate-088/tier1/p2B/ws/triton_ascend_output/op_rmsnorm_20261105_1402_9069/sketch.txt"}],"tools":[{"type":"function","function":{"name":"Agent","description":"Agent","parameters":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"description":{"type":"string","description":"A short (3-5 word) description of the task"},"prompt":{"type":"string","description":"The task for the agent to perform"},"subagent_type":{"description":"The type of specialized agent to use for this task","type":"string"},"model":{"description":"Optional model override for this agent. Takes precedence over the agent definition's model frontmatter. If omitted, uses the agent definition's model, or inherits from the parent.","type":"string","enum":["small","premium","fast"]},"run_in_background":{"description":"Set to true to run this agent in the background. You will be notified when it completes.","type":"boolean"},"name":{"description":"Name for the spawned agent. Makes it addressable via SendMessage({to: name}) while running.","type":"string"},"team_name":{"description":"Team name for spawning. Uses current team context if omitted.","type":"string"}},"required":["description","prompt"],"additionalProperties":false}}},{"type":"function","function":{"name":"AscendSkillSourceCheck","description":"AscendSkillSourceCheck","parameters":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"source":{"type":"string","enum":["agent-skills","ms-agent-skills"]},"action":{"type":"string","enum":["check","update"]},"timeoutMs":{"type":"integer","exclusiveMinimum":0,"maximum":120000}},"required":["source","action"],"additionalProperties":false}}},{"type":"function","function":{"name":"AskUserQuestion","description":"AskUserQuestion","parameters":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"questions":{"minItems":1,"maxItems":4,"type":"array","items":{"type":"object","properties":{"question":{"type":"string","description":"The complete question to ask the user. Should be clear, specific, and end with a question mark. Example: \"Which library should we use for date formatting?\" If multiSelect is true, phrase it accordingly, e.g. \"Which features do you want to enable?\""},"header":{"type":"string","description":"Very short label displayed as a chip/tag (max 12 chars). Examples: \"Auth method\", \"Library\", \"Approach\"."},"options":{"minItems":2,"maxItems":4,"type":"array","items":{"type":"object","properties":{"label":{"type":"string","description":"The display text for this option that the user will see and select. Should be concise (1-5 words) and clearly describe the choice."},"description":{"type":"string","description":"Explanation of what this option means or what will happen if chosen. Useful for providing context about trade-offs or implications."},"preview":{"description":"Optional preview content rendered when this option is focused. Use for mockups, code snippets, or visual comparisons that help users compare options. See the tool description for the expected content format.","type":"string"}},"required":["label","description"],"additionalProperties":false},"description":"The available choices for this question. Must have 2-4 options. Each option should be a distinct, mutually exclusive choice (unless multiSelect is enabled). There should be no 'Other' option, that will be provided automatically."},"multiSelect":{"default":false,"description":"Set to true to allow the user to select multiple options instead of just one. Use when choices are not mutually exclusive.","type":"boolean"}},"required":["question","header","options","multiSelect"],"additionalProperties":false},"description":"Questions to ask the user (1-4 questions)"},"answers":{"description":"User answers collected by the permission component","type":"object","propertyNames":{"type":"string"},"additionalProperties":{"type":"string"}},"annotations":{"description":"Optional per-question annotations from the user (e.g., notes on preview selections). Keyed by question text.","type":"object","propertyNames":{"type":"string"},"additionalProperties":{"type":"object","properties":{"preview":{"description":"The preview content of the selected option, if the question used previews.","type":"string"},"notes":{"description":"Free-text notes the user added to their selection.","type":"string"}},"additionalProperties":false}},"metadata":{"description":"Optional metadata for tracking and analytics purposes. Not displayed to user.","type":"object","properties":{"source":{"description":"Optional identifier for the source of this question (e.g., \"remember\" for /remember command). Used for analytics tracking.","type":"string"}},"additionalProperties":false}},"required":["questions"],"additionalProperties":false}}},{"type":"function","function":{"name":"Bash","description":"Bash","parameters":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"command":{"type":"string","description":"The bash command to execute."},"description":{"description":"Clear, concise description of what this command does (shown in the UI).","type":"string"},"timeout_ms":{"description":"Timeout in milliseconds. The executor applies its configured default and cap, and kills the command on expiry.","type":"integer","exclusiveMinimum":0,"maximum":9007199254740991},"timeout":{"description":"Timeout in milliseconds (alias accepted by the shared tool-execution layer).","type":"integer","exclusiveMinimum":0,"maximum":9007199254740991},"_simulatedSedEdit":{"type":"object","properties":{"filePath":{"type":"string"},"before":{"type":"string"},"after":{"type":"string"}},"required":["filePath"],"additionalProperties":false},"run_in_background":{"description":"Run in the background and return a task id immediately (collect with TaskOutput, stop with TaskStop).","type":"boolean"},"dangerouslyDisableSandbox":{"description":"Run the command outside the sandbox (use only when sandbox restrictions caused the failure).","type":"boolean"}},"required":["command"],"additionalProperties":false}}},{"type":"function","function":{"name":"Config","description":"Config","parameters":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"setting":{"type":"string","description":"The setting key (e.g., \"theme\", \"model\", \"permissions.defaultMode\")"},"value":{"description":"The new value. Omit to get current value.","type":["string","boolean","number"]}},"required":["setting"],"additionalProperties":false}}},{"type":"function","function":{"name":"Edit","description":"Edit","parameters":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"file_path":{"type":"string","description":"The absolute path to the file to modify"},"old_string":{"type":"string","description":"The text to replace"},"new_string":{"type":"string","description":"The text to replace it with (must be different from old_string)"},"replace_all":{"description":"Replace all occurrences of old_string (default false)","default":false,"type":"boolean"}},"required":["file_path","old_string","new_string"],"additionalProperties":false}}},{"type":"function","function":{"name":"EnterPlanMode","description":"EnterPlanMode","parameters":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{},"additionalProperties":false}}},{"type":"function","function":{"name":"EnterWorktree","description":"EnterWorktree","parameters":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"name":{"description":"Optional name for the worktree. Each \"/\"-separated segment may contain only letters, digits, dots, underscores, and dashes; max 64 chars total. A random name is generated if not provided.","type":"string"}},"additionalProperties":false}}},{"type":"function","function":{"name":"ExitPlanMode","description":"ExitPlanMode","parameters":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"allowedPrompts":{"description":"Prompt-based permissions needed to implement the plan. These describe categories of actions rather than specific commands.","type":"array","items":{"type":"object","properties":{"tool":{"type":"string","enum":["Bash"],"description":"The tool this prompt applies to"},"prompt":{"type":"string","description":"Semantic description of the action, e.g. \"run tests\", \"install dependencies\""}},"required":["tool","prompt"],"additionalProperties":false}}},"additionalProperties":{}}}},{"type":"function","function":{"name":"ExitWorktree","description":"ExitWorktree","parameters":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"action":{"type":"string","enum":["keep","remove"],"description":"\"keep\" leaves the worktree and branch on disk; \"remove\" deletes both."},"discard_changes":{"description":"Required true when action is \"remove\" and the worktree has uncommitted files or unmerged commits. The tool will refuse and list them otherwise.","type":"boolean"}},"required":["action"],"additionalProperties":false}}},{"type":"function","function":{"name":"Glob","description":"Glob","parameters":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"pattern":{"type":"string","description":"The glob pattern to match files against"},"path":{"description":"The directory to search in. If not specified, the current working directory will be used. IMPORTANT: Omit this field to use the default directory. DO NOT enter \"undefined\" or \"null\" - simply omit it for the default behavior. Must be a valid directory path if provided.","type":"string"}},"required":["pattern"],"additionalProperties":false}}},{"type":"function","function":{"name":"Grep","description":"Grep","parameters":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"pattern":{"type":"string","description":"The regular expression pattern to search for in file contents"},"path":{"description":"File or directory to search in (rg PATH). Defaults to current working directory.","type":"string"},"glob":{"description":"Glob pattern to filter files (e.g. \"*.js\", \"*.{ts,tsx}\") - maps to rg --glob","type":"string"},"output_mode":{"description":"Output mode: \"content\" shows matching lines (supports -A/-B/-C context, -n line numbers, head_limit), \"files_with_matches\" shows file paths (supports head_limit), \"count\" shows match counts (supports head_limit). Defaults to \"files_with_matches\".","type":"string","enum":["content","files_with_matches","count"]},"-B":{"description":"Number of lines to show before each match (rg -B). Requires output_mode: \"content\", ignored otherwise.","type":"number"},"-A":{"description":"Number of lines to show after each match (rg -A). Requires output_mode: \"content\", ignored otherwise.","type":"number"},"-C":{"description":"Alias for context.","type":"number"},"context":{"description":"Number of lines to show before and after each match (rg -C). Requires output_mode: \"content\", ignored otherwise.","type":"number"},"-n":{"description":"Show line numbers in output (rg -n). Requires output_mode: \"content\", ignored otherwise. Defaults to true.","type":"boolean"},"-i":{"description":"Case insensitive search (rg -i)","type":"boolean"},"type":{"description":"File type to search (rg --type). Common types: js, py, rust, go, java, etc. More efficient than include for standard file types.","type":"string"},"head_limit":{"description":"Limit output to first N lines/entries, equivalent to \"| head -N\". Works across all output modes: content (limits output lines), files_with_matches (limits file paths), count (limits count entries). Defaults to 250 when unspecified. Pass 0 for unlimited (use sparingly — large result sets waste context).","type":"number"},"offset":{"description":"Skip first N lines/entries before applying head_limit, equivalent to \"| tail -n +N | head -N\". Works across all output modes. Defaults to 0.","type":"number"},"multiline":{"description":"Enable multiline mode where . matches newlines and patterns can span lines (rg -U --multiline-dotall). Default: false.","type":"boolean"}},"required":["pattern"],"additionalProperties":false}}},{"type":"function","function":{"name":"ListMcpResourcesTool","description":"ListMcpResourcesTool","parameters":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"server":{"description":"Optional server name to filter resources by","type":"string"}},"additionalProperties":false}}},{"type":"function","function":{"name":"NotebookEdit","description":"NotebookEdit","parameters":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"notebook_path":{"type":"string","description":"The absolute path to the Jupyter notebook file to edit (must be absolute, not relative)"},"cell_id":{"description":"The ID of the cell to edit. When inserting a new cell, the new cell will be inserted after the cell with this ID, or at the beginning if not specified.","type":"string"},"new_source":{"type":"string","description":"The new source for the cell"},"cell_type":{"description":"The type of the cell (code or markdown). If not specified, it defaults to the current cell type. If using edit_mode=insert, this is required.","type":"string","enum":["code","markdown"]},"edit_mode":{"description":"The type of edit to make (replace, insert, delete). Defaults to replace.","type":"string","enum":["replace","insert","delete"]}},"required":["notebook_path","new_source"],"additionalProperties":false}}},{"type":"function","function":{"name":"Read","description":"Read","parameters":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"file_path":{"type":"string","description":"The absolute path to the file to read"},"offset":{"description":"The line number to start reading from. Only provide if the file is too large to read at once","type":"integer","minimum":0,"maximum":9007199254740991},"limit":{"description":"The number of lines to read. Only provide if the file is too large to read at once.","type":"integer","exclusiveMinimum":0,"maximum":9007199254740991},"pages":{"description":"Page range for PDF files (e.g., \"1-5\", \"3\", \"10-20\"). Only applicable to PDF files. Maximum 20 pages per request.","type":"string"},"allow_large":{"description":"Set to true only when you explicitly need the entire plain text file in one read and still have context space for it. This lifts the size and output-token limits for that full plain text read; providing offset and limit still selects the range, and the normal limits then apply to it. It does not affect images, PDFs, or notebooks.","type":"boolean"}},"required":["file_path"],"additionalProperties":false}}},{"type":"function","function":{"name":"ReadMcpResourceTool","description":"ReadMcpResourceTool","parameters":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"server":{"type":"string","description":"The MCP server name"},"uri":{"type":"string","description":"The resource URI to read"}},"required":["server","uri"],"additionalProperties":false}}},{"type":"function","function":{"name":"Skill","description":"Skill","parameters":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"skill":{"type":"string","description":"The skill name. E.g., \"commit\", \"review-pr\", or \"pdf\""},"args":{"description":"Optional arguments for the skill","type":"string"}},"required":["skill"],"additionalProperties":false}}},{"type":"function","function":{"name":"TaskCreate","description":"TaskCreate","parameters":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"subject":{"type":"string","description":"A brief title for the task"},"description":{"type":"string","description":"What needs to be done"},"activeForm":{"description":"Present continuous form shown in spinner when in_progress (e.g., \"Running tests\")","type":"string"},"metadata":{"description":"Arbitrary metadata to attach to the task","type":"object","propertyNames":{"type":"string"},"additionalProperties":{}}},"required":["subject","description"],"additionalProperties":false}}},{"type":"function","function":{"name":"TaskGet","description":"TaskGet","parameters":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"taskId":{"type":"string","description":"The ID of the task to retrieve"}},"required":["taskId"],"additionalProperties":false}}},{"type":"function","function":{"name":"TaskList","description":"TaskList","parameters":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{},"additionalProperties":false}}},{"type":"function","function":{"name":"TaskOutput","description":"TaskOutput","parameters":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"task_id":{"type":"string","description":"The task ID to get output from"},"block":{"description":"Whether to wait for completion","default":true,"type":"boolean"},"timeout":{"default":30000,"description":"Max wait time in ms","type":"number","minimum":0,"maximum":600000}},"required":["task_id","block","timeout"],"additionalProperties":false}}},{"type":"function","function":{"name":"TaskStop","description":"TaskStop","parameters":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"task_id":{"description":"The ID of the background task to stop","type":"string"},"shell_id":{"description":"Deprecated: use task_id instead","type":"string"}},"additionalProperties":false}}},{"type":"function","function":{"name":"TaskUpdate","description":"TaskUpdate","parameters":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"taskId":{"type":"string","description":"The ID of the task to update"},"subject":{"description":"New subject for the task","type":"string"},"description":{"description":"New description for the task","type":"string"},"activeForm":{"description":"Present continuous form shown in spinner when in_progress (e.g., \"Running tests\")","type":"string"},"status":{"description":"New status for the task","anyOf":[{"type":"string","enum":["pending","in_progress","completed"]},{"type":"string","const":"deleted"}]},"addBlocks":{"description":"Task IDs that this task blocks","type":"array","items":{"type":"string"}},"addBlockedBy":{"description":"Task IDs that block this task","type":"array","items":{"type":"string"}},"owner":{"description":"New owner for the task","type":"string"},"metadata":{"description":"Metadata keys to merge into the task. Set a key to null to delete it.","type":"object","propertyNames":{"type":"string"},"additionalProperties":{}}},"required":["taskId"],"additionalProperties":false}}},{"type":"function","function":{"name":"ToolSearch","description":"ToolSearch","parameters":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"query":{"type":"string","description":"Query to find deferred tools. Use \"select:<tool_name>\" for direct selection, or keywords to search."},"max_results":{"default":5,"description":"Maximum number of results to return (default: 5)","type":"number"}},"required":["query","max_results"],"additionalProperties":false}}},{"type":"function","function":{"name":"WebFetch","description":"WebFetch","parameters":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"url":{"type":"string","format":"uri","description":"The URL to fetch content from"},"prompt":{"type":"string","description":"The prompt to run on the fetched content"}},"required":["url","prompt"],"additionalProperties":false}}},{"type":"function","function":{"name":"WebSearch","description":"WebSearch","parameters":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"query":{"type":"string","minLength":2,"description":"The search query to use"},"allowed_domains":{"description":"Only include search results from these domains","type":"array","items":{"type":"string"}},"blocked_domains":{"description":"Never include search results from these domains","type":"array","items":{"type":"string"}}},"required":["query"],"additionalProperties":false}}},{"type":"function","function":{"name":"Write","description":"Write","parameters":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"file_path":{"type":"string","description":"The absolute path to the file to write (must be absolute, not relative)"},"content":{"type":"string","description":"The content to write to the file"}},"required":["file_path","content"],"additionalProperties":false}}},{"type":"function","function":{"name":"mcp__msprof-mcp__analyze_communication","description":"mcp__msprof-mcp__analyze_communication","parameters":{"type":"object","properties":{"json_path":{"title":"Json Path","type":"string"}},"required":["json_path"],"title":"analyze_communicationArguments"}}},{"type":"function","function":{"name":"mcp__msprof-mcp__analyze_kernel_details","description":"mcp__msprof-mcp__analyze_kernel_details","parameters":{"type":"object","properties":{"csv_path":{"title":"Csv Path","type":"string"}},"required":["csv_path"],"title":"analyze_kernel_detailsArguments"}}},{"type":"function","function":{"name":"mcp__msprof-mcp__analyze_op_statistic","description":"mcp__msprof-mcp__analyze_op_statistic","parameters":{"type":"object","properties":{"csv_path":{"title":"Csv Path","type":"string"}},"required":["csv_path"],"title":"analyze_op_statisticArguments"}}},{"type":"function","function":{"name":"mcp__msprof-mcp__analyze_overlap","description":"mcp__msprof-mcp__analyze_overlap","parameters":{"type":"object","properties":{"trace_path":{"title":"Trace Path","type":"string"}},"required":["trace_path"],"title":"analyze_overlapArguments"}}},{"type":"function","function":{"name":"mcp__msprof-mcp__create_dispatch_view","description":"mcp__msprof-mcp__create_dispatch_view","parameters":{"type":"object","properties":{"db_path":{"title":"Db Path","type":"string"},"replace_existing":{"default":false,"title":"Replace Existing","type":"boolean"}},"required":["db_path"],"title":"create_dispatch_viewArguments"}}},{"type":"function","function":{"name":"mcp__msprof-mcp__execute_sql","description":"mcp__msprof-mcp__execute_sql","parameters":{"type":"object","properties":{"db_path":{"title":"Db Path","type":"string"},"query":{"title":"Query","type":"string"}},"required":["db_path","query"],"title":"execute_sqlArguments"}}},{"type":"function","function":{"name":"mcp__msprof-mcp__execute_sql_query","description":"mcp__msprof-mcp__execute_sql_query","parameters":{"type":"object","properties":{"trace_path":{"title":"Trace Path","type":"string"},"sql_query":{"title":"Sql Query","type":"string"},"process_name":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Process Name"}},"required":["trace_path","sql_query"],"title":"execute_sql_queryArguments"}}},{"type":"function","function":{"name":"mcp__msprof-mcp__execute_sql_to_csv","description":"mcp__msprof-mcp__execute_sql_to_csv","parameters":{"type":"object","properties":{"db_path":{"title":"Db Path","type":"string"},"query":{"title":"Query","type":"string"},"output_csv_path":{"title":"Output Csv Path","type":"string"}},"required":["db_path","query","output_csv_path"],"title":"execute_sql_to_csvArguments"}}},{"type":"function","function":{"name":"mcp__msprof-mcp__find_slices","description":"mcp__msprof-mcp__find_slices","parameters":{"type":"object","properties":{"trace_path":{"title":"Trace Path","type":"string"},"pattern":{"title":"Pattern","type":"string"},"process_name":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Process Name"},"match_mode":{"default":"contains","title":"Match Mode","type":"string"},"limit":{"default":100,"title":"Limit","type":"integer"},"main_thread_only":{"default":false,"title":"Main Thread Only","type":"boolean"},"time_range":{"anyOf":[{"additionalProperties":true,"type":"object"},{"type":"null"}],"default":null,"title":"Time Range"}},"required":["trace_path","pattern"],"title":"find_slicesArguments"}}},{"type":"function","function":{"name":"mcp__msprof-mcp__get_csv_info","description":"mcp__msprof-mcp__get_csv_info","parameters":{"type":"object","properties":{"csv_path":{"title":"Csv Path","type":"string"}},"required":["csv_path"],"title":"get_csv_infoArguments"}}},{"type":"function","function":{"name":"mcp__msprof-mcp__get_flow_data","description":"mcp__msprof-mcp__get_flow_data","parameters":{"type":"object","properties":{"trace_path":{"title":"Trace Path","type":"string"},"start_time":{"anyOf":[{"type":"integer"},{"type":"number"}],"title":"Start Time"},"end_time":{"anyOf":[{"type":"integer"},{"type":"number"}],"title":"End Time"},"category":{"default":"cpu_op","title":"Category","type":"string"},"result_output_path":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Result Output Path"}},"required":["trace_path","start_time","end_time"],"title":"get_flow_dataArguments"}}},{"type":"function","function":{"name":"mcp__msprof-mcp__get_op_type_details","description":"mcp__msprof-mcp__get_op_type_details","parameters":{"type":"object","properties":{"csv_path":{"title":"Csv Path","type":"string"},"op_type":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Op Type"},"core_type":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Core Type"}},"required":["csv_path"],"title":"get_op_type_detailsArguments"}}},{"type":"function","function":{"name":"mcp__msprof-mcp__get_operator_details","description":"mcp__msprof-mcp__get_operator_details","parameters":{"type":"object","properties":{"csv_path":{"title":"Csv Path","type":"string"},"operator_name":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Operator Name"},"operator_type":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Operator Type"},"limit":{"default":100,"title":"Limit","type":"integer"}},"required":["csv_path"],"title":"get_operator_detailsArguments"}}},{"type":"function","function":{"name":"mcp__msprof-mcp__get_profiler_config","description":"mcp__msprof-mcp__get_profiler_config","parameters":{"type":"object","properties":{"json_path":{"title":"Json Path","type":"string"}},"required":["json_path"],"title":"get_profiler_configArguments"}}},{"type":"function","function":{"name":"mcp__msprof-mcp__search_csv_by_field","description":"mcp__msprof-mcp__search_csv_by_field","parameters":{"type":"object","properties":{"csv_path":{"title":"Csv Path","type":"string"},"field_name":{"title":"Field Name","type":"string"},"field_value":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Field Value"},"match_mode":{"default":"exact","title":"Match Mode","type":"string"},"limit":{"default":100,"title":"Limit","type":"integer"}},"required":["csv_path","field_name"],"title":"search_csv_by_fieldArguments"}}}],"max_tokens":32000,"reasoning_effort":"medium","stream":true,"stream_options":{"include_usage":true}}