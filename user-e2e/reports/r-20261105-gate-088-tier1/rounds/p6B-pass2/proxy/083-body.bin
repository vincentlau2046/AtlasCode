_example_apt.cpp\n/home/vince/.claude/jobs/09264df0/tmp/gate-088/tier1/p6B-pass2/agent-skills/official/CANNBot/ops/ascendc-registry-invoke-template/references/add_example/tests/ut/op_host/test_add_example_infershape.cpp\n/home/vince/.claude/jobs/09264df0/tmp/gate-088/tier1/p6B-pass2/agent-skills/official/CANNBot/ops/ascendc-registry-invoke-template/references/add_example/tests/ut/op_host/test_op_host_main.cpp\n/home/vince/.claude/jobs/09264df0/tmp/gate-088/tier1/p6B-pass2/agent-skills/official/CANNBot/ops/ascendc-registry-invoke-template/references/add_example/tests/ut/op_host/test_add_example_tiling.cpp\n/home/vince/.claude/jobs/09264df0/tmp/gate-088/tier1/p6B-pass2/agent-skills/official/CANNBot/ops/ascendc-registry-invoke-template/references/add_example/tests/ut/common/tiling_case_executor.cpp\n/home/vince/.claude/jobs/09264df0/tmp/gate-088/tier1/p6B-pass2/agent-skills/official/CANNBot/ops/ascendc-registry-invoke-template/references/add_example/tests/ut/common/infershape_context_faker.cpp\n/home/vince/.claude/jobs/09264df0/tmp/gate-088/tier1/p6B-pass2/agent-skills/official/CANNBot/ops/ascendc-registry-invoke-template/references/add_example/tests/ut/common/infershape_case_executor.cpp\n/home/vince/.claude/jobs/09264df0/tmp/gate-088/tier1/p6B-pass2/agent-skills/official/CANNBot/ops/ascendc-registry-invoke-template/references/add_example/tests/ut/common/tiling_context_faker.cpp\n/home/vince/.claude/jobs/09264df0/tmp/gate-088/tier1/p6B-pass2/agent-skills/official/CANNBot/ops/ascendc-registry-invoke-template/references/add_example/tests/st/test_aclnn_add_example.cpp\n/home/vince/.claude/jobs/09264df0/tmp/gate-088/tier1/p6B-pass2/agent-skills/official/CANNBot/ops/ascendc-registry-invoke-template/references/add_example/tests/ut/op_api/test_op_api_main.cpp\n/home/vince/.claude/jobs/09264df0/tmp/gate-088/tier1/p6B-pass2/agent-skills/official/CANNBot/ops/ascendc-registry-invoke-template/references/add_example/tests/ut/op_api/test_aclnn_add_example.cpp\n/home/vince/.claude/jobs/09264df0/tmp/gate-088/tier1/p6B-pass2/agent-skills/official/CANNBot/ops/ascendc-registry-invoke-template/references/add_example/tests/ut/op_api/test_add_example.cpp\n/home/vince/.claude/jobs/09264df0/tmp/gate-088/tier1/p6B-pass2/agent-skills/official/CANNBot/ops/ascendc-registry-invoke-template/references/add_example/tests/st/torch/torch_adapter.cpp\n/home/vince/.claude/jobs/09264df0/tmp/gate-088/tier1/p6B-pass2/agent-skills/official/CANNBot/ops/ascendc-registry-invoke-template/references/atvoss_add_example/tests/ut/op_host/test_add_example_tiling.cpp"},{"role":"assistant","content":null,"tool_calls":[{"id":"chatcmpl-tool-986f49f5f826fcc9","type":"function","function":{"name":"Read","arguments":"{\"file_path\":\"/home/vince/.claude/jobs/09264df0/tmp/gate-088/tier1/p6B-pass2/agent-skills/community/Op/ascendc-operator-code-gen/templates/matmul_op_kernel.cpp\"}"}}]},{"role":"tool","tool_call_id":"chatcmpl-tool-986f49f5f826fcc9","content":"1\t// Licensed under the BSD 3-Clause License  (the \"License\");\n2\t// you may not use this file except in compliance with the License.\n3\t// You may obtain a copy of the License at\n4\t//\n5\t//     https://opensource.org/licenses/BSD-3-Clause\n6\t//\n7\t// Unless required by applicable law or agreed to in writing, software\n8\t// distributed under the License is distributed on an \"AS IS\" BASIS,\n9\t// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n10\t// See the License for the specific language governing permissions and\n11\t// limitations under the License.\n12\t\n13\t// ============================================================\n14\t// MatMul / BatchMatMul 算子 op_kernel 参考模板\n15\t//\n16\t// 本文件给出 **两种** 模板：\n17\t//   A. 编译期 trans 模板 + 12-entry 宏（无 bias，覆盖 fp16/bf16/fp32 × FF/FT/TF/TT）\n18\t//      ── 推荐用于支持运行时 (transpose_a, transpose_b) 的自定义 matmul\n19\t//      ── 真实落地参考 ascend-kernel/csrc/ops/matmul/op_kernel/kernel_matmul.cpp\n20\t//   B. 单 trans 简化模板 + bias（仅 dtype 维度的 3-entry）\n21\t//      ── 适用于 transA/B 编译期固定、需要 bias 的场景\n22\t//\n23\t// 通用流程（详见 references/matmul-tiling.md）:\n24\t//\n25\t// MatmulConfig 选择规则:\n26\t//   * **MM_CFG_NO_PRELOAD（enUnitFlag=true）是大多数自定义算子的默认**\n27\t//   * 缺少 enUnitFlag 会导致 cube 不把 L0C 写回 GM → 输出全零\n28\t//   * Split-K 用 ATOMIC_ADD + Iterate（不是 IterateAll）\n29\t//   * BatchMatMul 用 MM_CFG_ORDER_M\n30\t//\n31\t// 编译期 trans 标志的硬性约束:\n32\t//   * MatmulType<TPos, Format, T, IS_TRANS> 第 4 参数 IS_TRANS 是 constexpr bool；\n33\t//     SetTensorA(gm, isTrans) 的运行时 arg 必须与该 IS_TRANS 完全一致，否则 cube\n34\t//     内部 NZ 分形 / L1 双缓冲深度按错的方向计算，结果偏移错位 / NaN。\n35\t//   * 要支持运行时 (transA, transB) 的 4 种组合 × 3 种 dtype，必须铺 12 个\n36\t//     extern \"C\" 入口（见模板 A）。\n37\t//\n38\t// GM 偏移表（C 始终非转置）:\n39\t//   transA=false: A is [M,K]  → offsetA = mIdx*singleCoreM*K\n40\t//   transA=true : A is [K,M]  → offsetA = mIdx*singleCoreM\n41\t//   transB=false: B is [K,N]  → offsetB = nIdx*singleCoreN\n42\t//   transB=true : B is [N,K]  → offsetB = nIdx*singleCoreN*K\n43\t//   C (always)  :              offsetC = mIdx*singleCoreM*N + nIdx*singleCoreN\n44\t//\n45\t// 数据搬运规则（必读 references/data-copy-api.md）:\n46\t// ============================================================\n47\t\n48\t#include \"kernel_operator.h\"\n49\t#include \"lib/matmul_intf.h\"\n50\t\n51\t#include \"<op_name>_tiling_header.h\"\n52\t\n53\tusing namespace AscendC;\n54\tusing namespace matmul;\n55\t\n56\tnamespace {\n57\t\n58\t// ============================================================\n59\t// MatmulConfig：来自 ops-nn/matmul/mat_mul_v3/op_kernel/mat_mul_v3_common.h\n60\t// ============================================================\n61\t\n62\t// 自定义算子默认配置：\n63\t//   enUnitFlag=true ── 使能 L0C → fixpipe → GM 的写回单元\n64\t//                       缺这个 flag 会导致 IterateAll/GetTensorC 无效，输出全零\n65\tconstexpr MatmulConfig MM_CFG_NO_PRELOAD =\n66\t    GetMDLConfig(/*enableMixDualMaster=*/false,\n67\t                 /*enableUnitFlag=*/false,\n68\t                 /*doMTE2Preload=*/0,\n69\t                 /*isVecND2Nz=*/false,\n70\t                 /*isPerTensor=*/false,\n71\t                 /*isSplitK=*/false,\n72\t                 /*enUnitFlag=*/true);\n73\t\n74\t// BatchMatMul 推荐配置（M-first 内层遍历 + IterateBatch 接口）\n75\tconstexpr MatmulConfig MM_CFG_BMM_ORDER_M =\n76\t    GetNormalConfig(/*intrablockPartSum=*/false,\n77\t                    /*enableUnitFlag=*/false,\n78\t                    /*enableMixDualMaster=*/false,\n79\t                    /*batchMode=*/BatchMode::BATCH_LESS_THAN_L1,\n80\t                    /*isPerTensor=*/true,\n81\t                    /*iterateOrder=*/IterateOrder::ORDER_M);\n82\t\n83\t// ============================================================\n84\t// 工具函数：把 TilingHeader 从 GM 拷到 stack（4-byte 对齐标量读）\n85\t// ============================================================\n86\t//\n87\ttemplate <typename HeaderT>\n88\t__aicore__ inline void LoadTilingFromGM(GM_ADDR tilingGM, HeaderT &dstStack)\n89\t{\n90\t    static_assert(alignof(HeaderT) % sizeof(int32_t) == 0,\n91\t                  \"TilingHeader must be 4-byte aligned for int32-wise GM scalar reads\");\n92\t\n93\t    constexpr uint32_t HEADER_BYTES = sizeof(HeaderT);\n94\t    constexpr uint32_t HEADER_INTS  = (HEADER_BYTES + sizeof(int32_t) - 1U) / sizeof(int32_t);\n95\t\n96\t    const auto *gmInts  = reinterpret_cast<const __gm__ int32_t *>(tilingGM);\n97\t    auto       *dstInts = reinterpret_cast<int32_t *>(&dstStack);\n98\t    for (uint32_t i = 0; i < HEADER_INTS; ++i) {\n99\t        dstInts[i] = gmInts[i];\n100\t    }\n101\t}\n102\t\n103\t}  // namespace\n104\t\n105\t// ============================================================\n106\t// 模板 A：编译期 trans 模板 + 12-entry（无 bias，推荐用于 plain matmul / linear）\n107\t//\n108\t// 适用场景：\n109\t//   - 需要支持运行时 (transpose_a, transpose_b) 全部 4 种组合\n110\t//   - 不带 bias 的 plain matmul / linear（Q·K^T、纯 MM 等）\n111\t//   - 不需要 L2 / Split-K（小算子）\n112\t//\n113\t// 核心设计：\n114\t//   1. trans 是模板参数（TRANS_A、TRANS_B），与 MatmulType<...IS_TRANS> 模板参数\n115\t//      和 SetTensorA(gm, isTrans) 运行时 arg 三处保持完全一致（cube 内部 NZ 分形\n116\t//      会按编译期 IS_TRANS 计算，运行时 arg 不一致会输出错位/NaN）。\n117\t//   2. BIAS_TYPE 仍要传 MatmulType<...float>（cube 内部按 isBias 标志判定是否\n118\t//      真的 SetBias，但模板参数不能省 — 三参数 MatmulImpl<A,B,C> 在部分 SoC 编译失败）。\n119\t//   3. 用宏 MATMUL_KERNEL_ENTRIES(DTYPE_TAG, T) 一次铺开 4 个 trans 组合的 entry，\n120\t//      3 种 dtype 共 12 个入口。\n121\t// ============================================================\n122\ttemplate <typename T, bool TRANS_A, bool TRANS_B>\n123\tclass <OpName>KernelImplTrans {\n124\tpublic:\n125\t    using Header = ascend_kernel::<op_name>_op::TilingHeader;\n126\t\n127\t    using A_TYPE    = MatmulType<TPosition::GM, CubeFormat::ND, T,     TRANS_A>;\n128\t    using B_TYPE    = MatmulType<TPosition::GM, CubeFormat::ND, T,     TRANS_B>;\n129\t    using C_TYPE    = MatmulType<TPosition::GM, CubeFormat::ND, T,     /*isTrans=*/false>;\n130\t    using BIAS_TYPE = MatmulType<TPosition::GM, CubeFormat::ND, float, /*isTrans=*/false>;\n131\t\n132\t    __aicore__ inline <OpName>KernelImplTrans() {}\n133\t\n134\t    __aicore__ inline void Init(GM_ADDR aGM, GM_ADDR bGM,\n135\t                                GM_ADDR cGM, GM_ADDR tilingGM, TPipe *pipe)\n136\t    {\n137\t        if ASCEND_IS_AIV { return; }\n138\t        pipe_ = pipe;\n139\t\n140\t        LoadTilingFromGM<Header>(tilingGM, header_);\n141\t\n142\t        const int32_t M = header_.cubeTiling.M;\n143\t        const int32_t N = header_.cubeTiling.N;\n144\t        const int32_t K = header_.cubeTiling.Ka;\n145\t\n146\t        aGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(aGM),\n147\t                             static_cast<uint64_t>(M) * static_cast<uint64_t>(K));\n148\t        bGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(bGM),\n149\t                             static_cast<uint64_t>(K) * static_cast<uint64_t>(N));\n150\t        cGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(cGM),\n151\t                             static_cast<uint64_t>(M) * static_cast<uint64_t>(N));\n152\t\n153\t        mm_.SetSubBlockIdx(0);\n154\t        mm_.Init(&header_.cubeTiling, pipe_);\n155\t\n156\t        // KEEP_FLOAT_DTYPE (CubeMathType=4)：FP32 走 4-way FP16 high/low 分解全精度路径\n157\t        // 与 host SetMadType(NORMAL) 配对；改 SetHF32(true, 1) 切到 HF32（cube ≈ 4× 吞吐，\n158\t        // 精度从 ~23-bit mantissa 降至 ~10-bit）。\n159\t        mm_.SetHF32(false, 0);\n160\t    }\n161\t\n162\t    __aicore__ inline void Process()\n163\t    {\n164\t        if ASCEND_IS_AIV { return; }\n165\t\n166\t        const int32_t blockIdx   = static_cast<int32_t>(GetBlockIdx());\n167\t        const int32_t totalBlock = header_.totalBlock;\n168\t        if (blockIdx >= totalBlock) return;            // 越界守卫：blockDim 可能 > totalBlock\n169\t\n170\t        const int32_t mTotalCnt = header_.mTotalCnt;\n171\t        const int32_t nTotalCnt = header_.nTotalCnt;\n172\t        const int32_t mIdx      = blockIdx / nTotalCnt;\n173\t        const int32_t nIdx      = blockIdx % nTotalCnt;\n174\t\n175\t        const int32_t M           = header_.cubeTiling.M;\n176\t        const int32_t N           = header_.cubeTiling.N;\n177\t        const int32_t K           = header_.cubeTiling.Ka;\n178\t        const int32_t singleCoreM = header_.cubeTiling.singleCoreM;\n179\t        const int32_t singleCoreN = header_.cubeTiling.singleCoreN;\n180\t        const int32_t curSingleM  = (mIdx == mTotalCnt - 1) ? (M - mIdx * singleCoreM) : singleCoreM;\n181\t        const int32_t curSingleN  = (nIdx == nTotalCnt - 1) ? (N - nIdx * singleCoreN) : singleCoreN;\n182\t\n183\t        // 编译期 trans 决定 GM 偏移公式（详见文件头部\"GM 偏移表\"）\n184\t        const uint64_t offsetA = TRANS_A\n185\t            ? static_cast<uint64_t>(mIdx) * static_cast<uint64_t>(singleCoreM)\n186\t            : static_cast<uint64_t>(mIdx) * static_cast<uint64_t>(singleCoreM)\n187\t                                          * static_cast<uint64_t>(K);\n188\t        const uint64_t offsetB = TRANS_B\n189\t            ? static_cast<uint64_t>(nIdx) * static_cast<uint64_t>(singleCoreN)\n190\t                                          * static_cast<uint64_t>(K)\n191\t            : static_cast<uint64_t>(nIdx) * static_cast<uint64_t>(singleCoreN);\n192\t        const uint64_t offsetC = static_cast<uint64_t>(mIdx) * static_cast<uint64_t>(singleCoreM)\n193\t                                                             * static_cast<uint64_t>(N)\n194\t                               + static_cast<uint64_t>(nIdx) * static_cast<uint64_t>(singleCoreN);\n195\t\n196\t        mm_.SetSingleShape(curSingleM, curSingleN, K);\n197\t        mm_.SetTensorA(aGm_[offsetA], TRANS_A);   // 运行时 arg == 编译期 IS_TRANS（强约束）\n198\t        mm_.SetTensorB(bGm_[offsetB], TRANS_B);\n199\t        mm_.IterateAll(cGm_[offsetC], /*enAtomic=*/0);\n200\t\n201\t        PipeBarrier<PIPE_ALL>();\n202\t        SetAtomicNone();\n203\t    }\n204\t\n205\t    __aicore__ inline void End() { mm_.End(); }\n206\t\n207\tprivate:\n208\t    TPipe              *pipe_ = nullptr;\n209\t    Header              header_{};\n210\t    GlobalTensor<T>     aGm_;\n211\t    GlobalTensor<T>     bGm_;\n212\t    GlobalTensor<T>     cGm_;\n213\t    MatmulImpl<A_TYPE, B_TYPE, C_TYPE, BIAS_TYPE, MM_CFG_NO_PRELOAD> mm_;\n214\t};\n215\t\n216\t// 用宏一次铺开 4 个 trans 组合 × 一种 dtype = 4 个 entry。\n217\t// host 端按 (a.scalar_type(), transpose_a, transpose_b) 选择对应入口。\n218\t//\n219\t// 命名约定：<op>_<dtype>_<ta><tb>，其中 t/f 表示 true/false：\n220\t//   <op>_fp16_ff = (transA=false, transB=false)\n221\t//   <op>_fp16_ft = (transA=false, transB=true )\n222\t//   <op>_fp16_tf = (transA=true , transB=false)\n223\t//   <op>_fp16_tt = (transA=true , transB=true )\n224\t#define MATMUL_KERNEL_ENTRIES(DTYPE_TAG, T)                                                       \\\n225\t    extern \"C\" __global__ __aicore__ void <op_name>_##DTYPE_TAG##_ff(                             \\\n226\t        GM_ADDR aGM, GM_ADDR bGM, GM_ADDR cGM, GM_ADDR tilingGM)                                  \\\n227\t    {                                                                                             \\\n228\t        TPipe pipe;                                                                               \\\n229\t        <OpName>KernelImplTrans<T, false, false> op;                                              \\\n230\t        op.Init(aGM, bGM, cGM, tilingGM, &pipe);                                                  \\\n231\t        op.Process();                                                                             \\\n232\t        op.End();   /* 必加：释放 cube L1/L0 句柄 */                                               \\\n233\t    }                                                                                             \\\n234\t    extern \"C\" __global__ __aicore__ void <op_name>_##DTYPE_TAG##_ft(                             \\\n235\t        GM_ADDR aGM, GM_ADDR bGM, GM_ADDR cGM, GM_ADDR tilingGM)                                  \\\n236\t    {                                                                                             \\\n237\t        TPipe pipe;                                                                               \\\n238\t        <OpName>KernelImplTrans<T, false, true> op;                                               \\\n239\t        op.Init(aGM, bGM, cGM, tilingGM, &pipe);                                                  \\\n240\t        op.Process();                                                                             \\\n241\t        op.End();                                                                                 \\\n242\t    }                                                                                             \\\n243\t    extern \"C\" __global__ __aicore__ void <op_name>_##DTYPE_TAG##_tf(                             \\\n244\t        GM_ADDR aGM, GM_ADDR bGM, GM_ADDR cGM, GM_ADDR tilingGM)                                  \\\n245\t    {                                                                                             \\\n246\t        TPipe pipe;                                                                               \\\n247\t        <OpName>KernelImplTrans<T, true, false> op;                                               \\\n248\t        op.Init(aGM, bGM, cGM, tilingGM, &pipe);                                                  \\\n249\t        op.Process();                                                                             \\\n250\t        op.End();                                                                                 \\\n251\t    }                                                                                             \\\n252\t    extern \"C\" __global__ __aicore__ void <op_name>_##DTYPE_TAG##_tt(                             \\\n253\t        GM_ADDR aGM, GM_ADDR bGM, GM_ADDR cGM, GM_ADDR tilingGM)                                  \\\n254\t    {                                                                                             \\\n255\t        TPipe pipe;                                                                               \\\n256\t        <OpName>KernelImplTrans<T, true, true> op;                                                \\\n257\t        op.Init(aGM, bGM, cGM, tilingGM, &pipe);                                                  \\\n258\t        op.Process();                                                                             \\\n259\t        op.End();                                                                                 \\\n260\t    }\n261\t\n262\tMATMUL_KERNEL_ENTRIES(fp16, half)\n263\tMATMUL_KERNEL_ENTRIES(bf16, bfloat16_t)\n264\tMATMUL_KERNEL_ENTRIES(fp32, float)\n265\t\n266\t#undef MATMUL_KERNEL_ENTRIES\n267\t\n268\t// ============================================================\n269\t// 模板 B：单 trans 简化模板 + bias（trans 编译期固定，3-entry）\n270\t//\n271\t// 适用场景：\n272\t//   - trans_a / trans_b 在算子设计阶段已固定（如 BMM 总是 transB=true）\n273\t//   - 需要 bias\n274\t//   - 不需要 L2 级切分（M*N*dtype ≤ L2/2）\n275\t//   - 不需要 Split-K\n276\t//   - 单 batch\n277\t//\n278\t// 大算子骨架请参考 mat_mul_base_kernel.h 的 L2 双层循环版本。\n279\t// ============================================================\n280\ttemplate <typename T, typename BiasT = float>\n281\tclass <OpName>KernelImpl {\n282\tpublic:\n283\t    using Header   = ascend_kernel::<op_name>_op::TilingHeader;\n284\t\n285\t    using A_TYPE    = MatmulType<TPosition::GM, CubeFormat::ND, T,     /*isTrans=*/false>;\n286\t    using B_TYPE    = MatmulType<TPosition::GM, CubeFormat::ND, T,     /*isTrans=*/false>;\n287\t    using C_TYPE    = MatmulType<TPosition::GM, CubeFormat::ND, T,     /*isTrans=*/false>;\n288\t    using BIAS_TYPE = MatmulType<TPosition::GM, CubeFormat::ND, BiasT, /*isTrans=*/false>;\n289\t\n290\t    __aicore__ inline <OpName>KernelImpl() {}\n291\t\n292\t    __aicore__ inline void Init(GM_ADDR aGM, GM_ADDR bGM, GM_ADDR biasGM,\n293\t                                 GM_ADDR cGM, GM_ADDR tilingGM, TPipe *pipe)\n294\t    {\n295\t        if ASCEND_IS_AIV {\n296\t            return;  // 仅 Cube 执行\n297\t        }\n298\t        pipe_ = pipe;\n299\t\n300\t        // 1. GM → stack TilingHeader（4-byte 标量读）\n301\t        LoadTilingFromGM<Header>(tilingGM, header_);\n302\t\n303\t        const int32_t M = header_.cubeTiling.M;\n304\t        const int32_t N = header_.cubeTiling.N;\n305\t        const int32_t K = header_.cubeTiling.Ka;\n306\t\n307\t        // 2. GlobalTensor 视图\n308\t        aGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(aGM),\n309\t                             static_cast<uint64_t>(M) * K);\n310\t        bGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(bGM),\n311\t                             static_cast<uint64_t>(K) * N);\n312\t        cGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(cGM),\n313\t                             static_cast<uint64_t>(M) * N);\n314\t        if (header_.cubeTiling.isBias) {\n315\t            biasGm_.SetGlobalBuffer(reinterpret_cast<__gm__ BiasT *>(biasGM), N);\n316\t        }\n317\t\n318\t        // 3. MatmulImpl 初始化（&header_.cubeTiling 是 stack 指针，安全）\n319\t        mm_.SetSubBlockIdx(0);\n320\t        mm_.Init(&header_.cubeTiling, pipe_);\n321\t\n322\t        // 4. 显式禁用 HF32 = CubeMathType=4 (KEEP_FLOAT_DTYPE)\n323\t        //\n324\t        // 默认情况下 cube 的 SetHF32 行为依赖编译期/运行期推断；为保证\n325\t        //   - FP32 输入走全 23-bit mantissa 路径（4-way FP16-high/low decomp）；\n326\t        //   - SKILL ascendc-operator-precision-eval 的 FP32 阈值\n327\t        //     (Threshold = 2^-13 ≈ 1.22e-4) 可被通过；\n328\t        //   - 与 `torch.mm/torch.bmm`（allow_hf32=False）输出一致；\n329\t        // 我们对所有 dtype 都显式 SetHF32(false, 0)。\n330\t        //\n331\t        // 若性能优先而精度允许 ~10-bit mantissa（如训练前向 / Attention QK），\n332\t        // 可改为 SetHF32(true, 1) 走 HF32 单 pass cube 路径，cube 吞吐 ≈ 4x。\n333\t        mm_.SetHF32(false, 0);\n334\t    }\n335\t\n336\t    __aicore__ inline void Process()\n337\t    {\n338\t        if ASCEND_IS_AIV {\n339\t            return;\n340\t        }\n341\t\n342\t        // 1. 越界守卫：blockDim 可能 > totalBlock\n343\t        const int32_t blockIdx   = static_cast<int32_t>(GetBlockIdx());\n344\t        const int32_t totalBlock = header_.totalBlock;\n345\t        if (blockIdx >= totalBlock) {\n346\t            return;\n347\t        }\n348\t\n349\t        // 2. blockIdx → (mIdx, nIdx)\n350\t        const int32_t mTotalCnt = header_.mTotalCnt;\n351\t        const int32_t nTotalCnt = header_.nTotalCnt;\n352\t        const int32_t mIdx      = blockIdx / nTotalCnt;\n353\t        const int32_t nIdx      = blockIdx % nTotalCnt;\n354\t\n355\t        // 3. 尾块尺寸（最后一行/列实际大小）\n356\t        const int32_t M           = header_.cubeTiling.M;\n357\t        const int32_t N           = header_.cubeTiling.N;\n358\t        const int32_t K           = header_.cubeTiling.Ka;\n359\t        const int32_t singleCoreM = header_.cubeTiling.singleCoreM;\n360\t        const int32_t singleCoreN = header_.cubeTiling.singleCoreN;\n361\t        const int32_t curSingleM  = (mIdx == mTotalCnt - 1) ? (M - mIdx * singleCoreM) : singleCoreM;\n362\t        const int32_t curSingleN  = (nIdx == nTotalCnt - 1) ? (N - nIdx * singleCoreN) : singleCoreN;\n363\t\n364\t        // 4. GM 偏移\n365\t        const uint64_t offsetA = static_cast<uint64_t>(mIdx) * singleCoreM * K;\n366\t        const uint64_t offsetB = static_cast<uint64_t>(nIdx) * singleCoreN;\n367\t        const uint64_t offsetC = static_cast<uint64_t>(mIdx) * singleCoreM * N\n368\t                               + static_cast<uint64_t>(nIdx) * singleCoreN;\n369\t\n370\t        // 5. 配置 cube 输入并触发计算\n371\t        mm_.SetSingleShape(curSingleM, curSingleN, K);\n372\t        mm_.SetTensorA(aGm_[offsetA], /*isTrans=*/false);\n373\t        mm_.SetTensorB(bGm_[offsetB], /*isTrans=*/false);\n374\t        if (header_.cubeTiling.isBias) {\n375\t            const uint64_t offsetBias = static_cast<uint64_t>(nIdx) * singleCoreN;\n376\t            mm_.SetBias(biasGm_[offsetBias]);\n377\t        }\n378\t        // IterateAll 内部完成 single-core tile 内所有 base 块的 cube 调度 + 写回 GM\n379\t        mm_.IterateAll(cGm_[offsetC], /*enAtomic=*/0);\n380\t\n381\t        // 6. 收尾\n382\t        PipeBarrier<PIPE_ALL>();\n383\t        SetAtomicNone();\n384\t    }\n385\t\n386\t    __aicore__ inline void End() { mm_.End(); }\n387\t\n388\tprivate:\n389\t    TPipe              *pipe_ = nullptr;\n390\t    Header              header_{};             // stack-resident, scalar-addressable for MatmulImpl::Init\n391\t    GlobalTensor<T>     aGm_;\n392\t    GlobalTensor<T>     bGm_;\n393\t    GlobalTensor<T>     cGm_;\n394\t    GlobalTensor<BiasT> biasGm_;\n395\t    MatmulImpl<A_TYPE, B_TYPE, C_TYPE, BIAS_TYPE, MM_CFG_NO_PRELOAD> mm_;\n396\t};\n397\t\n398\t// ============================================================\n399\t// 入口函数：每种 dtype 一个 extern \"C\" 入口\n400\t// ============================================================\n401\textern \"C\" __global__ __aicore__ void <op_name>_bias_fp16(\n402\t    GM_ADDR aGM, GM_ADDR bGM, GM_ADDR biasGM, GM_ADDR cGM, GM_ADDR tilingGM)\n403\t{\n404\t    TPipe pipe;\n405\t    <OpName>KernelImpl<half> op;\n406\t    op.Init(aGM, bGM, biasGM, cGM, tilingGM, &pipe);\n407\t    op.Process();\n408\t    op.End();   // 必加：释放 cube L1/L0 句柄；漏掉会让多次连续调用累积 L1 句柄泄露\n409\t}\n410\t\n411\textern \"C\" __global__ __aicore__ void <op_name>_bias_bf16(\n412\t    GM_ADDR aGM, GM_ADDR bGM, GM_ADDR biasGM, GM_ADDR cGM, GM_ADDR tilingGM)\n413\t{\n414\t    TPipe pipe;\n415\t    <OpName>KernelImpl<bfloat16_t> op;\n416\t    op.Init(aGM, bGM, biasGM, cGM, tilingGM, &pipe);\n417\t    op.Process();\n418\t    op.End();\n419\t}\n420\t\n421\textern \"C\" __global__ __aicore__ void <op_name>_bias_fp32(\n422\t    GM_ADDR aGM, GM_ADDR bGM, GM_ADDR biasGM, GM_ADDR cGM, GM_ADDR tilingGM)\n423\t{\n424\t    TPipe pipe;\n425\t    <OpName>KernelImpl<float> op;\n426\t    op.Init(aGM, bGM, biasGM, cGM, tilingGM, &pipe);\n427\t    op.Process();\n428\t    op.End();\n429\t}\n430\t\n431\t// ============================================================\n432\t// 大算子完整 L2+Block+BaseBlock 三级骨架（参考结构，按需实例化）\n433\t// ============================================================\n434\t//\n435\t// template <class A_TYPE, class B_TYPE, class C_TYPE, class BIAS_TYPE,\n436\t//           class BLOCK_TYPE = MatmulBaseBlock,\n437\t//           const MatmulConfig &MM_CFG = MM_CFG_NO_PRELOAD>\n438\t// class MatmulFullKernel {\n439\t// public:\n440\t//     __aicore__ inline void Process(uint64_t index = 0, uint8_t enAtomic = 0) {\n441\t//         if ASCEND_IS_AIV { return; }\n442\t//         mm_.SetHF32(false, 0);\n443\t//         if (block_.params_.isHf32) mm_.SetHF32(true, 1);\n444\t//\n445\t//         bool reverse = true;\n446\t//         for (uint64_t mTile = 0; mTile < block_.params_.mTileCntL2; ++mTile) {\n447\t//             reverse = !reverse;\n448\t//             for (uint64_t t = 0; t < block_.params_.nTileCntL2; ++t) {\n449\t//                 uint64_t nTile = reverse\n450\t//                     ? (block_.params_.nTileCntL2 - t - 1)\n451\t//                     : t;                                           // serpentine\n452\t//                 block_.UpdateBlockCnt(mTile, nTile);\n453\t//                 block_.InitBlockIndex(index);\n454\t//                 for (uint64_t r = 0; r < block_.params_.realRound; ++r) {\n455\t//                     if (block_.params_.rowOrder == 0) {\n456\t//                         block_.UpdateBasicIndex(r);                // 错位分核\n457\t//                     }\n458\t//                     if (block_.params_.index < block_.params_.totalTileCnt) {\n459\t//                         block_.UpdateBlockParams(mTile, nTile);\n460\t//                         block_.template CalcGMOffset<A_TYPE,B_TYPE,C_TYPE,BIAS_TYPE>(\n461\t//                             mTile, nTile);\n462\t//                         mm_.SetSingleShape(block_.params_.singleCoreM,\n463\t//                                            block_.params_.singleCoreN,\n464\t//                                            block_.matmulTilingData_->matmulTiling.singleCoreK);\n465\t//                         mm_.SetTensorA(aGm_[block_.offset_.offsetA], block_.params_.isTransposeA);\n466\t//                         mm_.SetTensorB(bGm_[block_.offset_.offsetB], block_.params_.isTransposeB);\n467\t//                         if (block_.matmulTilingData_->matmulTiling.isBias) {\n468\t//                             mm_.SetBias(biasGm_[block_.offset_.offsetBias]);\n469\t//                         }\n470\t//                         mm_.Iterate();                              // 单 base 块\n471\t//                         mm_.GetTensorC(cGm_[block_.offset_.offsetC], enAtomic);\n472\t//                     }\n473\t//                     block_.UpdateBlockIndex();\n474\t//                 }\n475\t//             }\n476\t//         }\n477\t//         PipeBarrier<PIPE_ALL>();\n478\t//         SetAtomicNone();\n479\t//         mm_.SetHF32(false, 0);\n480\t//     }\n481\t// };\n482\t//\n483\t\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"},{"role":"assistant","content":null,"tool_calls":[{"id":"chatcmpl-tool-a5d6996b5e79bd81","type":"function","function":{"name":"TaskUpdate","arguments":"{\"status\":\"completed\",\"taskId\":\"1\"}"}},{"id":"chatcmpl-tool-a502f388aa4ecb2a","type":"function","function":{"name":"TaskUpdate","arguments":"{\"status\":\"in_progress\",\"taskId\":\"2\"}"}}]},{"role":"tool","tool_call_id":"chatcmpl-tool-a5d6996b5e79bd81","content":"Updated task #1 status"},{"role":"tool","tool_call_id":"chatcmpl-tool-a502f388aa4ecb2a","content":"Updated task #2 status"},{"role":"assistant","content":null,"tool_calls":[{"id":"chatcmpl-tool-aa0c56c824e59ec0","type":"function","function":{"name":"Read","arguments":"{\"file_path\":\"/home/vince/.claude/jobs/09264df0/tmp/gate-088/tier1/p6B-pass2/agent-skills/community/Op/ascendc-operator-code-gen/references/matmul-compute-api.md\",\"limit\":120}"}}]},{"role":"tool","tool_call_id":"chatcmpl-tool-aa0c56c824e59ec0","content":"1\t# AscendC MatMul 类算子 API 参考（纯 CUBE 路径）\n2\t\n3\t本文档覆盖 AscendC 中 **基于 `MatmulImpl`** 的纯 Cube 算子的高阶 API，适用于 MatMul / BatchMatMul / MatMulAdd 等单组矩阵乘算子。\n4\t\n5\t> 与本目录其他参考文档关系：\n6\t> - 数据搬运 / 基础数据结构：本目录 `data-copy-api.md`、`basic-data-structures-api.md`\n7\t> - 资源管理（TPipe/TQue/TBuf/UB 容量）：本目录 `resource-management-api.md`\n8\t> - kernel 通用约束：本目录 `kernel-constraints.md`\n9\t\n10\t\n11\t## 目录\n12\t\n13\t- [1. MatMul 类算子全景](#1-matmul-类算子全景)\n14\t- [2. 基础概念](#2-基础概念)\n15\t- [3. MatmulImpl API](#3-matmulimpl-api)\n16\t  - [3.6 完整 Kernel 骨架（L2 / Split-K / Batch）](#36-完整-kernel-骨架l2--split-k--batch)\n17\t- [4. Tiling Header GM → stack 装载](#4-tiling-header-gm--stack-装载)\n18\t  - [4.4 反模式（必须避免）](#44-反模式必须避免)\n19\t- [5. AIC / AIV 关系与数据类型支持](#5-aic--aiv-关系与数据类型支持)\n20\t- [6. 接口调用流程速查](#6-接口调用流程速查)\n21\t- [7. 常见问题与排错](#7-常见问题与排错)\n22\t\n23\t---\n24\t\n25\t## 1. MatMul 类算子全景\n26\t\n27\t| 子类 | 计算公式 | 高阶 API | Type 包装 | Tiling 入口（host） |\n28\t|------|---------|---------|----------|---------------------|\n29\t| **MatMul** | `C = A · B (+ bias)` | `MatmulImpl<A,B,C,Bias,MM_CFG>` | `MatmulType<TPosition,CubeFormat,T,trans>` | `MultiCoreMatmulTiling::GetTiling(TCubeTiling&)` |\n30\t| **BatchMatMul** | `C[b] = A[b] · B[b]` | 同上（用 `IterateBatch`） | 同上 | 同上 + `SetBatchNum` |\n31\t| **MatMulAdd** | `C = A · B + D` | 同上（外层 atomic add 或 elementwise add） | 同上 | 同上 |\n32\t\n33\t\n34\t---\n35\t\n36\t## 2. 基础概念\n37\t\n38\t### 2.1 TPosition\n39\t\n40\t| 位置 | 说明 | MatMul 算子用途 |\n41\t|------|------|----------------|\n42\t| `TPosition::GM` | 全局内存 | 所有 user-level 输入输出 tensor 的位置 |\n43\t| `TPosition::A1 / B1` | L1 buffer | `MatmulImpl` 内部自动管理 |\n44\t| `TPosition::A2 / B2` | L0A / L0B | 同上 |\n45\t| `TPosition::CO1` | L0C | cube 累加结果，由 fixpipe 写回 |\n46\t| `TPosition::CO2` | UB（仅 vector 后处理路径用） | 纯 CUBE 算子无须显式涉及 |\n47\t\n48\t> User-level 算子 **只在 `TPosition::GM` 上声明 type**；L1/L0/L0C 由 `MatmulImpl::Init` 内部调度。\n49\t\n50\t### 2.2 数据格式枚举\n51\t\n52\t| 体系 | 类型 | 取值 |\n53\t|------|------|------|\n54\t| MatmulImpl | `CubeFormat` | `ND`（行优先）、`NZ`（16×16 fractal）、`Z`、`VECTOR` |\n55\t\n56\t### 2.3 通用对齐约束\n57\t\n58\t```cpp\n59\tALIGNED_H = 16;        // M / K 维度\n60\tc0Size    = 16;        // fp16/bf16 NZ 的 N 维 fractal\n61\tc0Size    = 8;         // fp32 NZ 的 N 维 fractal\n62\t```\n63\t\n64\t---\n65\t\n66\t## 3. MatmulImpl API\n67\t\n68\t> 适用算子：MatMul / BatchMatMul / MatMulAdd / 其他形如 `C = f(A·B + bias)` 的单组矩阵乘算子。\n69\t\n70\t### 3.1 MatmulImpl 模板\n71\t\n72\t```cpp\n73\t#include \"lib/matmul_intf.h\"\n74\tusing namespace matmul;\n75\t\n76\ttemplate <\n77\t    class A_TYPE,                                          // MatmulType<TPosition, CubeFormat, T, isTrans>\n78\t    class B_TYPE,                                          // MatmulType<TPosition, CubeFormat, T, isTrans>\n79\t    class C_TYPE,                                          // MatmulType<TPosition::GM, CubeFormat::ND, T>\n80\t    class BIAS_TYPE,                                       // MatmulType<TPosition::GM, CubeFormat::ND, BiasT>\n81\t    const MatmulConfig& MM_CFG = MM_CFG_NO_PRELOAD,        // 关键：见 §3.3\n82\t    class MM_CB = MatmulCallBackFunc<nullptr,nullptr,nullptr>\n83\t>\n84\tclass MatmulImpl;\n85\t```\n86\t\n87\t```cpp\n88\t// 标准用法\n89\tusing A_TYPE    = MatmulType<TPosition::GM, CubeFormat::ND, half,  /*isTrans=*/false>;\n90\tusing B_TYPE    = MatmulType<TPosition::GM, CubeFormat::ND, half,  /*isTrans=*/false>;\n91\tusing C_TYPE    = MatmulType<TPosition::GM, CubeFormat::ND, half>;\n92\tusing BIAS_TYPE = MatmulType<TPosition::GM, CubeFormat::ND, float>;   // bias 一般 fp32\n93\tMatmulImpl<A_TYPE, B_TYPE, C_TYPE, BIAS_TYPE, MM_CFG_NO_PRELOAD> mm_;\n94\t```\n95\t\n96\t### 3.2 核心方法\n97\t\n98\t| 方法 | 说明 | 调用时机 |\n99\t|------|------|---------|\n100\t| `void Init(const TCubeTiling* tiling, TPipe* pipe)` | 初始化（**tiling 必须是 stack 指针**，见 §4） | 每核 1 次 |\n101\t| `void SetSubBlockIdx(uint32_t idx)` | 设置子块索引 | `Init` 之前；通常 `0` |\n102\t| `void SetHF32(bool enable, uint32_t mode)` | 配置 cube 精度模式（默认 `false,0` = CubeMathType=4 全 FP32；`true,1` = HF32） | 计算前 |\n103\t| `void SetOrgShape(uint32_t oriM, oriN, oriKa, oriKb, oriN2)` | NZ 格式必调；ND 多数情况可省 | 计算前 |\n104\t| `void SetSingleShape(uint32_t singleM, singleN, singleK)` | 当前 single-core tile 的实际尺寸（含尾块） | 每个 tile 之前 |\n105\t| `void SetTensorA(GlobalTensor<A_T>& aGm, bool isTrans)` | 设置 A | 每个 tile |\n106\t| `void SetTensorB(GlobalTensor<B_T>& bGm, bool isTrans)` | 设置 B | 每个 tile |\n107\t| `void SetBias(GlobalTensor<BiasT>& biasGm)` | 设置 bias | 每个 tile（按需） |\n108\t| `void SetBatchNum(uint32_t batchA, batchB)` | BatchMatMul 内层 batch 数 | `IterateBatch` 之前 |\n109\t| `void SetNBatchOutNum(uint64_t batchOutNum)` | 一次 IterateBatch 输出多少个 batch | `IterateBatch` 之前 |\n110\t| `bool Iterate()` | 触发 **一个** baseBlock | Split-K / 显式 atomic 累加 |\n111\t| `void GetTensorC(GlobalTensor<C_T>& cGm, uint8_t enAtomic = 0)` | Iterate 后取回 | 与 `Iterate` 配对；`enAtomic=2` 即 ATOMIC_ADD |\n112\t| `void IterateAll(GlobalTensor<C_T>& cGm, uint8_t enAtomic = 0)` | **遍历当前 single-core tile 的所有 baseBlock 并写回 GM** | 推荐：与 `MM_CFG_NO_PRELOAD` 配合 |\n113\t| `void IterateBatch(...)` | 一次处理多个 batch | BatchMatMul |\n114\t| `void End()` | 结束 + 释放资源 | 每核 1 次 |\n115\t\n116\t### 3.3 MatmulConfig 选择\n117\t\n118\t`MM_CFG` 决定 cube 的搬运、流水、写回行为。\n119\t\n120\t| 配置 | 关键参数 | 用途 |\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"},{"role":"assistant","content":null,"tool_calls":[{"id":"chatcmpl-tool-8ad451985b546910","type":"function","function":{"name":"Read","arguments":"{\"file_path\":\"/home/vince/.claude/jobs/09264df0/tmp/gate-088/tier1/p6B-pass2/agent-skills/community/Op/ascendc-operator-code-gen/references/matmul-compute-api.md\",\"limit\":130,\"offset\":120}"}}]},{"role":"tool","tool_call_id":"chatcmpl-tool-8ad451985b546910","content":"120\t| 配置 | 关键参数 | 用途 |\n121\t|------|---------|------|\n122\t| **`MM_CFG_NO_PRELOAD`** | `enUnitFlag=true` | **大多数自定义算子默认**：使能 fixpipe 把 L0C 写回 GM |\n123\t| `MM_CFG_VEC_ND2NZ` | `isVecND2Nz=true` | A/B 输入 ND，让 vector 在 kernel 内做 ND→NZ |\n124\t| `MM_CFG_PRELOAD_MK` | `doMTE2Preload=2` | M-K 方向预取 A |\n125\t| `MM_CFG_PRELOAD_NK` | `doMTE2Preload=1` | N-K 方向预取 B |\n126\t| `MM_CFG_K_SHIFT` | `kShift=true` | K 方向流水分段 |\n127\t| `MM_CFG_MDL` | 默认 MDL | 简单大算子 |\n128\t| `CFG_MDL` / `NZ_CFG_MDL` | weight 是 NZ 时选 NZ 版 | NZ 输入 |\n129\t| `MM_CFG_ORDER_M` | `IterateOrder::ORDER_M` | BatchMatMul 内层 M 优先 |\n130\t| `MM_CFG_MULTI_BATCH_OUT` | `BatchOutMode::MULTI_BATCH` | BatchMatMul 一次输出多 batch |\n131\t\n132\t```cpp\n133\t// 自定义算子推荐配置（MM_CFG_NO_PRELOAD 的等价定义）\n134\tconstexpr MatmulConfig MM_CFG_NO_PRELOAD =\n135\t    GetMDLConfig(/*enableMixDualMaster=*/false,\n136\t                 /*enableUnitFlag=*/false,\n137\t                 /*doMTE2Preload=*/0,\n138\t                 /*isVecND2Nz=*/false,\n139\t                 /*isPerTensor=*/false,\n140\t                 /*isSplitK=*/false,\n141\t                 /*enUnitFlag=*/true);   // ← 关键\n142\t```\n143\t\n144\t> **enUnitFlag=true 的坑**：是 `GetMDLConfig` 第 7 个参数，AscendC 默认 `false`，意味着 cube 完成 L0C 累加后 **不会** 触发 fixpipe 把结果送回 GM。自定义算子如果直接 `MatmulImpl<A,B,C,Bias>`（不显式指定 MM_CFG）且 host 没有再调 `mm_.GetTensorC(cGm)`，输出 buffer 将保持初始（零）状态。\n145\t\n146\t### 3.4 IterateAll vs Iterate + GetTensorC\n147\t\n148\t| API | 行为 | 适用 |\n149\t|-----|------|------|\n150\t| `Iterate()` + `GetTensorC(cGm, enAtomic)` | 处理 **一个** baseBlock，需要在每个 baseBlock 之间插自定义逻辑（错位、Atomic、Split-K 累加） | 自定义错位、Split-K |\n151\t| **`IterateAll(cGm, enAtomic)`** | 自动遍历当前 `[singleCoreM × singleCoreN]` 内所有 baseBlock 并写回 GM | **小算子推荐**：单核一次拿整个 tile |\n152\t\n153\t### 写回模式\n154\t\n155\t```cpp\n156\tmm_.SetSingleShape(curSingleM, curSingleN, K);\n157\tmm_.SetTensorA(aGm[offsetA], /*isTrans=*/false);\n158\tmm_.SetTensorB(bGm[offsetB], /*isTrans=*/false);\n159\tif (header.cubeTiling.isBias) mm_.SetBias(biasGm[offsetBias]);\n160\t\n161\t// 推荐：一次写完整个 single-core tile\n162\tmm_.IterateAll(cGm[offsetC], /*enAtomic=*/0);\n163\t\n164\t// 手动模式（Split-K 累加场景）：\n165\t// while (mm_.Iterate()) {\n166\t//     mm_.GetTensorC(cGm[offsetC], /*enAtomic=*/2);  // ATOMIC_ADD\n167\t// }\n168\t```\n169\t\n170\t### 3.5 完整最小骨架\n171\t\n172\t```cpp\n173\ttemplate <typename T, typename BiasT = float>\n174\tclass MatmulKernelImpl {\n175\tpublic:\n176\t    using A_TYPE    = MatmulType<TPosition::GM, CubeFormat::ND, T,     /*isTrans=*/false>;\n177\t    using B_TYPE    = MatmulType<TPosition::GM, CubeFormat::ND, T,     /*isTrans=*/false>;\n178\t    using C_TYPE    = MatmulType<TPosition::GM, CubeFormat::ND, T>;\n179\t    using BIAS_TYPE = MatmulType<TPosition::GM, CubeFormat::ND, BiasT>;\n180\t\n181\t    __aicore__ inline void Init(GM_ADDR aGM, GM_ADDR bGM, GM_ADDR biasGM,\n182\t                                GM_ADDR cGM, GM_ADDR tilingGM, TPipe* pipe) {\n183\t        if ASCEND_IS_AIV { return; }                              // (1) 仅 AIC 执行\n184\t        LoadTilingFromGM<TilingHeader>(tilingGM, header_);        // (2) GM→stack\n185\t        aGm_.SetGlobalBuffer((__gm__ T*)aGM, M*K);\n186\t        bGm_.SetGlobalBuffer((__gm__ T*)bGM, K*N);\n187\t        cGm_.SetGlobalBuffer((__gm__ T*)cGM, M*N);\n188\t        if (header_.cubeTiling.isBias) biasGm_.SetGlobalBuffer((__gm__ BiasT*)biasGM, N);\n189\t        mm_.SetSubBlockIdx(0);\n190\t        mm_.Init(&header_.cubeTiling, pipe);                      // (3) stack 指针\n191\t        // 默认 CubeMathType=4 (KEEP_FLOAT_DTYPE)，FP32 走全精度 cube；\n192\t        // 配合 host 端 tilingApi.SetMadType(MatrixMadType::NORMAL) 使用。\n193\t        mm_.SetHF32(false, 0);\n194\t    }\n195\t\n196\t    __aicore__ inline void Process() {\n197\t        if ASCEND_IS_AIV { return; }\n198\t        const int32_t blockIdx = GetBlockIdx();\n199\t        if (blockIdx >= header_.totalBlock) return;\n200\t        const int32_t mIdx = blockIdx / header_.nTotalCnt;\n201\t        const int32_t nIdx = blockIdx % header_.nTotalCnt;\n202\t        // 尾块、偏移略\n203\t        mm_.SetSingleShape(curSingleM, curSingleN, K);\n204\t        mm_.SetTensorA(aGm_[offsetA], false);\n205\t        mm_.SetTensorB(bGm_[offsetB], false);\n206\t        if (header_.cubeTiling.isBias) mm_.SetBias(biasGm_[offsetBias]);\n207\t        mm_.IterateAll(cGm_[offsetC], 0);\n208\t        PipeBarrier<PIPE_ALL>();\n209\t    }\n210\t\n211\t    __aicore__ inline void End() { mm_.End(); }\n212\tprivate:\n213\t    TilingHeader header_{};\n214\t    MatmulImpl<A_TYPE, B_TYPE, C_TYPE, BIAS_TYPE, MM_CFG_NO_PRELOAD> mm_;\n215\t    GlobalTensor<T> aGm_, bGm_, cGm_;\n216\t    GlobalTensor<BiasT> biasGm_;\n217\t};\n218\t```\n219\t\n220\t### 3.5.1 编译期 trans 标志 + 多 dtype 的 12-entry 模板（推荐）\n221\t\n222\t`MatmulType<TPos, Format, T, IS_TRANS>` 的第 4 个模板参数 `IS_TRANS` 是 **constexpr bool**，且 `SetTensorA(gm, isTrans)` 的运行时参数 **必须与 IS_TRANS 模板参数完全一致**——cube 内部 NZ 分形 / L1 双缓冲深度按错的方向计算后会输出错位 / NaN。要支持运行时 `(transpose_a, transpose_b)` 的 4 种组合 × 3 种 dtype，**必须每种组合各编译一份 kernel**：\n223\t\n224\t```cpp\n225\ttemplate <typename T, bool TRANS_A, bool TRANS_B>\n226\tclass MatmulKernelImpl {\n227\tpublic:\n228\t    using A_TYPE    = MatmulType<TPosition::GM, CubeFormat::ND, T,     TRANS_A>;\n229\t    using B_TYPE    = MatmulType<TPosition::GM, CubeFormat::ND, T,     TRANS_B>;\n230\t    using C_TYPE    = MatmulType<TPosition::GM, CubeFormat::ND, T>;\n231\t    using BIAS_TYPE = MatmulType<TPosition::GM, CubeFormat::ND, float>;\n232\t\n233\t    __aicore__ inline void Process() {\n234\t        if ASCEND_IS_AIV { return; }\n235\t        // ... blockIdx → (mIdx, nIdx) + 尾块尺寸 ...\n236\t\n237\t        // 编译期 trans 决定 GM 偏移公式（见下表）\n238\t        const uint64_t offsetA = TRANS_A\n239\t            ? uint64_t(mIdx) * singleCoreM\n240\t            : uint64_t(mIdx) * singleCoreM * uint64_t(K);\n241\t        const uint64_t offsetB = TRANS_B\n242\t            ? uint64_t(nIdx) * singleCoreN * uint64_t(K)\n243\t            : uint64_t(nIdx) * singleCoreN;\n244\t\n245\t        mm_.SetSingleShape(curSingleM, curSingleN, K);\n246\t        mm_.SetTensorA(aGm_[offsetA], TRANS_A);   // 运行时 arg == 编译期 IS_TRANS\n247\t        mm_.SetTensorB(bGm_[offsetB], TRANS_B);\n248\t        mm_.IterateAll(cGm_[offsetC], 0);\n249\t    }\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"},{"role":"assistant","content":null,"tool_calls":[{"id":"chatcmpl-tool-a380dced36df6c7c","type":"function","function":{"name":"Read","arguments":"{\"file_path\":\"/home/vince/.claude/jobs/09264df0/tmp/gate-088/tier1/p6B-pass2/agent-skills/community/Op/ascendc-operator-code-gen/references/matmul-compute-api.md\",\"limit\":120,\"offset\":250}"}}]},{"role":"tool","tool_call_id":"chatcmpl-tool-a380dced36df6c7c","content":"250\t};\n251\t\n252\t// 用宏一次铺开 4 个 trans 组合 × 一种 dtype = 4 个 entry\n253\t#define MATMUL_KERNEL_ENTRIES(DTYPE_TAG, T)                                                   \\\n254\t    extern \"C\" __global__ __aicore__ void <op>_##DTYPE_TAG##_ff(                              \\\n255\t        GM_ADDR aGM, GM_ADDR bGM, GM_ADDR cGM, GM_ADDR tilingGM) {                            \\\n256\t        TPipe pipe; MatmulKernelImpl<T, false, false> op;                                     \\\n257\t        op.Init(aGM, bGM, cGM, tilingGM, &pipe); op.Process(); op.End();                      \\\n258\t    }                                                                                         \\\n259\t    extern \"C\" __global__ __aicore__ void <op>_##DTYPE_TAG##_ft(GM_ADDR a,GM_ADDR b,GM_ADDR c,GM_ADDR t){ \\\n260\t        TPipe pipe; MatmulKernelImpl<T, false, true>  op; op.Init(a,b,c,t,&pipe); op.Process(); op.End();}\\\n261\t    extern \"C\" __global__ __aicore__ void <op>_##DTYPE_TAG##_tf(GM_ADDR a,GM_ADDR b,GM_ADDR c,GM_ADDR t){ \\\n262\t        TPipe pipe; MatmulKernelImpl<T, true,  false> op; op.Init(a,b,c,t,&pipe); op.Process(); op.End();}\\\n263\t    extern \"C\" __global__ __aicore__ void <op>_##DTYPE_TAG##_tt(GM_ADDR a,GM_ADDR b,GM_ADDR c,GM_ADDR t){ \\\n264\t        TPipe pipe; MatmulKernelImpl<T, true,  true>  op; op.Init(a,b,c,t,&pipe); op.Process(); op.End();}\n265\t\n266\tMATMUL_KERNEL_ENTRIES(fp16, half)\n267\tMATMUL_KERNEL_ENTRIES(bf16, bfloat16_t)\n268\tMATMUL_KERNEL_ENTRIES(fp32, float)\n269\t// → 共 12 个 extern \"C\" __global__ entry，host 按 (dtype, transA, transB) 分发\n270\t```\n271\t\n272\t**Trans 标志驱动的 GM 偏移公式速查**（C 始终非转置）：\n273\t\n274\t| 标志 | 物理 layout | tile 起始偏移 |\n275\t|------|-------------|---------------|\n276\t| `transA=false` | A 是 `[M, K]` | `offsetA = mIdx * singleCoreM * K` |\n277\t| `transA=true ` | A 是 `[K, M]` | `offsetA = mIdx * singleCoreM` |\n278\t| `transB=false` | B 是 `[K, N]` | `offsetB = nIdx * singleCoreN` |\n279\t| `transB=true ` | B 是 `[N, K]` | `offsetB = nIdx * singleCoreN * K` |\n280\t| C（始终）      | `[M, N]`     | `offsetC = mIdx * singleCoreM * N + nIdx * singleCoreN` |\n281\t\n282\t> **常见陷阱**：在测试用例 / 性能用例的数据准备阶段忘记按 trans 调整 a/b 物理 shape — 例如 `transA=true` 时 a 应是 `[K, M]` 而不是 `[M, K]`，否则 host TORCH_CHECK(Ka==Kb) 当场失败。详见 `matmul-tiling.md` §\"用例 / 测试侧的 shape 校验同样要按 trans\"。\n283\t\n284\t### 3.5.2 No-bias 变体（很多自定义 matmul / linear 不带 bias）\n285\t\n286\t实际工程中大量 matmul / linear 算子不带 bias（如纯 attention QK^T、MM）。对应简化：\n287\t\n288\t| 位置 | 改动 |\n289\t|------|------|\n290\t| Kernel `extern \"C\"` 入口签名 | 从 `(aGM, bGM, biasGM, cGM, tilingGM)` → `(aGM, bGM, cGM, tilingGM)` |\n291\t| `BIAS_TYPE` 模板参数 | **仍然要传** `MatmulType<...float>`（cube 内部按 `header.cubeTiling.isBias` 判定是否真的 SetBias） |\n292\t| `header_.cubeTiling.isBias` | 由 host 端 `tilingApi.SetBias(false)` 写入；kernel 端 `if (isBias) mm_.SetBias(...)` 直接进 false 分支 |\n293\t| Host `EXEC_KERNEL_CMD` | 不传 bias_tensor：`EXEC_KERNEL_CMD(<op>_fp16_ff, blockDim, a, b, c, tiling_tensor)` |\n294\t\n295\t**不要**省掉 `BIAS_TYPE` 模板参数 — `MatmulImpl<A,B,C>` 三参数版本会让 cube 内部走错重载路径，部分 SoC 会拒绝编译。\n296\t\n297\t### 3.5.3 op.End() 必须显式调用\n298\t\n299\t`mm_.End()` 用来释放 cube 占用的 L1/L0 资源句柄。简化骨架（§3.5）的最小启动代码是：\n300\t\n301\t```cpp\n302\tTPipe pipe;\n303\tMatmulKernelImpl<T, TRANS_A, TRANS_B> op;\n304\top.Init(aGM, bGM, cGM, tilingGM, &pipe);\n305\top.Process();\n306\top.End();   // ← 必加；漏掉会让多次连续调用累积 L1 句柄泄露，最终 init 失败\n307\t```\n308\t\n309\t### 3.6 完整 Kernel 骨架（L2 / Split-K / Batch）\n310\t\n311\t适用于需要 L2 Cache 优化、Split-K 累加、Batch 维度处理的大算子。tiling 策略（L2 切分、核间分配、错位分核等）详见 `ascendc-operator-design/references/matmul-tiling.md`。\n312\t\n313\t```cpp\n314\ttemplate <class A_TYPE, class B_TYPE, class C_TYPE, class BIAS_TYPE,\n315\t          class BLOCK_TYPE = MatmulBaseBlock,\n316\t          const MatmulConfig &MM_CFG = MM_CFG_NO_PRELOAD>\n317\tclass MatmulKernel {\n318\tpublic:\n319\t    __aicore__ inline void Init(GM_ADDR aGM, GM_ADDR bGM, GM_ADDR cGM,\n320\t                                GM_ADDR biasGM, GM_ADDR tilingGM, TPipe *pipe) {\n321\t        if ASCEND_IS_AIV { return; }                                  // (1) 仅 Cube 执行\n322\t\n323\t        LoadTilingFromGM(tilingGM, header_);                          // (2) GM→stack\n324\t\n325\t        aGm_.SetGlobalBuffer(reinterpret_cast<__gm__ A_T*>(aGM), uint64_t(M) * Ka);\n326\t        bGm_.SetGlobalBuffer(reinterpret_cast<__gm__ B_T*>(bGM), uint64_t(Kb) * N);\n327\t        cGm_.SetGlobalBuffer(reinterpret_cast<__gm__ C_T*>(cGM), uint64_t(M) * N);\n328\t        if (isBias) biasGm_.SetGlobalBuffer(reinterpret_cast<__gm__ BiasT*>(biasGM), N);\n329\t        SetL2CacheEnable(l2cacheUseInfo, aGm_, bGm_, cGm_, biasGm_);\n330\t\n331\t        mm_.SetSubBlockIdx(0);\n332\t        mm_.Init(&header_.cubeTiling, pipe);                          // (3) stack 指针\n333\t\n334\t        if (NZ format) SetOrgShape(...);                              // (4) NZ 格式\n335\t    }\n336\t\n337\t    __aicore__ inline void Process() {\n338\t        if ASCEND_IS_AIV { return; }\n339\t        if (GetBlockIdx() >= totalBlock) return;                       // (5) 越界守卫\n340\t\n341\t        mm_.SetHF32(false, 0);\n342\t        if (isHf32) mm_.SetHF32(true, 1);\n343\t\n344\t        bool reverse = true;\n345\t        for (uint64_t mTile = 0; mTile < mTileCntL2; ++mTile) {        // (6) L2 双层循环\n346\t            reverse = !reverse;\n347\t            for (uint64_t t = 0; t < nTileCntL2; ++t) {\n348\t                uint64_t nTile = reverse ? (nTileCntL2 - t - 1) : t;   //     serpentine\n349\t                block_.UpdateBlockCnt(mTile, nTile);\n350\t                block_.InitBlockIndex(index);\n351\t                for (uint64_t r = 0; r < block_.realRound; ++r) {       // (7) 核内 round 循环\n352\t                    if (rowOrder == 0) block_.UpdateBasicIndex(r);      //     错位分核\n353\t                    if (block_.index < block_.totalTileCnt) {\n354\t                        block_.UpdateBlockParams(mTile, nTile);\n355\t                        block_.CalcGMOffset(mTile, nTile);\n356\t                        mm_.SetSingleShape(block_.singleCoreM,\n357\t                                           block_.singleCoreN, K);\n358\t                        mm_.SetTensorA(aGm_[off.A], block_.isTransposeA);\n359\t                        mm_.SetTensorB(bGm_[off.B], block_.isTransposeB);\n360\t                        if (isBias) mm_.SetBias(biasGm_[off.Bias]);\n361\t                        mm_.Iterate();                                  //     单 base 块\n362\t                        mm_.GetTensorC(cGm_[off.C], enAtomic);\n363\t                    }\n364\t                    block_.UpdateBlockIndex();\n365\t                }\n366\t            }\n367\t        }\n368\t\n369\t        PipeBarrier<PIPE_ALL>();                                        // (8) 收尾\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"},{"role":"assistant","content":null,"tool_calls":[{"id":"chatcmpl-tool-b01e8a26108337f2","type":"function","function":{"name":"Read","arguments":"{\"file_path\":\"/home/vince/.claude/jobs/09264df0/tmp/gate-088/tier1/p6B-pass2/agent-skills/community/Op/ascendc-operator-code-gen/references/matmul-compute-api.md\",\"limit\":150,\"offset\":370}"}}]},{"role":"tool","tool_call_id":"chatcmpl-tool-b01e8a26108337f2","content":"370\t        SetAtomicNone();\n371\t        mm_.SetHF32(false, 0);\n372\t    }\n373\t\n374\t    __aicore__ inline void End() { mm_.End(); }\n375\t};\n376\t```\n377\t\n378\t> **小算子简化**：若不需要 L2/Split-K/Batch，且 `(M,N)` 直接按 (mIdx, nIdx) 一次性切分到核，可以把 (6)(7) 合并为 §3.5 的 `IterateAll` 模式。\n379\t\n380\t---\n381\t\n382\t## 4. Tiling Header GM → stack 装载\n383\t\n384\t> **这是自定义 MatMul 类算子最容易出错的点之一。** tiling 数据结构定义见 `ascendc-operator-design/references/matmul-tiling.md` §\"Tiling 数据结构\"。\n385\t\n386\t### 4.1 正确实现（4-byte 对齐 GM 标量读）\n387\t\n388\t```cpp\n389\ttemplate <typename HeaderT>\n390\t__aicore__ inline void LoadTilingFromGM(GM_ADDR tilingGM, HeaderT &dstStack) {\n391\t    static_assert(alignof(HeaderT) % sizeof(int32_t) == 0,\n392\t                  \"TilingHeader must be 4-byte aligned for int32-wise GM scalar reads\");\n393\t    constexpr uint32_t HEADER_INTS =\n394\t        (sizeof(HeaderT) + sizeof(int32_t) - 1U) / sizeof(int32_t);\n395\t    const auto *gmInts  = reinterpret_cast<const __gm__ int32_t *>(tilingGM);\n396\t    auto       *dstInts = reinterpret_cast<int32_t *>(&dstStack);\n397\t    for (uint32_t i = 0; i < HEADER_INTS; ++i) {\n398\t        dstInts[i] = gmInts[i];\n399\t    }\n400\t}\n401\t```\n402\t\n403\t### 4.2 TilingHeader 推荐写法\n404\t\n405\t```cpp\n406\t#pragma pack(push, 8)\n407\tstruct TilingHeader {\n408\t    AscendC::tiling::TCubeTiling cubeTiling;   // CANN 标准 cube tiling（POD，~196 字节）\n409\t    int32_t mTotalCnt;                         // ceil(M / singleCoreM)\n410\t    int32_t nTotalCnt;                         // ceil(N / singleCoreN)\n411\t    int32_t totalBlock;                        // mTotalCnt * nTotalCnt\n412\t    int32_t reserved;                          // 8 字节对齐\n413\t};\n414\t#pragma pack(pop)\n415\t```\n416\t\n417\t### 4.3 反模式（必须避免）\n418\t\n419\t```cpp\n420\t// ❌ 1-byte 标量循环：N 倍多的 GM 访问，且 cross-cache-line 时编译器可能保留\n421\t//    严格 __gm__ 语义导致结果不可预测。\n422\ttemplate <typename T>\n423\t__aicore__ inline void GmToLocalCopy(T &dst, const __gm__ T &src) {\n424\t    auto *pDst = reinterpret_cast<uint8_t*>(&dst);\n425\t    const auto *pSrc = reinterpret_cast<const __gm__ uint8_t*>(&src);\n426\t    for (uint32_t i = 0; i < sizeof(T); ++i) pDst[i] = pSrc[i];\n427\t}\n428\t\n429\t// ❌ DataCopyPad 到 UB（arch ≥ 220 AIC 无 UB 分配权 → MPU fault）\n430\tTBuf<> tilingBuf;  // 默认 TPosition::UB\n431\tpipe->InitBuffer(tilingBuf, ...);                    // ← AIC 上 fault\n432\t\n433\t// ❌ DataCopy 到 L1 + reinterpret_cast<HeaderT*>(GetPhyAddr())\n434\t//    (DMA 本身可以成功，但把 L1 物理地址当 scalar pointer 喂给 MatmulImpl::Init\n435\t//     会在内部 dereference 时 MPU fault)\n436\tTBuf<TPosition::A1> tilingBuf;\n437\tLocalTensor<int32_t> l1Local = tilingBuf.Get<int32_t>();\n438\tDataCopy(l1Local, gmTensor, alignedInts);\n439\tauto *header = reinterpret_cast<const HeaderT*>(l1Local.GetPhyAddr());  // ← 危险\n440\tmm_.Init(&header->cubeTiling, pipe);                                     // ← MPU fault\n441\t```\n442\t\n443\t---\n444\t\n445\t## 5. AIC / AIV 关系与数据类型支持\n446\t\n447\t### 5.1 AIC / AIV 守卫\n448\t\n449\t| 算子类 | 入口守卫 | 说明 |\n450\t|--------|---------|------|\n451\t| MatMul / BatchMatMul | `if ASCEND_IS_AIV { return; }` | 纯 AIC，AIV 直接退出 |\n452\t\n453\t### 5.2 数据类型支持矩阵\n454\t\n455\t| A | B | C | Bias | 说明 |\n456\t|---|---|---|------|------|\n457\t| float16 | float16 | float16 | float16 / float | 标准 FP16 |\n458\t| bfloat16 | bfloat16 | bfloat16 | bfloat16 / float | 标准 BF16，bias 推荐 fp32 |\n459\t| float | float | float | float | FP32，**默认配 `SetHF32(false, 0)` 走全精度 23-bit mantissa cube（CubeMathType=4 KEEP_FLOAT_DTYPE）** |\n460\t\n461\t\n462\t### 5.3 HF32 模式 / CubeMathType 选择\n463\t\n464\tCANN aclnn 层 `CubeMathType` 在 AscendC 算子的对应实现：\n465\t\n466\t| CubeMathType | 语义 | host SetMadType | kernel SetHF32 | 精度 (FP32) | 吞吐 |\n467\t|---|---|---|---|---|---|\n468\t| 1 ALLOW_FP32_DOWN_PRECISION | 允许 FP32→HF32 | `MatrixMadType::HF32` | `SetHF32(true, 1)` | ~10-bit mantissa (~2e-3 vs FP64) | ≈ 4x |\n469\t| 3 USE_HF32 | 强制 HF32 | `MatrixMadType::HF32` | `SetHF32(true, 1)` | 同上 | ≈ 4x |\n470\t| **4 KEEP_FLOAT_DTYPE** | **强制全 FP32** | **`MatrixMadType::NORMAL`** | **`SetHF32(false, 0)`** | **~23-bit mantissa (~7e-5 vs FP64)** | **1x** |\n471\t\n472\t```cpp\n473\t// 推荐默认：CubeMathType=4 (KEEP_FLOAT_DTYPE)，通过 SKILL precision-eval 严格 FP32 阈值\n474\t// host:\n475\ttilingApi.SetMadType(matmul_tiling::MatrixMadType::NORMAL);\n476\t// kernel:\n477\tmm_.SetHF32(false, 0);\n478\t\n479\t// 性能优先 / 训练前向常用：CubeMathType=3 (USE_HF32)\n480\ttilingApi.SetMadType(matmul_tiling::MatrixMadType::HF32);\n481\tmm_.SetHF32(true, 1);\n482\t```\n483\t\n484\t**关键约束**：host madType 与 kernel SetHF32 必须配对。\n485\t- 若 host 用 NORMAL 但 kernel `SetHF32(true)`：tiling 按全精度分配 buffer，但 cube 仍走 HF32 — 浪费 buffer，且行为依赖具体 CANN 版本，不可移植。\n486\t- 若 host 用 HF32 但 kernel `SetHF32(false)`：tiling 按 HF32 分配较小 buffer，全精度路径可能 buffer 不足 → 编译/运行报错。\n487\t\n488\t**与 `torch.mm` 行为对应**：\n489\t- `torch.npu.matmul.allow_hf32 = False` ↔ CubeMathType=4 (本算子默认) → MaxAbs vs FP64 ~ 1e-4\n490\t- `torch.npu.matmul.allow_hf32 = True`  ↔ CubeMathType=1/3 → MaxAbs vs FP64 ~ 2e-2\n491\t\n492\t---\n493\t\n494\t## 6. 接口调用流程速查\n495\t\n496\t```\n497\tInit                           // (1) ASCEND_IS_AIV 守卫 → LoadTilingFromGM\n498\t   ↓\n499\tSetGlobalBuffer (A,B,C,Bias)\n500\t   ↓\n501\tmm_.SetSubBlockIdx(0)\n502\tmm_.Init(&header.cubeTiling, pipe)\n503\tmm_.SetHF32(...)               // (可选)\n504\t   ↓\n505\tProcess / 每核循环：\n506\t   blockIdx → (mIdx, nIdx)\n507\t   尾块尺寸 + GM 偏移\n508\t   mm_.SetSingleShape(...)\n509\t   mm_.SetTensorA / SetTensorB / SetBias\n510\t   mm_.IterateAll(cGm[off], enAtomic)\n511\t   ↓\n512\tPipeBarrier<PIPE_ALL>()        // 收尾\n513\tSetAtomicNone()\n514\t   ↓\n515\tmm_.End()\n516\t```\n517\t\n518\t---\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"},{"role":"assistant","content":null,"tool_calls":[{"id":"chatcmpl-tool-a62278ef647409be","type":"function","function":{"name":"Read","arguments":"{\"file_path\":\"/home/vince/.claude/jobs/09264df0/tmp/gate-088/tier1/p6B-pass2/agent-skills/community/Op/ascendc-operator-code-gen/references/matmul-compute-api.md\",\"offset\":518}"}}]},{"role":"tool","tool_call_id":"chatcmpl-tool-a62278ef647409be","content":"518\t---\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"},{"role":"assistant","content":null,"tool_calls":[{"id":"chatcmpl-tool-97457b391b3a7622","type":"function","function":{"name":"Read","arguments":"{\"file_path\":\"/home/vince/.claude/jobs/09264df0/tmp/gate-088/tier1/p6B-pass2/agent-skills/community/Op/ascendc-operator-performance-optim/references/api-usage-prof.md\",\"limit\":100}"}}]},{"role":"tool","tool_call_id":"chatcmpl-tool-97457b391b3a7622","content":"1\t# 阶段 3：API 使用优化 — 详细参考\n2\t\n3\t## 3.1 TPipe 在 kernel 类外创建\n4\t\n5\t`TPipe` 作为类成员时，初始化会设置全局 TPipe 指针，编译器认为类内存空间有被\n6\t外部污染的风险，因此**放弃对类内 Scalar 变量的常量折叠和常量传播优化**。\n7\t\n8\t**反例** — TPipe 为类成员：\n9\t\n10\t```cpp\n11\ttemplate <typename ComputeT> class KernelExample {\n12\tpublic:\n13\t    __aicore__ inline KernelExample() {}\n14\t    __aicore__ inline void Init(...) {\n15\t        pipe.InitBuffer(xxxBuf, BUFFER_NUM, xxxSize);\n16\t    }\n17\tprivate:\n18\t    TPipe pipe;       // ← 在类内部，阻止 Scalar 优化\n19\t};\n20\t\n21\textern \"C\" __global__ __aicore__ void example_kernel(...) {\n22\t    KernelExample<float> op;\n23\t    op.Init(...);\n24\t}\n25\t```\n26\t\n27\t**正例** — TPipe 在类外创建，以指针传入：\n28\t\n29\t```cpp\n30\ttemplate <typename ComputeT> class KernelExample {\n31\tpublic:\n32\t    __aicore__ inline KernelExample() {}\n33\t    __aicore__ inline void Init(..., TPipe* pipeIn) {\n34\t        pipe = pipeIn;\n35\t        pipe->InitBuffer(xxxBuf, BUFFER_NUM, xxxSize);\n36\t    }\n37\tprivate:\n38\t    TPipe* pipe;      // ← 仅存指针，类内存空间干净\n39\t};\n40\t\n41\textern \"C\" __global__ __aicore__ void example_kernel(...) {\n42\t    TPipe pipe;                     // ← 在类外创建\n43\t    KernelExample<float> op;\n44\t    op.Init(..., &pipe);\n45\t}\n46\t```\n47\t\n48\t实测：平均 scalar_time 从 281 us 降至 236 us（**−17%**），scalar_time 占比从\n49\t21% 降至 17%。**任何场景**都建议使用此优化，scalar bound 场景收益尤为明显。\n50\t\n51\t## 3.2 纯搬运算子使用 TQueBind\n52\t\n53\t纯搬运算子不涉及 Vector 计算，标准 VECIN→VECOUT 模式会引入一次冗余的\n54\tLocalTensor→LocalTensor DataCopy。\n55\t\n56\t**反例** — 冗余的 Vector 拷贝：\n57\t\n58\t```cpp\n59\tTQue<QuePosition::VECIN, BUFFER_NUM> QueI;\n60\tTQue<QuePosition::VECOUT, BUFFER_NUM> QueO;\n61\t\n62\tauto iLocal = QueI.AllocTensor<ComputeT>();\n63\tDataCopy(iLocal, inGm[i * 32], size);\n64\tQueI.EnQue(iLocal);\n65\tauto iLocal2 = QueI.DeQue<ComputeT>();\n66\tfor (int j = 0; j < jLen; ++j) {\n67\t    auto oLocal = QueO.AllocTensor<ComputeT>();\n68\t    DataCopy(oLocal, iLocal2, size);   // LocalTensor → LocalTensor，浪费 Vector\n69\t    QueO.EnQue(oLocal);\n70\t    auto oLocal2 = QueO.DeQue<ComputeT>();\n71\t    DataCopyPad(outGm[j], oLocal2, ...);\n72\t    QueO.FreeTensor(oLocal2);\n73\t}\n74\tQueI.FreeTensor(iLocal2);\n75\t```\n76\t\n77\t**正例** — TQueBind 消除冗余拷贝：\n78\t\n79\t```cpp\n80\tTQueBind<QuePosition::VECIN, QuePosition::VECOUT, BUFFER_NUM> queBind;\n81\t\n82\tauto bindLocal = queBind.AllocTensor<ComputeT>();\n83\tDataCopy(bindLocal, inGm[i * 32], size);\n84\tqueBind.EnQue(bindLocal);\n85\tauto bindLocal2 = queBind.DeQue<ComputeT>();\n86\tfor (int j = 0; j < len; ++j) {\n87\t    DataCopyPad(outGm[j], bindLocal2, ...);\n88\t}\n89\tqueBind.FreeTensor(bindLocal2);\n90\t```\n91\t\n92\t效果：`aiv_vec_time` 降至约 0。\n93\t\n94\t## 3.3 Counter 模式（SetMaskCount）\n95\t\n96\tNormal 模式需要手动计算主块/尾块的 mask 和迭代次数，涉及大量 Scalar 开销。\n97\tCounter 模式直接传入总元素数，硬件自动推断迭代次数。\n98\t\n99\t**反例** — Normal 模式（half 类型，15000 个元素）：\n100\t\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"},{"role":"assistant","content":null,"tool_calls":[{"id":"chatcmpl-tool-a79a2395d4439228","type":"function","function":{"name":"Grep","arguments":"{\"-A\":40,\"output_mode\":\"content\",\"path\":\"/home/vince/.claude/jobs/09264df0/tmp/gate-088/tier1/p6B-pass2/agent-skills/community/Op/ascendc-operator-performance-optim/references/api-usage-prof.md\",\"pattern\":\"3\\\\.4|AtomicAdd|IterateAll\"}"}}]},{"role":"tool","tool_call_id":"chatcmpl-tool-a79a2395d4439228","content":"138:## 3.4 Matmul AtomicAdd\n139-\n140-Matmul 结果 C(m,n) 需要与 GM 上矩阵 D(m,n) 相加时，可在搬出路径上融合。\n141-\n142-**反例** — 手动搬运后在 UB 做 Add：\n143-\n144-```cpp\n145:mm.IterateAll(local_c);\n146-\n147-DataCopy(local_d, gm_d, d_size);\n148-event_t eventId = static_cast<event_t>(GetTPipePtr()->FetchEventID(HardEvent::MTE2_V));\n149-SetFlag<HardEvent::MTE2_V>(eventId);\n150-WaitFlag<HardEvent::MTE2_V>(eventId);\n151-Add(local_d, local_d, local_c, d_size);\n152-DataCopy(gm_d, local_d, d_size);\n153-```\n154-\n155:**正例** — AtomicAdd 融合到搬出：\n156-\n157-```cpp\n158:mm.IterateAll(gm_d, 1);          // enAtomic = 1\n159-// 或在 Iterate 循环中：\n160-// mm.GetTensorC(gm_d, 1);       // enAtomic = 1\n161-```\n162-\n163-M=64, N=256, K=256 实测：平均 cycle 从 154181 降至 135054（**−12.4%**）。\n164-\n165-## 3.5 归约指令组合\n166-\n167-将连续 buffer 全部累加为一个标量的场景：\n168-\n169-| 方案 | 指令数 | 相对速度 |\n170-|---|---|---|\n171-| 2× WholeReduceSum | 2 | 最慢（WholeReduceSum 单条较慢） |\n172-| 3× BlockReduceSum | 3 | 中等 |\n173-| **1× BlockReduceSum + 1× WholeReduceSum** | **2** | **最快** |\n174-\n175-推荐模式（float, shape=256）：\n176-\n177-```cpp\n178-static constexpr uint32_t BLK_LEN = 32;\n179-TBuf<QuePosition::VECCALC> calcBuf;\n180-pipe.InitBuffer(calcBuf, totalLength * sizeof(float));\n181-AscendC::LocalTensor<float> tempTensor1 = calcBuf.Get<float>();\n182-constexpr uint32_t c0Count = BLK_LEN / sizeof(float);\n183-const uint32_t blockNum0 = (totalLength + c0Count - 1) / c0Count;\n184-\n185-AscendC::SetMaskCount();\n186-AscendC::SetVectorMask<float>(0, totalLength);\n187-AscendC::BlockReduceSum<float, false>(tempTensor1, xLocal,\n188-    AscendC::MASK_PLACEHOLDER, 1,\n189-    DEFAULT_BLK_STRIDE, DEFAULT_BLK_STRIDE, DEFAULT_REP_STRIDE);\n190-AscendC::PipeBarrier<PIPE_V>();\n191-\n192-AscendC::SetVectorMask<float>(0, blockNum0);\n193-AscendC::WholeReduceSum<float, false>(zLocal, tempTensor1,\n194-    AscendC::MASK_PLACEHOLDER, 1,\n195-    DEFAULT_BLK_STRIDE, DEFAULT_BLK_STRIDE, DEFAULT_REP_STRIDE);\n196-AscendC::PipeBarrier<PIPE_V>();\n197-AscendC::SetMaskNorm();\n198-```"},{"role":"assistant","content":null,"tool_calls":[{"id":"chatcmpl-tool-962f46c68ae4cff7","type":"function","function":{"name":"Read","arguments":"{\"file_path\":\"/home/vince/.claude/jobs/09264df0/tmp/gate-088/tier1/p6B-pass2/agent-skills/community/Op/ascendc-operator-performance-optim/references/tiling-prof.md\",\"limit\":120}"}}]},{"role":"tool","tool_call_id":"chatcmpl-tool-962f46c68ae4cff7","content":"1\t# 阶段 1：Tiling 优化 — 详细参考\n2\t\n3\t## 1.1 多核切分\n4\t\n5\t通过 `context->SetBlockDim(BLOCK_DIM)` 设置算子使用的核数。\n6\t\n7\t| 架构 | 设置规则 |\n8\t|---|---|\n9\t| 耦合架构（Vector+Cube 一体） | `blockDim` = `GetCoreNumAiv()` 或 `GetCoreNumAic()` |\n10\t| 分离架构 — 纯 Vector 算子 | `blockDim` = AIV 核数（如 40） |\n11\t| 分离架构 — 纯 Cube 算子 | `blockDim` = AIC 核数（如 20） |\n12\t| 分离架构 — MIX（V+C）算子 | `blockDim` = 物理核组数（如 20 = 40 AIV / 2），**不可超过物理核数** |\n13\t\n14\t`blockDim` 为逻辑核概念，取值范围 [1, 65535]。为充分利用硬件资源，一般设为\n15\t物理核数或其整数倍。AIC/AIV 核数分别通过 `GetCoreNumAic()` 和 `GetCoreNumAiv()`\n16\t获取。\n17\t\n18\t## 1.2 L2Cache 切分\n19\t\n20\t当 `输入数据量 + 输出数据量 > L2Cache 容量`（如 192 MB）时，将数据按 L2Cache\n21\t大小等分为多块，所有核协同处理同一块后再切换下一块。这样重复读取时可命中\n22\tL2Cache（~7 TB/s），避免频繁访问 HBM（~1.6 TB/s）。\n23\t\n24\t**反例** — 未使能 L2Cache 切分，每个核的两个 tile 互相挤占 L2Cache：\n25\t\n26\t```cpp\n27\tconstexpr int32_t TOTAL_LENGTH = 384 * 1024 * 1024 / sizeof(half);\n28\tconstexpr int32_t USE_CORE_NUM = 20;\n29\tconstexpr int32_t TILE_NUM = 2;\n30\tconstexpr int32_t BLOCK_LENGTH = TOTAL_LENGTH / USE_CORE_NUM;\n31\tconstexpr int32_t TILE_LENGTH = BLOCK_LENGTH / TILE_NUM;\n32\t\n33\tclass KernelSample {\n34\tpublic:\n35\t    __aicore__ inline void Init(GM_ADDR x) {\n36\t        xGm.SetGlobalBuffer((__gm__ half*)x + BLOCK_LENGTH * GetBlockIdx(), BLOCK_LENGTH);\n37\t        pipe.InitBuffer(inQueueX, 1, BLOCK_LENGTH * sizeof(half));\n38\t    }\n39\t    __aicore__ inline void Process() {\n40\t        constexpr int32_t loopCount = 2;\n41\t        for (int32_t i = 0; i < loopCount; i++) {\n42\t            for (int32_t j = 0; j < TILE_NUM; j++) {\n43\t                CopyIn(j);    // 每个核读两个 tile，L2Cache 被反复淘汰\n44\t                Compute();\n45\t                CopyOut(j);\n46\t            }\n47\t        }\n48\t    }\n49\t};\n50\t```\n51\t\n52\t**正例** — 使能 L2Cache 切分，外层循环按 L2Cache 分块，所有核协同处理：\n53\t\n54\t```cpp\n55\tconstexpr int32_t TOTAL_LENGTH = 384 * 1024 * 1024 / sizeof(half);\n56\tconstexpr int32_t TILE_NUM = 2;\n57\tconstexpr int32_t USE_CORE_NUM = 20;\n58\tconstexpr int32_t TILE_LENGTH = TOTAL_LENGTH / TILE_NUM;\n59\tconstexpr int32_t BLOCK_LENGTH = TILE_LENGTH / USE_CORE_NUM;\n60\t\n61\tclass KernelSample {\n62\tpublic:\n63\t    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, int32_t index) {\n64\t        xGm.SetGlobalBuffer(\n65\t            (__gm__ half*)x + BLOCK_LENGTH * GetBlockIdx() + index * TILE_LENGTH,\n66\t            BLOCK_LENGTH);\n67\t    }\n68\t    __aicore__ inline void Process() {\n69\t        constexpr int32_t loopCount = 2;\n70\t        for (int32_t i = 0; i < loopCount; i++) {\n71\t            CopyIn();       // 每个核只读自己的切片，第二次读命中 L2Cache\n72\t            Compute();\n73\t            CopyOut();\n74\t        }\n75\t    }\n76\t};\n77\t\n78\textern \"C\" __global__ __aicore__ void simple_kernel(\n79\t    __gm__ uint8_t* srcGm, __gm__ uint8_t* dstGm)\n80\t{\n81\t    AscendC::KernelAdd op;\n82\t    for (int32_t i = 0; i < TILE_NUM; i++) {\n83\t        op.Init(srcGm, dstGm, i);\n84\t        op.Process();\n85\t    }\n86\t}\n87\t```\n88\t\n89\t## 1.3 核间负载均衡\n90\t\n91\tL2Cache 切分后，若每次计算所需块数不能被核数整除，则部分核会多分配尾块。\n92\t\n93\t**问题**：核 1–5 每次 pass 多算一个块，始终最后完成，核 6–20 空等。\n94\t\n95\t**解决方法**：在不同 pass 间交替分配尾块。例如 2 个 pass × 25 块 / 20 核，\n96\tpass 1 的尾块分配给核 1–5，pass 2 的尾块分配给核 6–10，全局来看核 1–10\n97\t各算 3 块，核 11–20 各算 2 块，达到全局负载均衡。\n98\t\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"},{"role":"assistant","content":null,"tool_calls":[{"id":"chatcmpl-tool-bd339a7af21c2173","type":"function","function":{"name":"Read","arguments":"{\"file_path\":\"/home/vince/.claude/jobs/09264df0/tmp/gate-088/tier1/p6B-pass2/agent-skills/community/Op/ascendc-operator-performance-optim/references/memory-prof.md\",\"limit\":80}"}}]},{"role":"tool","tool_call_id":"chatcmpl-tool-bd339a7af21c2173","content":"1\t# 阶段 4：内存优化 — 详细参考\n2\t\n3\t## 存储层级一览\n4\t\n5\t| Buffer | 用途 | 说明 |\n6\t|---|---|---|\n7\t| GM（HBM） | 全局内存 | 带宽约 1.6 TB/s |\n8\t| L2Cache | 共享缓存 | 约 192 MB，带宽约 7 TB/s |\n9\t| L1 Buffer | AI Core 本地存储 | Cube 数据中转 |\n10\t| L0A / L0B | Cube 输入 | 由 L1 加载 |\n11\t| L0C（CO1） | Cube 输出 | 支持原地累加 |\n12\t| UB（Unified Buffer） | Vector 输入/输出 | VECIN, VECOUT, VECCALC |\n13\t| BT Buffer（C2） | Bias 表 | 仅分离架构 |\n14\t| FP Buffer（C2PIPE2GM） | Fixpipe 参数 | 仅分离架构 |\n15\t\n16\t## 4.1 UB Buffer 融合\n17\t\n18\t连续多次 Vector 运算时，将中间结果保留在 UB 上，不经 GM 往返。\n19\tn 次连续运算的 GM 搬运次数从 `2n` 降为 `2`。\n20\t\n21\t**反例** — 每次运算都经 GM 往返（Exp + Abs 需 4 次 GM 搬运）：\n22\t\n23\t```cpp\n24\tclass KernelSample {\n25\t    __aicore__ inline void Process() {\n26\t        CopyIn();       // GM → UB\n27\t        Compute();      // Exp\n28\t        CopyOut();      // UB → GM\n29\t        CopyIn1();      // GM → UB（重新读回 Exp 结果）\n30\t        Compute1();     // Abs\n31\t        CopyOut1();     // UB → GM\n32\t    }\n33\t};\n34\t```\n35\t\n36\t**正例** — 在 UB 内链式计算（仅 2 次 GM 搬运）：\n37\t\n38\t```cpp\n39\tclass KernelSample {\n40\t    __aicore__ inline void Compute() {\n41\t        LocalTensor<float> src0Local = inQueueSrc0.DeQue<float>();\n42\t        LocalTensor<float> dstLocal  = outQueueDst.AllocTensor<float>();\n43\t        Exp(dstLocal, src0Local, 1024);\n44\t        Abs(dstLocal, dstLocal, 1024);   // 原地操作，留在 UB\n45\t        outQueueDst.EnQue<float>(dstLocal);\n46\t        inQueueSrc0.FreeTensor(src0Local);\n47\t    }\n48\t    __aicore__ inline void Process() {\n49\t        CopyIn();       // GM → UB（一次）\n50\t        Compute();      // Exp + Abs 融合\n51\t        CopyOut();      // UB → GM（一次）\n52\t    }\n53\t};\n54\t```\n55\t\n56\t## 4.2 L0C 累加矩阵乘\n57\t\n58\t`A1*B1 + A2*B2 + ...` 场景下，利用 Mmad 的内建累加功能将部分结果保留在\n59\tCO1（L0C）中。避免每次矩阵乘结果都 CO1→GM→UB 再做 Add。\n60\t\n61\t**反例** — 逐次搬出后在 UB 求和：\n62\t\n63\t```cpp\n64\tvoid Process() {\n65\t    Compute();       // Mmad → CO1\n66\t    CopyOut();       // CO1 → workspace（GM）\n67\t    CopyIn1();       // workspace → UB\n68\t\n69\t    Compute1();      // Mmad → CO1\n70\t    CopyOut1();      // CO1 → workspace（GM）\n71\t    CopyIn2();       // workspace → UB\n72\t\n73\t    Compute2();      // Add(result1, result2) in UB\n74\t    CopyOut2();      // UB → GM\n75\t}\n76\t```\n77\t\n78\t**正例** — 在 L0C 中原地累加：\n79\t\n80\t```cpp\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"},{"role":"assistant","content":null,"tool_calls":[{"id":"chatcmpl-tool-b1f6b6e8c43a465d","type":"function","function":{"name":"Read","arguments":"{\"file_path\":\"/home/vince/.claude/jobs/09264df0/tmp/gate-088/tier1/p6B-pass2/agent-skills/community/Op/ascendc-operator-performance-optim/references/memory-prof.md\",\"limit\":60,\"offset\":80}"}}]},{"role":"tool","tool_call_id":"chatcmpl-tool-b1f6b6e8c43a465d","content":"80\t```cpp\n81\tvoid Compute() {\n82\t    MmadParams mmadParams;\n83\t    mmadParams.m = m;  mmadParams.n = n;  mmadParams.k = k;\n84\t    Mmad(c1Local, a2Local_1, b2Local_1, mmadParams);\n85\t    mmadParams.cmatrixInitVal = false;\n86\t    Mmad(c1Local, a2Local_2, b2Local_2, mmadParams);  // 在 CO1 原地累加\n87\t}\n88\t// 最后一次 CopyOut: CO1 → GM\n89\t```\n90\t\n91\t## 4.3 小矩阵长驻 L1\n92\t\n93\t当 L1 无法同时容纳左右矩阵（如左矩阵 992K、右矩阵 16K、L1 容量 512K）时，\n94\t将较小矩阵一次加载后常驻 L1，仅循环搬运较大矩阵。\n95\t\n96\t**反例** — 每次迭代都重新加载两个矩阵：\n97\t\n98\t```cpp\n99\tvoid Process() {\n100\t    for (uint32_t i = 0; i < 2; i++) {\n101\t        CopyInA1(i);      // 加载左矩阵切片\n102\t        SplitA();\n103\t        for (uint32_t j = 0; j < 2; j++) {\n104\t            CopyInB1(j);  // 每次都重新加载右矩阵\n105\t            SplitB();\n106\t            Compute(i, j);\n107\t        }\n108\t    }\n109\t    CopyOut();\n110\t}\n111\t```\n112\t\n113\t**正例** — 右矩阵一次加载，仅循环搬运左矩阵：\n114\t\n115\t```cpp\n116\tvoid Process() {\n117\t    CopyInB1();          // 右矩阵一次全载入 L1\n118\t    SplitB();            // L1 → L0B\n119\t    for (uint32_t i = 0; i < 2; i++) {\n120\t        CopyInA1(i);     // 循环加载左矩阵切片\n121\t        SplitA();\n122\t        for (uint32_t j = 0; j < 2; j++) {\n123\t            Compute(i, j);  // 右矩阵已在 L0B\n124\t        }\n125\t    }\n126\t    CopyOut();\n127\t}\n128\t```\n129\t\n130\t2 个左矩阵切片时：搬运次数从 4+4=8 降为 1+2=3。\n131\t\n132\t## 4.4 BT Buffer 存放 bias（分离架构）\n133\t\n134\t将 bias 存入 BT Buffer（C2），在 Mmad 中一步融合 bias 加法，避免\n135\tCO1→GM→UB→Add→GM 的冗长路径。\n136\t\n137\t**反例** — 在 UB 中单独做 bias Add：\n138\t\n139\t```cpp\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"},{"role":"assistant","content":null,"tool_calls":[{"id":"chatcmpl-tool-bbddf2d1a58ff6cb","type":"function","function":{"name":"Read","arguments":"{\"file_path\":\"/home/vince/.claude/jobs/09264df0/tmp/gate-088/tier1/p6B-pass2/agent-skills/community/Op/ascendc-operator-performance-optim/references/data-copy-prof.md\",\"limit\":100}"}}]},{"role":"tool","tool_call_id":"chatcmpl-tool-bbddf2d1a58ff6cb","content":"1\t# 阶段 2：搬运优化 — 详细参考\n2\t\n3\t## 2.1 单次搬运量 >= 16 KB\n4\t\n5\t带宽利用率随单次搬运量增大而提升。实测经验：单次搬运 **>= 16 KB** 时，\n6\tUB↔HBM 两个方向均可达到接近峰值的带宽。低于此值时带宽利用率显著下降。\n7\t\n8\t设计 Tiling 策略时应确保每次 `DataCopy` 搬运至少 16 KB。\n9\t\n10\t## 2.2 GM 地址 512B 对齐\n11\t\n12\t在 Atlas A2 训练系列 / Atlas 800I A2 推理产品上，GM 地址 512B 对齐可比 32B\n13\t对齐获得最高 **30%** 的带宽提升（最差场景下的差距）。\n14\t\n15\t分配 GM Tensor 或计算偏移量时，应确保起始字节地址为 512 的整数倍。\n16\t\n17\t## 2.3 使用 stride 参数代替 for 循环\n18\t\n19\t使用 `DataCopyParams`（blockCount / blockLen / srcStride / dstStride）将间隔\n20\t搬运描述为一条 DMA 指令下发，而非用 for 循环逐行调用 `DataCopy`。\n21\t\n22\t**反例** — for 循环，每次仅搬运 2 KB：\n23\t\n24\t```cpp\n25\tconstexpr int32_t copyWidth = 2 * 1024 / sizeof(float);\n26\tconstexpr int32_t imgWidth  = 16 * 1024 / sizeof(float);\n27\tconstexpr int32_t imgHeight = 16;\n28\t// 16 次独立的 2KB 搬运，带宽利用率极低\n29\tfor (int i = 0; i < imgHeight; i++) {\n30\t    DataCopy(tensorIn[i * copyWidth], tensorGM[i * imgWidth], copyWidth);\n31\t}\n32\t```\n33\t\n34\t**正例** — 单条 DMA 描述符，一次搬运 32 KB：\n35\t\n36\t```cpp\n37\tconstexpr int32_t copyWidth = 2 * 1024 / sizeof(float);\n38\tconstexpr int32_t imgWidth  = 16 * 1024 / sizeof(float);\n39\tconstexpr int32_t imgHeight = 16;\n40\tDataCopyParams copyParams;\n41\tcopyParams.blockCount = imgHeight;                     // 16 行\n42\tcopyParams.blockLen   = copyWidth / 8;                 // 单位: 32B DataBlock\n43\tcopyParams.srcStride  = (imgWidth - copyWidth) / 8;    // src 行间间隔\n44\tcopyParams.dstStride  = 0;                             // dst 连续写入\n45\tDataCopy(tensorGM, tensorIn, copyParams);\n46\t```\n47\t\n48\tstride 方式下发一条 DMA 指令，硬件自主完成全部搬运，可充分利用带宽。\n49\tfor 循环方式下发 16 条小 DMA 指令，每条之间还有 Scalar 开销。\n50\t\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"},{"role":"assistant","content":"All five pipeline-stage references are loaded and the evidence is confirmed: in `op_statistic.csv` the MatMul op dominates at 4800 µs of 6000 µs total (avg 400 µs/call, max 520). One important finding: **your kernel source is not in this workspace** (`ws/` is empty) — only the PROF_0001 dump exists. So I'll deliver the optimized kernel as a concrete, ready-to-drop-in file with the intra-core pipeline changes applied, derived from the verified skill references.","tool_calls":[{"id":"chatcmpl-tool-984a81f6dfb42011","type":"function","function":{"name":"Write","arguments":"{\"file_path\":\"/home/vince/.claude/jobs/09264df0/tmp/gate-088/tier1/p6B-pass2/ws/matmul_intra_pipeline_opt.cpp\",\"content\":\"// Intra-core pipeline optimized MatMul kernel (Ascend C).\\n//\\n// Baseline evidence (msprof op_statistic.csv, PROF_0001):\\n//   MatMul_e2e: 12 calls, avg 400 us, max 520 us, min 360 us -> 80% of total profile time.\\n//   Variance between calls (360..520 us) indicates exposed pipeline bubbles:\\n//   MTE2 (GM->L1 load) and Cube (Mmad) are NOT overlapped in the current kernel.\\n//\\n// Changes vs. the standard MM_CFG_NO_PRELOAD template (all intra-core, i.e. inside\\n// a single AI Core), ordered by expected gain:\\n//\\n//   [P1] MTE2 preload / cube double buffering: switch MatmulConfig from\\n//        doMTE2Preload=0 to doMTE2Preload=2 (MM_CFG_PRELOAD_MK). The cube engine\\n//        then prefetches the next K-slice of A from GM to L1 while the current\\n//        slice is in Mmad, closing the CopyIn->Compute serialization bubble that\\n//        dominates an intra-core-bound matmul.\\n//\\n//   [P2] Fused atomic write-back: when the epilogue is C = A*B + D, pass\\n//        enAtomic=1 to IterateAll/GetTensorC so the accumulation happens on the\\n//        fixpipe path instead of CO1->GM->UB->Add->GM. Measured ~-12% cycles\\n//        (api-usage-prof.md 3.4). Guarded by isEpilogueAdd at compile time.\\n//\\n//   [P3] TPipe remains external to the kernel class and is passed by pointer so\\n//        Scalar constants fold; class-member TPipe costs ~+17% scalar_time\\n//        (api-usage-prof.md 3.1) and scalar overhead is what fills the pipeline\\n//        gaps we are trying to close.\\n//\\n//   [P4] Optional HF32 fast path (compile-time switch USE_HF32): cube throughput\\n//        ~4x for FP32 when ~10-bit mantissa is acceptable (training forward /\\n//        QK^T). Default OFF to preserve KEEP_FLOAT_DTYPE precision parity with\\n//        torch.mm(allow_hf32=False). Host SetMadType must match: HF32<->NORMAL.\\n//\\n// Non-goals (inter-core, not touched here): blockDim sizing, L2 serpentine\\n// splitting, tail-block alternation. See tiling-prof.md if those are also needed.\\n\\n#include \\\"kernel_operator.h\\\"\\n#include \\\"lib/matmul_intf.h\\\"\\n\\nusing namespace AscendC;\\nusing namespace matmul;\\n\\nnamespace {\\n\\n// [P1] Preload config: doMTE2Preload=2 prefetches A in the M-K direction so the\\n// next base-block's L1 load overlaps the current Mmad. enUnitFlag=true is kept —\\n// without it the cube never fixpipes L0C back to GM and outputs are all zero.\\nconstexpr MatmulConfig MM_CFG_PRELOAD_MK =\\n    GetMDLConfig(/*enableMixDualMaster=*/false,\\n                 /*enableUnitFlag=*/false,\\n                 /*doMTE2Preload=*/2,      // <-- [P1] was 0 (MM_CFG_NO_PRELOAD)\\n                 /*isVecND2Nz=*/false,\\n                 /*isPerTensor=*/false,\\n                 /*isSplitK=*/false,\\n                 /*enUnitFlag=*/true);\\n\\ntemplate <typename HeaderT>\\n__aicore__ inline void LoadTilingFromGM(GM_ADDR tilingGM, HeaderT &dstStack)\\n{\\n    static_assert(alignof(HeaderT) % sizeof(int32_t) == 0,\\n                  \\\"TilingHeader must be 4-byte aligned for int32-wise GM scalar reads\\\");\\n    constexpr uint32_t HEADER_INTS =\\n        (sizeof(HeaderT) + sizeof(int32_t) - 1U) / sizeof(int32_t);\\n    const auto *gmInts  = reinterpret_cast<const __gm__ int32_t *>(tilingGM);\\n    auto       *dstInts = reinterpret_cast<int32_t *>(&dstStack);\\n    for (uint32_t i = 0; i < HEADER_INTS; ++i) {\\n        dstInts[i] = gmInts[i];\\n    }\\n}\\n\\n}  // namespace\\n\\n// EPILOGUE_ADD: compile-time switch for [P2].\\n//   false -> C = A*B          (enAtomic=0, plain overwrite write-back)\\n//   true  -> C = A*B + C_in   (enAtomic=1, fixpipe atomic-add, no UB roundtrip)\\n// USE_HF32: [P4], default off.\\ntemplate <typename T, bool TRANS_A = false, bool TRANS_B = false,\\n          bool EPILOGUE_ADD = false, bool USE_HF32 = false>\\nclass MatmulIntraPipeOptKernel {\\npublic:\\n    using Header   = ascend_kernel::matmul_op::TilingHeader;\\n\\n    using A_TYPE    = MatmulType<TPosition::GM, CubeFormat::ND, T,     TRANS_A>;\\n    using B_TYPE    = MatmulType<TPosition::GM, CubeFormat::ND, T,     TRANS_B>;\\n    using C_TYPE    = MatmulType<TPosition::GM, CubeFormat::ND, T,     /*isTrans=*/false>;\\n    using BIAS_TYPE = MatmulType<TPosition::GM, CubeFormat::ND, float, /*isTrans=*/false>;\\n\\n    __aicore__ inline MatmulIntraPipeOptKernel() {}\\n\\n    // [P3] TPipe created outside the class, passed in by pointer.\\n    __aicore__ inline void Init(GM_ADDR aGM, GM_ADDR bGM,\\n                                GM_ADDR cGM, GM_ADDR tilingGM, TPipe *pipe)\\n    {\\n        if ASCEND_IS_AIV { return; }\\n        pipe_ = pipe;\\n\\n        LoadTilingFromGM<Header>(tilingGM, header_);\\n\\n        const int32_t M = header_.cubeTiling.M;\\n        const int32_t N = header_.cubeTiling.N;\\n        const int32_t K = header_.cubeTiling.Ka;\\n\\n        aGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(aGM),\\n                             static_cast<uint64_t>(M) * static_cast<uint64_t>(K));\\n        bGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(bGM),\\n                             static_cast<uint64_t>(K) * static_cast<uint64_t>(N));\\n        cGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(cGM),\\n                             static_cast<uint64_t>(M) * static_cast<uint64_t>(N));\\n\\n        mm_.SetSubBlockIdx(0);\\n        mm_.Init(&header_.cubeTiling, pipe_);\\n\\n        // [P4] Host tiling must pair: USE_HF32 -> SetMadType(MatrixMadType::HF32),\\n        // else SetMadType(MatrixMadType::NORMAL). Mismatched pairing mis-sizes\\n        // cube buffers and can fail at compile/run time.\\n        if constexpr (USE_HF32) {\\n            mm_.SetHF32(true, 1);\\n        } else {\\n            mm_.SetHF32(false, 0);\\n        }\\n    }\\n\\n    __aicore__ inline void Process()\\n    {\\n        if ASCEND_IS_AIV { return; }\\n\\n        const int32_t blockIdx   = static_cast<int32_t>(GetBlockIdx());\\n        const int32_t totalBlock = header_.totalBlock;\\n        if (blockIdx >= totalBlock) return;\\n\\n        const int32_t mTotalCnt = header_.mTotalCnt;\\n        const int32_t nTotalCnt = header_.nTotalCnt;\\n        const int32_t mIdx      = blockIdx / nTotalCnt;\\n        const int32_t nIdx      = blockIdx % nTotalCnt;\\n\\n        const int32_t M           = header_.cubeTiling.M;\\n        const int32_t N           = header_.cubeTiling.N;\\n        const int32_t K           = header_.cubeTiling.Ka;\\n        const int32_t singleCoreM = header_.cubeTiling.singleCoreM;\\n        const int32_t singleCoreN = header_.cubeTiling.singleCoreN;\\n        const int32_t curSingleM  = (mIdx == mTotalCnt - 1) ? (M - mIdx * singleCoreM) : singleCoreM;\\n        const int32_t curSingleN  = (nIdx == nTotalCnt - 1) ? (N - nIdx * singleCoreN) : singleCoreN;\\n\\n        const uint64_t offsetA = TRANS_A\\n            ? static_cast<uint64_t>(mIdx) * static_cast<uint64_t>(singleCoreM)\\n            : static_cast<uint64_t>(mIdx) * static_cast<uint64_t>(singleCoreM)\\n                                          * static_cast<uint64_t>(K);\\n        const uint64_t offsetB = TRANS_B\\n            ? static_cast<uint64_t>(nIdx) * static_cast<uint64_t>(singleCoreN)\\n                                          * static_cast<uint64_t>(K)\\n            : static_cast<uint64_t>(nIdx) * static_cast<uint64_t>(singleCoreN);\\n        const uint64_t offsetC = static_cast<uint64_t>(mIdx) * static_cast<uint64_t>(singleCoreM)\\n                                                             * static_cast<uint64_t>(N)\\n                               + static_cast<uint64_t>(nIdx) * static_cast<uint64_t>(singleCoreN);\\n\\n        mm_.SetSingleShape(curSingleM, curSingleN, K);\\n        mm_.SetTensorA(aGm_[offsetA], TRANS_A);   // runtime arg == compile-time IS_TRANS\\n        mm_.SetTensorB(bGm_[offsetB], TRANS_B);\\n\\n        // [P1]+[P2] With preload enabled the cube overlaps the next base-block's\\n        // L1 fill with the current Mmad across ALL base blocks of this tile\\n        // (IterateAll walks them internally). enAtomic=1 fuses C+= on fixpipe.\\n        mm_.IterateAll(cGm_[offsetC], EPILOGUE_ADD ? 1 : 0);\\n\\n        PipeBarrier<PIPE_ALL>();\\n        SetAtomicNone();\\n    }\\n\\n    __aicore__ inline void End() { mm_.End(); }\\n\\nprivate:\\n    TPipe          *pipe_ = nullptr;\\n    Header          header_{};\\n    GlobalTensor<T> aGm_;\\n    GlobalTensor<T> bGm_;\\n    GlobalTensor<T> cGm_;\\n    MatmulImpl<A_TYPE, B_TYPE, C_TYPE, BIAS_TYPE, MM_CFG_PRELOAD_MK> mm_;\\n};\\n\\n#define MATMUL_OPT_ENTRIES(DTYPE_TAG, T)                                                              \\\\\\n    extern \\\"C\\\" __global__ __aicore__ void matmul_opt_##DTYPE_TAG##_ff(                                \\\\\\n        GM_ADDR aGM, GM_ADDR bGM, GM_ADDR cGM, GM_ADDR tilingGM)                                      \\\\\\n    {                                                                                                 \\\\\\n        TPipe pipe;                                                                                   \\\\\\n        MatmulIntraPipeOptKernel<T, false, false, false, false> op;                                   \\\\\\n        op.Init(aGM, bGM, cGM, tilingGM, &pipe);                                                      \\\\\\n        op.Process();                                                                                 \\\\\\n        op.End();                                                                                     \\\\\\n    }                                                                                                 \\\\\\n    extern \\\"C\\\" __global__ __aicore__ void matmul_opt_##DTYPE_TAG##_ft(                                \\\\\\n        GM_ADDR aGM, GM_ADDR bGM, GM_ADDR cGM, GM_ADDR tilingGM)                                      \\\\\\n    {                                                                                                 \\\\\\n        TPipe pipe;                                                                                   \\\\\\n        MatmulIntraPipeOptKernel<T, false, true, false, false> op;                                    \\\\\\n        op.Init(aGM, bGM, cGM, tilingGM, &pipe);                                                      \\\\\\n        op.Process();                                                                                 \\\\\\n        op.End();                                                                                     \\\\\\n    }                                                                                                 \\\\\\n    extern \\\"C\\\" __global__ __aicore__ void matmul_opt_##DTYPE_TAG##_tf(                                \\\\\\n        GM_ADDR aGM, GM_ADDR bGM, GM_ADDR cGM, GM_ADDR tilingGM)                                      \\\\\\n    {                                                                                                 \\\\\\n        TPipe pipe;                                                                                   \\\\\\n        MatmulIntraPipeOptKernel<T, true, false, false, false> op;                                    \\\\\\n        op.Init(aGM, bGM, cGM, tilingGM, &pipe);                                                      \\\\\\n        op.Process();                                                                                 \\\\\\n        op.End();                                                                                     \\\\\\n    }                                                                                                 \\\\\\n    extern \\\"C\\\" __global__ __aicore__ void matmul_opt_##DTYPE_TAG##_tt(                                \\\\\\n        GM_ADDR aGM, GM_ADDR bGM, GM_ADDR cGM, GM_ADDR tilingGM)                                      \\\\\\n    {                                                                                                 \\\\\\n        TPipe pipe;                                                                                   \\\\\\n        MatmulIntraPipeOptKernel<T, true, true, false, false> op;                                     \\\\\\n        op.Init(aGM, bGM, cGM, tilingGM, &pipe);                                                      \\\\\\n        op.Process();                                                                                 \\\\\\n        op.End();                                                                                     \\\\\\n    }                                                                                                 \\\\\\n    extern \\\"C\\\" __global__ __aicore__ void matmul_opt_##DTYPE_TAG##_epiadd_ff(                         \\\\\\n        GM_ADDR aGM, GM_ADDR bGM, GM_ADDR cGM, GM_ADDR tilingGM)                                      \\\\\\n    {                                                                                                 \\\\\\n        TPipe pipe;                                                                                   \\\\\\n        MatmulIntraPipeOptKernel<T, false, false, true, false> op;                                    \\\\\\n        op.Init(aGM, bGM, cGM, tilingGM, &pipe);                                                      \\\\\\n        op.Process();                                                                                 \\\\\\n        op.End();                                                                                     \\\\\\n    }\\n\\nMATMUL_OPT_ENTRIES(fp16, half)\\nMATMUL_OPT_ENTRIES(bf16, bfloat16_t)\\nMATMUL_OPT_ENTRIES(fp32, float)\\n\\n#undef MATMUL_OPT_ENTRIES\\n\"}"}}]},{"role":"tool","tool_call_id":"chatcmpl-tool-984a81f6dfb42011","content":"File created successfully at: /home/vince/.claude/jobs/09264df0/tmp/gate-088/tier1/p6B-pass2/ws/matmul_intra_pipeline_opt.cpp"},{"role":"assistant","content":null,"tool_calls":[{"id":"chatcmpl-tool-a5e1ddc9eaa66455","type":"function","function":{"name":"TaskUpdate","arguments":"{\"status\":\"completed\",\"taskId\":\"2\"}"}},{"id":"chatcmpl-tool-ac6521ea466937ae","type":"function","function":{"name":"TaskUpdate","arguments":"{\"status\":\"in_progress\",\"taskId\":\"3\"}"}}]},{"role":"tool","tool_call_id":"chatcmpl-tool-a5e1ddc9eaa66455","content":"Updated task #2 status"},{"role":"tool","tool_call_id":"chatcmpl-tool-ac6521ea466937ae","content":"Updated task #3 status"},{"role":"assistant","content":null,"tool_calls":[{"id":"chatcmpl-tool-a878d4a3f6b73af9"